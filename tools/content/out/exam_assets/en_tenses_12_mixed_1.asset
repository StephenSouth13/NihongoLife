    - id: en_tenses_12_mixed_1_c01
      type: 0
      passageId: 
      promptVi: "Chọn dạng đúng của động từ. Lan _____ the news on her phone every day."
      promptEn: "Lan _____ the news on her phone every day."
      promptJa: ""
      promptReading: ""
      choices:
      - textVi: "reads"
        textEn: "reads"
        textJa: ""
      - textVi: "read"
        textEn: "read"
        textJa: ""
      - textVi: "has read"
        textEn: "has read"
        textJa: ""
      - textVi: "is reading"
        textEn: "is reading"
        textJa: ""
      correctChoiceIndex: 0
      acceptedAnswers: []
      taskInstructionsVi: ""
      taskInstructionsEn: ""
      minWords: 0
      timeLimitSeconds: 0
      explanationVi: "Thì: Hiện tại đơn. Cấu trúc: S + V(s/es)  — I/you/we/they work · he/she/it works. Đáp án: Lan reads the news on her phone every day. — nghĩa động từ: đọc. Dấu hiệu: every day…"
      explanationEn: "Tense: Present Simple. Form: S + V(s/es)  — I/you/we/they work · he/she/it works. Answer: Lan reads the news on her phone every day."
      tags:
      - "tenses"
      - "present_simple"
      points: 1
      mondai: ""
