# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Keep downloaded/source archives local; GitHub rejects regular files over 100MB.
*.zip
*.zip.meta
*.7z
*.7z.meta
*.rar
*.rar.meta

# Local Mixamo source models over GitHub's 100MB limit. Keep them on disk or move them to Git LFS.
NihongoLife/Assets/ThirdParty/Mixamo/Characters/lilly/source/*.fbx
NihongoLife/Assets/ThirdParty/Mixamo/Characters/lilly/source/*.fbx.meta
NihongoLife/Assets/ThirdParty/Mixamo/Characters/eminem/source/*.Fbx
NihongoLife/Assets/ThirdParty/Mixamo/Characters/eminem/source/*.Fbx.meta
NihongoLife/Assets/ThirdParty/Mixamo/Characters/eminem/source/*.fbx
NihongoLife/Assets/ThirdParty/Mixamo/Characters/eminem/source/*.fbx.meta

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Licensed exam material (Cambridge IELTS books/audio, JLPT past papers): local reference only, never public.
NihongoLife/Docs/Exam/IELTS/
NihongoLife/Docs/Exam/IELTS.meta
NihongoLife/Docs/Exam/JLPT/*.pdf
# Local-only exam packages built from licensed material (questions, keys, audio). Never commit or ship.
NihongoLife/LocalContent/

# Python bytecode
__pycache__/

# Secrets: Supabase service_role / secret keys, local env files. Never commit.
.env
*.env
.env.*
!.env.example
**/supabase/.env
**/supabase/.temp/
*service_role*
*.secret.json
**/Secrets/
NihongoLife/LocalSecrets/secrets.json
/LocalSecrets/secrets.json

# Agent scratch, Unity batch logs, and one-off test output. Do not commit.
task-o-*-results.xml
task-o-*-test.log
unity-task-o-build*.log
.codex_*.py
.docx_qa_capstone_v4/
.utmp
.utmp/
NihongoLife/playmode-results*.xml
NihongoLife/editmode-results*.xml
NihongoLife/test_results.xml
NihongoLife/test_results_playmode.xml
