  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>\u3072\u3070\u308A\u753A \xB7 Hibari-ch\u014D</b>  \u3072\u3070\u308A\u30DE\u30FC\u30C8
    (konbini, ATM) \xB7 \u3072\u3070\u308A\u5BFF\u53F8 \xB7 \u3072\u3070\u308A\u30CF\u30A4\u30C4
    (nh\xE0) \xB7 \u3072\u3070\u308A\u30AF\u30EA\u30CB\u30C3\u30AF \xB7 \u30B2\u30FC\u30E0\u30BB\u30F3\u30BF\u30FC
    \xB7 \u3053\u3046\u3048\u3093\n<b>\u304C\u304F\u3048\u3093\u307E\u3048</b>  Tr\u01B0\u1EDDng
    Nh\u1EADt ng\u1EEF Hibari \u2014 l\u1EDBp h\u1ECDc, k\u1EF3 thi JLPT / IELTS\n<b>\u30DF\u30CA\u30C8</b> 
    Ph\u1ED1 c\u1EA3ng, ch\u1EE3 c\xE1, Sushi Hibari  \xB7  <b>\u307F\u3069\u308A\u3058\u307E</b> 
    \u0110\u1EA3o Xanh: n\xF4ng tr\u1EA1i, c\xE2u c\xE1\n<b>\u304F\u3046\u3053\u3046</b> 
    S\xE2n bay \u2192 bay th\u1EB3ng t\u1EDBi <b>Ph\xFA Qu\u1ED1c (PQC)</b> \u2014
    D\u01B0\u01A1ng \u0110\xF4ng, nh\xE0 h\xE0ng G\xE1nh Ngon, bi\u1EC3n v\xE0 b\xE3i
    c\xE1t"
