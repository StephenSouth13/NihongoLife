  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Tuy\u1EBFn xe bu\xFDt \u0111\u1EA3o \xB7 \u5CF6\u5185\u30D0\u30B9</b>\n<size=70%>\u2022
    Nh\xE0 h\xE0ng G\xE1nh Ngon   \u2022 D\u01B0\u01A1ng \u0110\xF4ng   \u2022 Ch\u1EE3
    \u0111\xEAm Dinh C\u1EADu   \u2022 Ch\u1EE3 D\u01B0\u01A1ng \u0110\xF4ng   \u2022
    Dinh C\u1EADu   \u2022 Ch\xF9a S\xF9ng H\u01B0ng   \u2022 Nh\xE0 th\xF9ng n\u01B0\u1EDBc
    m\u1EAFm Kh\u1EA3i Ho\xE0n   \u2022 V\u01B0\u1EDDn ti\xEAu (\u0110\u1EE9c Th\u1EA1nh)  
    \u2022 S\xE2n bay qu\u1ED1c t\u1EBF Ph\xFA Qu\u1ED1c   \u2022 B\xE3i Tr\u01B0\u1EDDng  
    \u2022 Su\u1ED1i Tranh   \u2022 L\xE0ng ch\xE0i H\xE0m Ninh   \u2022 Ch\xF9a
    H\u1ED9 Qu\u1ED1c   \u2022 B\xE3i Sao   \u2022 B\xE3i Khem   \u2022 Di t\xEDch
    Nh\xE0 t\xF9 Ph\xFA Qu\u1ED1c   \u2022 Th\u1ECB tr\u1EA5n Ho\xE0ng H\xF4n (C\u1EA7u
    H\xF4n)   \u2022 An Th\u1EDBi   \u2022 C\u1EA3ng An Th\u1EDBi   \u2022 Ga c\xE1p
    treo H\xF2n Th\u01A1m (An Th\u1EDBi)   \u2022 H\xF2n Th\u01A1m (Sun World)  
    \u2022 B\xE3i \xD4ng Lang   \u2022 C\u1EEDa C\u1EA1n   \u2022 Grand World (ch\u1EE3
    \u0111\xEAm ph\u1ED1 \u0111i b\u1ED9)   \u2022 VinWonders Ph\xFA Qu\u1ED1c  
    \u2022 B\xE3i D\xE0i   \u2022 G\xE0nh D\u1EA7u   \u2022 R\u1EA1ch V\u1EB9m  
    \u2022 V\u01B0\u1EDDn qu\u1ED1c gia Ph\xFA Qu\u1ED1c   \u2022 N\xFAi Ch\xFAa
    (603 m)   \u2022 B\xE3i Th\u01A1m</size>"
