  - id: n_livingroom
    nodeType: 0
    nextNodeId: 
    objectiveIdToComplete: 
    speakerName: Tanaka
    speakerId: npc_neighbor_1
    textJa: "どうぞ、ここに座ってください。"
    textReading: "どうぞ、ここにすわってください。"
    textVi: "Mời bạn ngồi ở đây."
    textEn: "Please have a seat here."
    textRomaji: "Douzo, koko ni suwatte kudasai."
    textEnglishIpa: 
    animationCue: talk
    voiceClip: {fileID: 0}
    choices:
    - textJa: "失礼します。"
      textVi: "Xin phép ạ."
      textEn: "Excuse me."
      nextNodeId: n_tea
      scoreModifiers:
      - category: Vocabulary
        value: 10
        reason: "Nói 失礼します khi ngồi xuống chỗ được mời"
      grammarTags: []
      vocabularyTags:
      - vocab.n5.shitsurei_shimasu
      setFlags: []
    - textJa: "はい。"
      textVi: "Vâng."
      textEn: "Okay."
      nextNodeId: n_tea
      scoreModifiers:
      - category: ResponseAccuracy
        value: 3
        reason: "Đáp ngắn được nhưng thiếu lời xin phép lịch sự"
      grammarTags: []
      vocabularyTags: []
      setFlags: []
    - textJa: "座ってもいいですか。"
      textVi: "Tôi ngồi được không ạ?"
      textEn: "May I sit down?"
      nextNodeId: n_livingroom_odd
      scoreModifiers:
