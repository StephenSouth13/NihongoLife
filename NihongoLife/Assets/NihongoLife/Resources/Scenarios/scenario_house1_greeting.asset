  - id: n_leave
    nodeType: 0
    nextNodeId: 
    objectiveIdToComplete: 
    speakerName: Tanaka
    speakerId: npc_neighbor_1
    textJa: "もう、こんな時間ですね。今日は、ありがとう。またいつでも来てくださいね。"
    textReading: "もう、こんなじかんですね。きょうは、ありがとう。またいつでもきてくださいね。"
    textVi: "Đã muộn thế này rồi nhỉ. Hôm nay cảm ơn bạn. Lúc nào cũng hãy ghé chơi nhé."
    textEn: "Oh, it's already this late. Thank you for today. Come by any time."
    textRomaji: "Mou, konna jikan desu ne. Kyou wa, arigatou. Mata itsu demo kite kudasai ne."
    textEnglishIpa: 
    animationCue: talk
    voiceClip: {fileID: 0}
    choices:
    - textJa: "お茶、ごちそうさまでした。お邪魔しました。"
      textVi: "Cảm ơn bác về trà ạ. Cháu xin phép về ạ."
      textEn: "Thank you for the tea. I'll be going now."
      nextNodeId: n_bye
      scoreModifiers:
      - category: Vocabulary
        value: 10
        reason: "Kết thúc buổi thăm bằng ごちそうさまでした và お邪魔しました"
