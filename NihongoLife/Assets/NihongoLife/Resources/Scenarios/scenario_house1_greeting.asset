  m_Script: {fileID: 11500000, guid: 3ba8f435ab5427145b206cd2a4f4ea7c, type: 3}
  m_Name: scenario_house1_greeting
  m_EditorClassIdentifier: NihongoLife::NihongoLife.Scenario.ScenarioDefinition
  id: scenario.house1.greeting
  version: 2
  titleJa: "田中さんの家でお茶"
  titleVi: "Uống trà ở nhà bác Tanaka"
  titleEn: "Tea at Mr. Tanaka's house"
  descriptionJa: "田中さんの家に招かれました。あいさつ、くつ、お茶、写真のことを、日本語でていねいに話しましょう。"
  descriptionVi: "Được bác Tanaka mời sang nhà. Học cách vào nhà, cởi giày, nhận trà, xin phép xem đồ và chào ra về."
  descriptionEn: "Mr. Tanaka invites you over. Learn how to enter a home, take off your shoes, accept tea, ask to look at things and say goodbye."
  chapterIndex: 1
  questType: main
  giverNpcId: npc_neighbor_1
  briefingVi: "Tanaka mời bạn ghé nhà. Chào hỏi đúng phép lịch sự khi đến nhà người khác."
  briefingEn: "Tanaka invites you over. Greet properly when you visit someone's home."
  briefingJa: "田中さんが家に招いてくれました。人の家を訪ねるときの挨拶をしましょう。"
  locationHintVi: "Nhà Tanaka (sát vách)"
  locationHintEn: "Tanaka's house (next door)"
  locationHintJa: "田中さんの家（隣）"
  rewardYen: 100
  branchId: main
  requiredKnowledge: 0
  requiredScenarioIds:
  - scenario.street.first_talk
  unlockScenarioIds:
  - scenario.school.self_intro
  repeatable: 0
  supportsCoOp: 0
  minPlayers: 1
  maxPlayers: 2
  learningTargets:
  - grammar.n5.te_mo_ii_desu_ka
  - grammar.n5.te_kudasai
  - vocab.n5.ojamashimasu
  - vocab.n5.itadakimasu
  - vocab.n5.gochisousama_deshita
  objectives:
  - id: obj_meet
    titleJa: "田中さんに会う"
    titleVi: "Gặp bác Tanaka"
    titleEn: "Meet Mr. Tanaka"
    isOptional: 0
  - id: obj_enter
    titleJa: "礼儀正しく家に入る"
    titleVi: "Vào nhà một cách lịch sự"
    titleEn: "Enter the house politely"
    isOptional: 0
  - id: obj_talk
    titleJa: "お茶を飲みながら話す"
    titleVi: "Vừa uống trà vừa trò chuyện"
    titleEn: "Chat over tea"
    isOptional: 0
  - id: obj_leave
    titleJa: "お礼を言って帰る"
    titleVi: "Cảm ơn và ra về"
    titleEn: "Say thank you and leave"
    isOptional: 0
  nodes:
  - id: node_find_tanaka
    nodeType: 6
    nextNodeId: n_invite
