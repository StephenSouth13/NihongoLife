  - id: n_care_nervous
    nodeType: 0
    nextNodeId: n_door
    objectiveIdToComplete: 
    speakerName: Tanaka
    speakerId: npc_neighbor_1
    textJa: "少し緊張していますね。だいじょうぶ。日本語は、まちがえてもいいですよ。"
    textReading: "すこしきんちょうしていますね。だいじょうぶ。にほんごは、まちがえてもいいですよ。"
    textVi: "Trông bạn hơi căng thẳng nhỉ. Không sao đâu. Nói tiếng Nhật sai cũng không sao mà."
    textEn: "You look a little nervous. It's fine. Making mistakes in Japanese is fine too."
    textRomaji: "Sukoshi kinchou shite imasu ne. Daijoubu. Nihongo wa, machigaete mo ii desu yo."
    textEnglishIpa: 
    animationCue: talk
    voiceClip: {fileID: 0}
    choices: []
