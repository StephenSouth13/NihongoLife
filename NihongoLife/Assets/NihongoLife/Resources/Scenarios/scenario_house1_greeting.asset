    textReading: "\u306F\u3058\u3081\u307E\u3057\u3066\u3002\u305F\u306A\u304B\u3067\u3059\u3002\u3069\u3053\u304B\u3089\u304D\u307E\u3057\u305F\u304B\uFF1F"
