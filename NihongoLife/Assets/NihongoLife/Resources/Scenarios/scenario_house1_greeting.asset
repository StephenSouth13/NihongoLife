      - vocab.n5.ojamashimashita
      setFlags:
      - house1.polite_exit
    - textJa: "さようなら。"
      textVi: "Tạm biệt."
      textEn: "Goodbye."
      nextNodeId: n_leave_casual
      scoreModifiers:
      - category: ResponseAccuracy
        value: 2
        reason: "Chào tạm biệt được nhưng thiếu lời cảm ơn và お邪魔しました"
      grammarTags: []
      vocabularyTags: []
      setFlags: []
    - textJa: "いただきます。"
      textVi: "Cháu xin phép dùng ạ."
      textEn: "I'll gladly have some."
      nextNodeId: n_leave_wrong
