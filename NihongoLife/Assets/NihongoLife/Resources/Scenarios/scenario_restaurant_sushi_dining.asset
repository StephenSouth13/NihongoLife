  m_Script: {fileID: 11500000, guid: 3ba8f435ab5427145b206cd2a4f4ea7c, type: 3}
  m_Name: scenario_restaurant_sushi_dining
  m_EditorClassIdentifier: NihongoLife::NihongoLife.Scenario.ScenarioDefinition
  id: scenario.restaurant.sushi_dining
  version: 1
  titleJa: "すし店で食事"
  titleEn: "Dùng bữa ở quán sushi"
  descriptionJa: "ひばり寿司で、あいさつ、注文、会計まで練習しましょう。"
  descriptionEn: "Luyện toàn bộ quy trình ở quán sushi Hibari: chào hỏi, chọn chỗ, hỏi món đặc sản, báo dị ứng, gọi món, ăn, thanh toán và ra về."
  chapterIndex: 3
  learningTargets:
  - grammar.n5.counter_people
  - grammar.n5.de_onegaishimasu
  - grammar.n5.wo_kudasai
  - grammar.n5.wo_onegaishimasu
  - grammar.n5.nashi_de
  - grammar.n5.daijoubu_desu
  - vocab.n5.itadakimasu
  - vocab.n5.gochisousama_deshita
  - vocab.n5.okaikei
  - vocab.n5.osusume
  objectives:
  - id: obj_enter
    titleJa: "店に入ってあいさつする"
    titleEn: "Vào quán và đáp lời chào"
    isOptional: 0
  - id: obj_seat
    titleJa: "席を決める"
    titleEn: "Chọn chỗ ngồi"
    isOptional: 0
  - id: obj_order
    titleJa: "注文する"
    titleEn: "Gọi món"
    isOptional: 0
  - id: obj_eat
    titleJa: "食事をする"
    titleEn: "Thưởng thức bữa ăn"
    isOptional: 0
  - id: obj_pay
    titleJa: "お会計をする"
    titleEn: "Thanh toán"
    isOptional: 0
  - id: obj_leave
    titleJa: "あいさつして店を出る"
    titleEn: "Chào và rời quán"
    isOptional: 0
  nodes:
  - id: n_arrive
    nodeType: 0
    nextNodeId: n_welcome
    objectiveIdToComplete: 
    speakerName: 
    speakerId: 
    textJa: "夕方、ひばり寿司に着きました。"
    textReading: "ゆうがた、ひばりずしにつきました。"
    textEn: "Chiều tối, bạn đến quán Hibari Sushi."
    textRomaji: "Yuugata, Hibari zushi ni tsukimashita."
    textEnglishIpa: 
    animationCue: 
    voiceClip: {fileID: 0}
    choices: []
    targetItemId: 
    targetNpcId: 
    targetAreaId: 
  - id: n_welcome
    nodeType: 0
    nextNodeId: 
    objectiveIdToComplete: 
    speakerName: Aoki
    speakerId: npc_sushi_staff
    textJa: "いらっしゃいませ！何名様ですか。"
    textReading: "いらっしゃいませ！なんめいさまですか。"
    textEn: "Xin chào quý khách! Quý khách đi mấy người ạ?"
    textRomaji: "Irasshaimase! Nanmeisama desu ka?"
    textEnglishIpa: 
    animationCue: bow
    voiceClip: {fileID: 0}
    choices:
    - textJa: "一人です。"
      textEn: "Một người ạ."
      nextNodeId: n_seat_offer
      scoreModifiers:
      - category: Grammar
        value: 10
        reason: "Dùng đúng cách đếm người 一人 (ひとり) và câu 〜です"
      grammarTags:
      - grammar.n5.counter_people
      - grammar.n5.wa_desu
      vocabularyTags:
      - vocab.n5.hitori
    - textJa: "一人。"
      textEn: "Một người."
      nextNodeId: n_welcome_short
      scoreModifiers:
      - category: ResponseAccuracy
        value: 2
        reason: "Đúng ý nhưng thiếu です nên nghe hơi cộc"
      grammarTags:
      - grammar.n5.counter_people
      vocabularyTags:
      - vocab.n5.hitori
    - textJa: "一つです。"
      textEn: "Một cái ạ."
      nextNodeId: n_welcome_wrong
      scoreModifiers:
      - category: Grammar
        value: -8
        reason: "Dùng bộ đếm đồ vật 一つ cho người (phải dùng 一人)"
      grammarTags: []
      vocabularyTags: []
    targetItemId: 
    targetNpcId: 
    targetAreaId: 
  - id: n_welcome_short
    nodeType: 0
    nextNodeId: n_seat_offer
    objectiveIdToComplete: 
    speakerName: Aoki
    speakerId: npc_sushi_staff
    textJa: "一名様ですね。「一人です」と言うと、もっとていねいですよ。"
    textReading: "いちめいさまですね。「ひとりです」というと、もっとていねいですよ。"
    textEn: "Một người ạ. Nói \"hitori desu\" sẽ lịch sự hơn đấy."
    textRomaji: "Ichimeisama desu ne. \"Hitori desu\" to iu to, motto teinei desu yo."
    textEnglishIpa: 
    animationCue: talk
    voiceClip: {fileID: 0}
    choices: []
    targetItemId: 
    targetNpcId: 
    targetAreaId: 
  - id: n_welcome_wrong
    nodeType: 0
    nextNodeId: n_welcome
    objectiveIdToComplete: 
    speakerName: Aoki
    speakerId: npc_sushi_staff
    textJa: "あ、人は「一人、二人」と数えますよ。もう一度どうぞ。"
    textReading: "あ、ひとは「ひとり、ふたり」とかぞえますよ。もういちどどうぞ。"
    textEn: "À, khi đếm người thì nói \"hitori, futari\" nhé. Mời quý khách nói lại."
    textRomaji: "A, hito wa \"hitori, futari\" to kazoemasu yo. Mou ichido douzo."
    textEnglishIpa: 
    animationCue: point
    voiceClip: {fileID: 0}
    choices: []
    targetItemId: 
    targetNpcId: 
    targetAreaId: 
  - id: n_seat_offer
    nodeType: 0
    nextNodeId: 
    objectiveIdToComplete: obj_enter
    speakerName: Aoki
    speakerId: npc_sushi_staff
    textJa: "カウンターとテーブルがあります。どちらがいいですか。"
    textReading: "カウンターとテーブルがあります。どちらがいいですか。"
    textEn: "Quán có quầy và bàn. Quý khách muốn ngồi chỗ nào ạ?"
    textRomaji: "Kauntaa to teeburu ga arimasu. Dochira ga ii desu ka?"
    textEnglishIpa: 
    animationCue: talk
    voiceClip: {fileID: 0}
    choices:
    - textJa: "カウンターでお願いします。"
      textEn: "Cho tôi ngồi ở quầy nhé."
      nextNodeId: n_counter
      scoreModifiers:
      - category: Grammar
        value: 10
        reason: "Dùng đúng mẫu 〜でお願いします để chọn chỗ ngồi"
      grammarTags:
      - grammar.n5.de_onegaishimasu
      vocabularyTags:
      - vocab.n5.kauntaa
    - textJa: "テーブルでお願いします。"
      textEn: "Cho tôi ngồi ở bàn nhé."
      nextNodeId: n_table
      scoreModifiers:
      - category: Grammar
        value: 10
        reason: "Dùng đúng mẫu 〜でお願いします để chọn chỗ ngồi"
      grammarTags:
      - grammar.n5.de_onegaishimasu
      vocabularyTags:
      - vocab.n5.teeburu
    - textJa: "どちらでもいいです。"
      textEn: "Chỗ nào cũng được ạ."
      nextNodeId: n_seat_any
      scoreModifiers:
      - category: ResponseAccuracy
        value: 4
        reason: "Trả lời được nhưng nhường hết quyết định cho nhân viên"
      grammarTags:
      - grammar.n5.dochira
      vocabularyTags: []
    - textJa: "カウンターをください。"
      textEn: "Cho tôi cái quầy."
      nextNodeId: n_seat_wrong
      scoreModifiers:
      - category: Grammar
        value: -8
        reason: "Dùng をください (xin một vật) cho chỗ ngồi; phải dùng 〜でお願いします"
      grammarTags: []
      vocabularyTags: []
    targetItemId: 
    targetNpcId: 
    targetAreaId: 
  - id: n_counter
    nodeType: 0
    nextNodeId: n_thanks_towel
    objectiveIdToComplete: obj_seat
    speakerName: Ota
    speakerId: npc_sushi_chef
    textJa: "いらっしゃい！今日はいい魚がありますよ。どうぞ、ここへ。"
    textReading: "いらっしゃい！きょうはいいさかながありますよ。どうぞ、ここへ。"
    textEn: "Chào mừng! Hôm nay có cá ngon lắm đấy. Mời ngồi đây."
    textRomaji: "Irasshai! Kyou wa ii sakana ga arimasu yo. Douzo, koko e."
    textEnglishIpa: 
    animationCue: talk
    voiceClip: {fileID: 0}
    choices: []
    targetItemId: 
    targetNpcId: 
    targetAreaId: 
  - id: n_table
    nodeType: 0
    nextNodeId: n_thanks_towel
    objectiveIdToComplete: obj_seat
    speakerName: Aoki
    speakerId: npc_sushi_staff
    textJa: "こちらのテーブルへどうぞ。"
    textReading: "こちらのテーブルへどうぞ。"
    textEn: "Mời quý khách ngồi bàn này ạ."
    textRomaji: "Kochira no teeburu e douzo."
    textEnglishIpa: 
    animationCue: point
    voiceClip: {fileID: 0}
    choices: []
    targetItemId: 
    targetNpcId: 
    targetAreaId: 
  - id: n_seat_any
    nodeType: 0
    nextNodeId: n_thanks_towel
    objectiveIdToComplete: obj_seat
    speakerName: Aoki
    speakerId: npc_sushi_staff
    textJa: "では、カウンターへどうぞ。大将の前です。"
    textReading: "では、カウンターへどうぞ。たいしょうのまえです。"
    textEn: "Vậy mời quý khách ngồi quầy ạ. Ngay trước mặt đầu bếp (taishou, cách gọi kính trọng dành cho bếp trưởng)."
    textRomaji: "Dewa, kauntaa e douzo. Taishou no mae desu."
    textEnglishIpa: 
    animationCue: point
    voiceClip: {fileID: 0}
    choices: []
    targetItemId: 
    targetNpcId: 
    targetAreaId: 
  - id: n_seat_wrong
    nodeType: 0
    nextNodeId: n_seat_offer
    objectiveIdToComplete: 
    speakerName: Aoki
    speakerId: npc_sushi_staff
    textJa: "「カウンターをください」ではありませんよ。席は「〜でお願いします」と言います。もう一度どうぞ。"
    textReading: "「カウンターをください」ではありませんよ。せきは「〜でおねがいします」といいます。もういちどどうぞ。"
    textEn: "Không phải \"kauntaa wo kudasai\" đâu ạ. Khi chọn chỗ ngồi, hãy nói \"~ de onegaishimasu\". Mời quý khách nói lại."
    textRomaji: "\"Kauntaa wo kudasai\" dewa arimasen yo. Seki wa \"~ de onegaishimasu\" to iimasu. Mou ichido douzo."
    textEnglishIpa: 
    animationCue: point
    voiceClip: {fileID: 0}
    choices: []
    targetItemId: 
    targetNpcId: 
    targetAreaId: 
  - id: n_thanks_towel
    nodeType: 0
    nextNodeId: 
    objectiveIdToComplete: 
    speakerName: Aoki
    speakerId: npc_sushi_staff
    textJa: "おしぼりとお茶です。どうぞ。"
    textReading: "おしぼりとおちゃです。どうぞ。"
    textEn: "Khăn ướt và trà ạ. Mời quý khách."
    textRomaji: "Oshibori to ocha desu. Douzo."
    textEnglishIpa: 
    animationCue: bow
    voiceClip: {fileID: 0}
    choices:
    - textJa: "ありがとうございます。"
      textEn: "Cảm ơn ạ."
      nextNodeId: n_towel_ok
      scoreModifiers:
      - category: Vocabulary
        value: 8
        reason: "Cảm ơn đúng mức lịch sự khi nhận khăn và trà"
      grammarTags: []
      vocabularyTags:
      - vocab.n5.arigatou_gozaimasu
    - textJa: "どうも。"
      textEn: "Cảm ơn."
      nextNodeId: n_towel_casual
      scoreModifiers:
      - category: ResponseAccuracy
        value: 3
        reason: "Cảm ơn ngắn gọn, ổn với nhân viên quán nhưng kém lịch sự hơn"
      grammarTags: []
      vocabularyTags:
      - vocab.n5.arigatou_gozaimasu
    - textJa: "いただきます。"
      textEn: "Xin phép được ăn ạ."
      nextNodeId: n_towel_wrong
      scoreModifiers:
      - category: ResponseAccuracy
        value: -8
        reason: "いただきます chỉ nói trước khi ăn, không dùng khi nhận khăn"
      grammarTags: []
      vocabularyTags: []
    targetItemId: 
    targetNpcId: 
    targetAreaId: 
  - id: n_towel_ok
    nodeType: 0
    nextNodeId: n_ask_order
    objectiveIdToComplete: 
    speakerName: Aoki
    speakerId: npc_sushi_staff
    textJa: "いえいえ。メニューはそちらのボードにあります。ゆっくり見てくださいね。"
    textReading: "いえいえ。メニューはそちらのボードにあります。ゆっくりみてくださいね。"
    textEn: "Không có gì ạ. Thực đơn ở bảng bên kia, quý khách cứ xem thong thả nhé. (Gợi ý: lại gần bảng thực đơn trong quán và nhấn E để xem chi tiết từng món.)"
    textRomaji: "Ie ie. Menyuu wa sochira no boodo ni arimasu. Yukkuri mite kudasai ne."
    textEnglishIpa: 
    animationCue: bow
    voiceClip: {fileID: 0}
    choices: []
    targetItemId: 
    targetNpcId: 
    targetAreaId: 
  - id: n_towel_casual
    nodeType: 0
    nextNodeId: n_ask_order
    objectiveIdToComplete: 
    speakerName: Aoki
    speakerId: npc_sushi_staff
    textJa: "いえいえ。「ありがとうございます」と言うと、もっとていねいですよ。メニューはそちらのボードにあります。"
    textReading: "いえいえ。「ありがとうございます」というと、もっとていねいですよ。メニューはそちらのボードにあります。"
    textEn: "Không có gì ạ. Nói \"arigatou gozaimasu\" sẽ lịch sự hơn. Thực đơn ở bảng bên kia ạ. (Gợi ý: lại gần bảng thực đơn trong quán và nhấn E để xem chi tiết từng món.)"
    textRomaji: "Ie ie. \"Arigatou gozaimasu\" to iu to, motto teinei desu yo. Menyuu wa sochira no boodo ni arimasu."
    textEnglishIpa: 
    animationCue: talk
    voiceClip: {fileID: 0}
    choices: []
    targetItemId: 
    targetNpcId: 
    targetAreaId: 
  - id: n_towel_wrong
    nodeType: 0
    nextNodeId: n_thanks_towel
    objectiveIdToComplete: 
    speakerName: Aoki
    speakerId: npc_sushi_staff
    textJa: "あ、「いただきます」は食べるときに言いますよ。ここは「ありがとうございます」ですね。"
    textReading: "あ、「いただきます」はたべるときにいいますよ。ここは「ありがとうございます」ですね。"
    textEn: "À, \"itadakimasu\" chỉ nói khi bắt đầu ăn thôi ạ. Ở đây phải nói \"arigatou gozaimasu\"."
    textRomaji: "A, \"itadakimasu\" wa taberu toki ni iimasu yo. Koko wa \"arigatou gozaimasu\" desu ne."
    textEnglishIpa: 
    animationCue: point
    voiceClip: {fileID: 0}
    choices: []
    targetItemId: 
    targetNpcId: 
    targetAreaId: 
  - id: n_ask_order
    nodeType: 0
    nextNodeId: 
    objectiveIdToComplete: 
    speakerName: Aoki
    speakerId: npc_sushi_staff
    textJa: "ご注文はお決まりですか。"
    textReading: "ごちゅうもんはおきまりですか。"
    textEn: "Quý khách đã chọn món chưa ạ?"
    textRomaji: "Gochuumon wa okimari desu ka?"
    textEnglishIpa: 
    animationCue: talk
    voiceClip: {fileID: 0}
    choices:
    - textJa: "おすすめは何ですか。"
      textEn: "Món nào được gợi ý ạ?"
      nextNodeId: n_recommend
      scoreModifiers:
      - category: Vocabulary
        value: 8
        reason: "Hỏi món gợi ý đúng cách: おすすめは何ですか"
      grammarTags:
      - grammar.n5.nan_desu_ka
      vocabularyTags:
      - vocab.n5.osusume
    - textJa: "まぐろとサーモンをください。"
      textEn: "Cho tôi cá ngừ và cá hồi."
      nextNodeId: n_order_nigiri
      scoreModifiers:
      - category: Grammar
        value: 10
        reason: "Dùng đúng mẫu 〜と〜をください để gọi hai món"
      grammarTags:
      - grammar.n5.wo_kudasai
      - grammar.n5.to_and
      vocabularyTags:
      - vocab.n5.maguro
      - vocab.n5.sake
    - textJa: "まぐろとサーモンください。"
      textEn: "Cho tôi cá ngừ và cá hồi."
      nextNodeId: n_order_casual
      scoreModifiers:
      - category: Grammar
        value: 3
        reason: "Đúng ý nhưng bỏ trợ từ を nên hơi cộc, hợp với người quen hơn là nhân viên"
      grammarTags:
      - grammar.n5.wo_kudasai
      vocabularyTags:
      - vocab.n5.maguro
      - vocab.n5.sake
    - textJa: "すみません、まだです。"
      textEn: "Xin lỗi, tôi chưa chọn xong."
      nextNodeId: n_not_yet
      scoreModifiers:
      - category: ResponseAccuracy
        value: 5
        reason: "Nói lịch sự rằng mình chưa quyết định xong"
      grammarTags: []
      vocabularyTags:
      - vocab.n5.sumimasen
    - textJa: "まぐろは食べます。"
      textEn: "Tôi ăn cá ngừ."
      nextNodeId: n_order_wrong
      scoreModifiers:
      - category: Grammar
        value: -8
        reason: "Câu này chỉ nói mình ăn cá ngừ, không phải gọi món (gọi món dùng 〜をください/〜をお願いします)"
      grammarTags: []
      vocabularyTags: []
    targetItemId: 
    targetNpcId: 
    targetAreaId: 
  - id: n_not_yet
    nodeType: 0
    nextNodeId: n_ask_order
    objectiveIdToComplete: 
    speakerName: Aoki
    speakerId: npc_sushi_staff
    textJa: "はい、ゆっくりどうぞ。決まったらお呼びください。"
    textReading: "はい、ゆっくりどうぞ。きまったらおよびください。"
    textEn: "Vâng, cứ thong thả ạ. Chọn xong thì gọi tôi nhé."
    textRomaji: "Hai, yukkuri douzo. Kimattara oyobi kudasai."
    textEnglishIpa: 
    animationCue: bow
    voiceClip: {fileID: 0}
    choices: []
    targetItemId: 
    targetNpcId: 
    targetAreaId: 
  - id: n_order_wrong
    nodeType: 0
    nextNodeId: n_ask_order
    objectiveIdToComplete: 
    speakerName: Aoki
    speakerId: npc_sushi_staff
    textJa: "注文のときは「〜をください」と言いますよ。もう一度どうぞ。"
    textReading: "ちゅうもんのときは「〜をください」といいますよ。もういちどどうぞ。"
    textEn: "Khi gọi món thì nói \"~ wo kudasai\" nhé. Mời quý khách gọi lại."
    textRomaji: "Chuumon no toki wa \"~ wo kudasai\" to iimasu yo. Mou ichido douzo."
    textEnglishIpa: 
    animationCue: point
    voiceClip: {fileID: 0}
    choices: []
