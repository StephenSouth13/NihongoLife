    objectiveIdToComplete: obj_help
    speakerName: Suzuki
    speakerId: npc_neighbor_2
    textJa: "ミケを見たら、教えてください。私の家は、あの青い屋根の家です。"
    textReading: "ミケをみたら、おしえてください。わたしのいえは、あのあおいやねのいえです。"
    textVi: "Nếu bạn thấy Mike, xin hãy báo cho tôi. Nhà tôi là căn có mái xanh kia."
    textEn: "If you see Mike, please tell me. My house is the one with the blue roof over there."
    textRomaji: "Mike wo mitara, oshiete kudasai. Watashi no ie wa, ano aoi yane no ie desu."
    textEnglishIpa: 
    animationCue: point
    voiceClip: {fileID: 0}
    choices:
    - textJa: "はい、見たら、すぐ教えます。"
