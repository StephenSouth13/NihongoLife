  - id: n_place
    nodeType: 0
    nextNodeId: 
    objectiveIdToComplete: 
    speakerName: Suzuki
    speakerId: npc_neighbor_2
    textJa: "ミケは、よく神社の近くに行きます。公園にも行きます。"
    textReading: "ミケは、よくじんじゃのちかくにいきます。こうえんにもいきます。"
    textVi: "Mike hay đi đến gần đền thờ. Nó cũng hay ra công viên."
    textEn: "Mike often goes near the shrine. She also likes the park."
    textRomaji: "Mike wa, yoku jinja no chikaku ni ikimasu. Kouen ni mo ikimasu."
    textEnglishIpa: 
    animationCue: point
    voiceClip: {fileID: 0}
    choices:
    - textJa: "神社の近くですね。分かりました。"
      textVi: "Gần đền thờ nhỉ. Tôi hiểu rồi ạ."
      textEn: "Near the shrine. I understand."
      nextNodeId: n_help
      scoreModifiers:
      - category: Vocabulary
        value: 10
        reason: "Xác nhận thông tin bằng cách nhắc lại địa điểm: 神社の近く"
      grammarTags:
      - grammar.n5.desu_ne
      vocabularyTags:
      - vocab.n5.jinja
      - vocab.n5.chikaku
      setFlags:
      - cat.shrine_hint
    - textJa: "公園ですね。分かりました。"
      textVi: "Công viên nhỉ. Tôi hiểu rồi ạ."
      textEn: "The park. I understand."
      nextNodeId: n_help
      scoreModifiers:
      - category: Vocabulary
        value: 8
        reason: "Xác nhận thông tin bằng cách nhắc lại địa điểm: 公園"
      grammarTags:
      - grammar.n5.desu_ne
      vocabularyTags:
      - vocab.n5.kouen
      setFlags:
      - cat.park_hint
    - textJa: "神社は嫌いです。"
      textVi: "Tôi không thích đền thờ."
      textEn: "I don't like shrines."
      nextNodeId: n_place_wrong
      scoreModifiers:
      - category: ResponseAccuracy
