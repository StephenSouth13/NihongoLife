  m_Name: scenario_house2_lostcat
  m_EditorClassIdentifier: NihongoLife::NihongoLife.Scenario.ScenarioDefinition
  id: scenario.house2.lostcat
  version: 2
  titleJa: "鈴木さんの猫を探す"
  titleVi: "Giúp cô Suzuki tìm mèo"
  titleEn: "Help Ms. Suzuki find her cat"
  descriptionJa: "鈴木さんの猫が、昨日からいません。話を聞いて、手伝いましょう。"
  descriptionVi: "Con mèo Mike của cô Suzuki mất từ hôm qua. Hỏi thăm, nghe tả đặc điểm và nhận lời giúp."
  descriptionEn: "Ms. Suzuki's cat Mike has been missing since yesterday. Ask about it, understand the description and offer to help."
  chapterIndex: 3
  questType: community
  giverNpcId: npc_neighbor_2
  briefingVi: "Suzuki lo lắng vì chú mèo bị lạc. Hãy hỏi thăm và nghe cô ấy tả con mèo bằng tiếng Nhật."
  briefingEn: "Suzuki is worried about her lost cat. Ask about it and listen to her describe the cat in Japanese."
  briefingJa: "鈴木さんは迷子の猫を心配しています。声をかけて、猫の特徴を日本語で聞きましょう。"
  locationHintVi: "Nhà Suzuki"
  locationHintEn: "Suzuki's house"
  locationHintJa: "鈴木さんの家"
  rewardYen: 300
  branchId: community
  requiredKnowledge: 40
  requiredScenarioIds:
  - scenario.konbini.buy_onigiri
  unlockScenarioIds:
  - scenario.neighborhood.cat_followup
  repeatable: 0
  supportsCoOp: 0
  minPlayers: 1
  maxPlayers: 2
  learningTargets:
  - grammar.n5.donna_desu_ka
  - grammar.n5.masen_deshita
  - grammar.n5.mashou_ka
  - vocab.n5.neko
  - vocab.n5.jinja
  objectives:
  - id: obj_meet
    titleJa: "鈴木さんに会う"
    titleVi: "Gặp cô Suzuki"
    titleEn: "Meet Ms. Suzuki"
    isOptional: 0
  - id: obj_describe
    titleJa: "ミケのようすを聞き取る"
    titleVi: "Nghe hiểu đặc điểm của Mike"
    titleEn: "Understand what Mike looks like"
    isOptional: 0
  - id: obj_help
    titleJa: "手伝うと言う"
    titleVi: "Nhận lời giúp tìm mèo"
    titleEn: "Offer to help find the cat"
    isOptional: 0
