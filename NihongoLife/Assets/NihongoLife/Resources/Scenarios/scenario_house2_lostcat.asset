  - id: n_when
    nodeType: 0
    nextNodeId: 
    objectiveIdToComplete: 
    speakerName: Suzuki
    speakerId: npc_neighbor_2
    textJa: "昨日の夜、窓を開けました。それから、ミケがいません。"
    textReading: "きのうのよる、まどをあけました。それから、ミケがいません。"
    textVi: "Tối qua tôi mở cửa sổ. Từ đó, Mike không thấy đâu nữa."
    textEn: "Last night I opened the window. Since then, Mike has been gone."
    textRomaji: "Kinou no yoru, mado wo akemashita. Sorekara, Mike ga imasen."
    textEnglishIpa: 
    animationCue: talk
    voiceClip: {fileID: 0}
    choices:
    - textJa: "いつからいませんか。"
      textVi: "Nó mất từ khi nào ạ?"
      textEn: "Since when has she been missing?"
      nextNodeId: n_when_answer
      scoreModifiers:
      - category: Grammar
        value: 10
        reason: "Hỏi thời điểm bằng いつから để nắm rõ tình hình"
      grammarTags:
      - grammar.n5.itsu_kara
      vocabularyTags:
      - vocab.n5.itsu
      setFlags: []
    - textJa: "いつですか。"
      textVi: "Khi nào ạ?"
      textEn: "When?"
      nextNodeId: n_when_answer
      scoreModifiers:
      - category: ResponseAccuracy
        value: 3
        reason: "Hỏi được nhưng thiếu から nên không rõ hỏi 'từ khi nào', dễ gây hiểu nhầm"
      grammarTags: []
      vocabularyTags:
      - vocab.n5.itsu
      setFlags: []
    - textJa: "どこですか。"
      textVi: "Ở đâu ạ?"
      textEn: "Where?"
      nextNodeId: n_when_wrong
      scoreModifiers:
      - category: Grammar
