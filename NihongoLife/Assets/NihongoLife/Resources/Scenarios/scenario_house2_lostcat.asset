    nodeType: 0
    nextNodeId: n_open
    objectiveIdToComplete: 
    speakerName: Suzuki
    speakerId: npc_neighbor_2
    textJa: "あ、ありがとう…。でも、今は、うちの猫がいなくて…。"
    textReading: "あ、ありがとう…。でも、いまは、うちのねこがいなくて…。"
    textVi: "À, cảm ơn... Nhưng bây giờ mèo nhà tôi đi mất rồi..."
    textEn: "Ah, thank you... But my cat has gone missing now..."
    textRomaji: "A, arigatou.... Demo, ima wa, uchi no neko ga inakute...."
    textEnglishIpa: 
    animationCue: talk
