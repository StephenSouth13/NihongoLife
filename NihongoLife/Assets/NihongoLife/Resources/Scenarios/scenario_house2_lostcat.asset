  descriptionJa: "\u8FD1\u6240\u306E\u4EBA\u304C\u732B\u3092\u63A2\u3057\u3066\u3044\u307E\u3059\u3002\u624B\u4F1D\u3063\u3066\u3042\u3052\u307E\u3057\u3087\u3046\u3002"
