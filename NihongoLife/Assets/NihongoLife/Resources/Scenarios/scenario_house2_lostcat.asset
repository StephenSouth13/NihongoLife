    nextNodeId: n_place
    objectiveIdToComplete: 
    speakerName: Suzuki
    speakerId: npc_neighbor_2
    textJa: "昨日の夜、八時ごろからです。もう、二十時間です。"
    textReading: "きのうのよる、はちじごろからです。もう、にじゅうじかんです。"
    textVi: "Từ khoảng tám giờ tối qua. Đã hai mươi tiếng rồi."
    textEn: "Since about eight last night. It's been twenty hours already."
    textRomaji: "Kinou no yoru, hachiji goro kara desu. Mou, nijuu jikan desu."
    textEnglishIpa: 
    animationCue: talk
    voiceClip: {fileID: 0}
    choices: []
