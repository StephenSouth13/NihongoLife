  m_Script: {fileID: 11500000, guid: 3ba8f435ab5427145b206cd2a4f4ea7c, type: 3}
  m_Name: scenario_street_first_talk
  m_EditorClassIdentifier: NihongoLife::NihongoLife.Scenario.ScenarioDefinition
  id: scenario.street.first_talk
  version: 2
  titleJa: "通りであいさつ"
  titleEn: "Chào hỏi và hỏi đường trên phố"
  descriptionJa: "朝のあいさつをして、ひばりコンビニへの道を聞きましょう。"
  descriptionEn: "Chào buổi sáng, nói mình đi đâu và hỏi đường đến cửa hàng tiện lợi Hibari."
  chapterIndex: 1
  questType: main
  giverNpcId: npc_neighbor_1
  briefingVi: "Một người hàng xóm thân thiện chào bạn trên phố. Hãy đáp lại bằng tiếng Nhật và luyện phát âm."
  briefingEn: "A friendly neighbour greets you on the street. Answer in Japanese and practise your pronunciation."
  briefingJa: "親切な隣人が通りで声をかけてくれます。日本語で答えて、発音も練習しましょう。"
  locationHintVi: "Sakura-dōri, gần nhà bạn"
  locationHintEn: "Sakura-dori, near your home"
  locationHintJa: "さくら通り（家の近く）"
  rewardYen: 200
  branchId: main
  requiredKnowledge: 0
  requiredScenarioIds:
  - scenario.intro.arrival
  unlockScenarioIds:
  - scenario.house1.greeting
  repeatable: 0
  supportsCoOp: 0
  minPlayers: 1
  maxPlayers: 2
  learningTargets:
  - grammar.n5.e_ikimasu
  - grammar.n5.wa_doko_desu_ka
  - vocab.n5.ohayou_gozaimasu
  - vocab.n5.massugu
  - vocab.n5.migi
  - vocab.n5.hidari
  objectives:
  - id: obj_talk_to_neighbor
    titleJa: "通りの人に話しかける"
    titleEn: "Bắt chuyện với người hàng xóm trên phố"
    isOptional: 0
  - id: obj_greet
    titleJa: "朝のあいさつと世間話をする"
    titleEn: "Chào buổi sáng và trò chuyện về thời tiết"
    isOptional: 0
  - id: obj_ask_way
    titleJa: "道をたずねて、聞き取る"
    titleEn: "Hỏi đường và nghe hiểu chỉ dẫn"
    isOptional: 0
  - id: obj_thank
    titleJa: "お礼を言って別れる"
    titleEn: "Cảm ơn và chào tạm biệt"
    isOptional: 0
  - id: obj_practice_voice
    titleJa: "声に出して練習する"
    titleEn: "Luyện nói bằng micro (không bắt buộc)"
    isOptional: 1
  nodes:
  - id: node_find_neighbor
    nodeType: 6
    nextNodeId: n_greet
