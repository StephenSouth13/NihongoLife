    textJa: "\u3053\u3093\u306B\u3061\u306F\u3002\u3069\u3053\u3078\u884C\u304D\u307E\u3059\u304B\u3002"
    textReading: "\u3053\u3093\u306B\u3061\u306F\u3002\u3069\u3053\u3078\u3044\u304D\u307E\u3059\u304B\u3002"
    textEn: Hello. Where are you going?
    textRomaji: Konnichiwa. Doko e ikimasu ka.
    textEnglishIpa: "/h\u0259\u02C8lo\u028A we\u0259r \u0251\u02D0r ju\u02D0 \u02C8\u0261o\u028A\u026A\u014B/"
    animationCue: talk
    voiceClip: {fileID: 0}
    choices:
    - textJa: "\u30B3\u30F3\u30D3\u30CB\u3078\u884C\u304D\u307E\u3059\u3002"
      textEn: I am going to the convenience store.
      nextNodeId: node_neighbor_reply
