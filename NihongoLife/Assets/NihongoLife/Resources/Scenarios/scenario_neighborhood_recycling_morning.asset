  - id: n_end
    nodeType: 0
    nextNodeId: n_recap
    objectiveIdToComplete: 
    speakerName: Sato
    speakerId: npc_neighbor_3
    textJa: "完璧です。これで町をきれいにできますね。"
    textReading: "かんぺきです。これでまちをきれいにできますね。"
    textEn: "Hoàn hảo. Vậy là chúng ta có thể giữ khu phố sạch đẹp rồi nhỉ."
    textRomaji: "Kanpeki desu. Kore de machi wo kirei ni dekimasu ne."
    textEnglishIpa: 
    animationCue: bow
    voiceClip: {fileID: 0}
    choices: []
