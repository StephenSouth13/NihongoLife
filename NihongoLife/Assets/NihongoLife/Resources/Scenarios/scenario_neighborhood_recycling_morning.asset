  m_Name: scenario_neighborhood_recycling_morning
  m_EditorClassIdentifier: NihongoLife::NihongoLife.Scenario.ScenarioDefinition
  id: scenario.neighborhood.recycling_morning
  version: 2
  titleJa: "資源ごみの朝"
  titleEn: "Buổi sáng phân loại rác tái chế"
  descriptionJa: "佐藤さんと資源ごみの分け方を確認しましょう。"
  descriptionEn: "Cùng bác Sato kiểm tra cách phân loại rác tái chế: chai nhựa, lon, chai thủy tinh và giấy cũ."
  chapterIndex: 3
  questType: community
  giverNpcId: npc_neighbor_3
  briefingVi: "Sáng thứ hai là ngày thu gom rác tái chế. Phân loại đúng và hỏi Sato khi chưa chắc."
  briefingEn: "Monday morning is recycling day. Sort correctly and ask Sato when you are unsure."
  briefingJa: "月曜の朝はリサイクルの日。正しく分別し、迷ったら佐藤さんに聞きましょう。"
  locationHintVi: "Điểm tập kết rác gần nhà Sato"
  locationHintEn: "The collection point near Sato's house"
  locationHintJa: "佐藤さんの家の近くのゴミ置き場"
  rewardYen: 300
  branchId: community
  requiredKnowledge: 50
  requiredScenarioIds:
  - scenario.house3.garbage
  unlockScenarioIds:
  - scenario.town.summer_festival
  repeatable: 0
  supportsCoOp: 0
  minPlayers: 1
  maxPlayers: 2
  learningTargets:
