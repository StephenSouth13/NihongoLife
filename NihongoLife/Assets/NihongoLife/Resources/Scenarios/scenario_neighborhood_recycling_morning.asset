    titleJa: "佐藤さんに会う"
    titleEn: "Gặp lại trưởng khu phố Sato"
    isOptional: 0
  - id: obj_learn_recycling
    titleJa: "分別を確認する"
    titleEn: "Học quy tắc phân loại rác tái chế"
    isOptional: 0
