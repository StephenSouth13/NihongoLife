  m_Script: {fileID: 11500000, guid: 3ba8f435ab5427145b206cd2a4f4ea7c, type: 3}
  m_Name: scenario_island_midori_trip
  m_EditorClassIdentifier: NihongoLife::NihongoLife.Scenario.ScenarioDefinition
  id: scenario.island.midori_trip
  version: 2
  titleJa: "みどり島の畑へ"
  titleVi: "Ra ruộng trên đảo Midori"
  titleEn: "To the Fields of Midori Island"
  descriptionJa: "田中さんと電車でみどり島へ。おばあちゃんの畑で、たがやす・まく・水をやるを学びます。"
  descriptionVi: "Cùng bác Tanaka đi tàu ra đảo Midori: mua vé, ngắm biển từ cửa sổ tàu, học cách xới đất, gieo hạt, tưới nước ở ruộng của bà."
  descriptionEn: "Take the train to Midori Island with Mr. Tanaka: buy the ticket, watch the sea from the window, and learn to till, sow and water in his grandmother's field."
  chapterIndex: 5
  questType: main
  giverNpcId: npc_neighbor_1
  briefingVi: "Tanaka mời bạn ra ruộng của bà anh ấy trên đảo Midori. Đi tàu, ngắm biển, học xới đất, gieo hạt, tưới nước."
  briefingEn: "Tanaka invites you to his grandmother's field on Midori Island. Take the train, watch the sea, learn to till, sow and water."
  briefingJa: "田中さんがみどり島のおばあちゃんの畑にさそってくれます。電車で行って、たがやす・まく・水をやるを学びます。"
  locationHintVi: "Gặp Tanaka ở phố, rồi Đảo Xanh"
  locationHintEn: "Meet Tanaka in town, then Midori Island"
  locationHintJa: "町で田中さん → みどり島"
  rewardYen: 500
  branchId: main
  requiredKnowledge: 320
  requiredScenarioIds:
  - scenario.arcade.kim_invite
  unlockScenarioIds:
  - scenario.town.summer_festival
  repeatable: 0
  supportsCoOp: 0
  minPlayers: 1
  maxPlayers: 2
  learningTargets:
  - grammar.n5.nan_de
  - grammar.n5.ga_miemasu
  - grammar.n5.te_mo_ii
  - vocab.n5.hatake
  - vocab.n5.shima
  objectives:
  - id: obj_meet
    titleJa: "田中さんに会う"
    titleVi: "Gặp bác Tanaka"
    titleEn: "Meet Mr. Tanaka"
    isOptional: 0
  - id: obj_station
    titleJa: "ひばり駅で切符を買う"
    titleVi: "Mua vé ở ga Hibari"
    titleEn: "Buy a ticket at Hibari Station"
    isOptional: 0
  - id: obj_arrive
    titleJa: "みどり島に着く"
    titleVi: "Đến đảo Midori"
    titleEn: "Arrive at Midori Island"
    isOptional: 0
  - id: obj_field
    titleJa: "畑をもらう"
    titleVi: "Nhận mảnh ruộng của bà"
    titleEn: "Receive Grandma's field"
    isOptional: 0
  nodes:
  - id: node_find_tanaka
