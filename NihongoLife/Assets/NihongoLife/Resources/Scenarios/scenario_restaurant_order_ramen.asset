  m_Name: scenario_restaurant_order_ramen
  m_EditorClassIdentifier: NihongoLife::NihongoLife.Scenario.ScenarioDefinition
  id: scenario.restaurant.order_ramen
  version: 2
  titleJa: "やまだ食堂でラーメン"
  titleEn: "Ăn ramen ở quán Yamada"
  descriptionJa: "田中さんと、やまだ食堂へ行きましょう。券売機、注文、水、食べ方を練習します。"
  descriptionEn: "Cùng bác Tanaka đến quán ramen của chú Yamada: mua vé ở máy, chọn độ cứng mì, tự lấy nước, cách ăn và cách nói khi ra về."
  chapterIndex: 3
  questType: side
  giverNpcId: npc_neighbor_1
  briefingVi: "Tanaka dẫn bạn tới quán ramen của ông Yamada. Gọi món và trả tiền theo cách khác với nhà hàng sushi."
  briefingEn: "Tanaka takes you to Mr. Yamada's ramen shop. Order and pay in a more casual way than at the sushi restaurant."
  briefingJa: "田中さんが山田さんのラーメン店に案内してくれます。寿司店よりカジュアルな注文と支払いを学びます。"
  locationHintVi: "やまだ食堂 (quán ramen)"
  locationHintEn: "Yamada Shokudo (ramen shop)"
  locationHintJa: "やまだ食堂"
  rewardYen: 0
  branchId: side
  requiredKnowledge: 60
  requiredScenarioIds:
  - scenario.konbini.buy_onigiri
  unlockScenarioIds:
  - scenario.town.summer_festival
  repeatable: 0
  supportsCoOp: 0
  minPlayers: 1
  maxPlayers: 2
  learningTargets:
  - grammar.n5.ni_shimasu
  - grammar.n5.masen_ka
  - grammar.n5.tai_desu
  - vocab.n5.gochisousama_deshita
  - vocab.n5.sen
  objectives:
  - id: obj_meet
    titleJa: "田中さんに会う"
    titleEn: "Gặp bác Tanaka"
    isOptional: 0
  - id: obj_arrive
    titleJa: "やまだ食堂に着く"
    titleEn: "Đến quán Yamada"
    isOptional: 0
  - id: obj_ticket
    titleJa: "券売機で券を買う"
    titleEn: "Mua vé ở máy bán vé"
    isOptional: 0
  - id: obj_eat
    titleJa: "ラーメンを食べる"
    titleEn: "Thưởng thức ramen"
    isOptional: 0
  - id: obj_pay
    titleJa: "お礼を言って店を出る"
    titleEn: "Cảm ơn và rời quán"
    isOptional: 0
  nodes:
  - id: node_find_tanaka
    nodeType: 6
    nextNodeId: n_invite
    objectiveIdToComplete: obj_meet
