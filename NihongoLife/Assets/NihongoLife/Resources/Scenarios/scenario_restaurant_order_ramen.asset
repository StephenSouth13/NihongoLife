  - id: n_menu
    nodeType: 0
    nextNodeId: n_flavor
    objectiveIdToComplete: 
    speakerName: 
    speakerId: 
    textJa: "券売機のボタン：しょうゆ 八百円　みそ 九百円　しお 八百円　ぎょうざ 四百円　大盛り 百円"
    textReading: "けんばいきのボタン：しょうゆ はっぴゃくえん　みそ きゅうひゃくえん　しお はっぴゃくえん　ぎょうざ よんひゃくえん　おおもり ひゃくえん"
    textVi: "Các nút của máy: shoyu 800 yên, miso 900 yên, shio 800 yên, gyoza 400 yên, thêm mì (oomori) 100 yên."
    textEn: "The machine's buttons: shoyu 800 yen, miso 900 yen, shio 800 yen, gyoza 400 yen, extra noodles (oomori) 100 yen."
    textRomaji: "Kenbaiki no botan: shouyu happyaku en, miso kyuuhyaku en, shio happyaku en, gyouza yonhyaku en, oomori hyaku en"
    textEnglishIpa: 
    animationCue: 
    voiceClip: {fileID: 0}
    choices: []
    flagCondition: 
    flagJumpNodeId: 
    targetItemId: 
    targetNpcId: 
    targetAreaId: 
  - id: n_flavor
    nodeType: 0
    nextNodeId: 
    objectiveIdToComplete: 
    speakerName: Tanaka
    speakerId: npc_neighbor_1
    textJa: "どのラーメンにしますか。私は、しょうゆです。"
    textReading: "どのラーメンにしますか。わたしは、しょうゆです。"
    textVi: "Bạn chọn ramen nào? Tôi chọn vị shoyu."
    textEn: "Which ramen will you have? I'll have shoyu."
    textRomaji: "Dono raamen ni shimasu ka. Watashi wa, shouyu desu."
    textEnglishIpa: 
    animationCue: talk
    voiceClip: {fileID: 0}
    choices:
    - textJa: "みそラーメンにします。"
      textVi: "Cháu chọn ramen miso ạ."
      textEn: "I'll have miso ramen."
      nextNodeId: n_pay_miso
      scoreModifiers:
      - category: Grammar
        value: 10
        reason: "Chọn món bằng mẫu 〜にします"
      grammarTags:
      - grammar.n5.ni_shimasu
      vocabularyTags:
      - vocab.n5.miso
      setFlags:
      - ramen.miso
    - textJa: "しょうゆラーメンにします。"
      textVi: "Cháu chọn ramen shoyu ạ."
      textEn: "I'll have shoyu ramen."
      nextNodeId: n_pay_shoyu
      scoreModifiers:
      - category: Grammar
        value: 10
        reason: "Chọn món bằng mẫu 〜にします"
      grammarTags:
      - grammar.n5.ni_shimasu
      vocabularyTags:
      - vocab.n5.shouyu
      setFlags:
      - ramen.shoyu
    - textJa: "しおラーメンにします。"
      textVi: "Cháu chọn ramen shio ạ."
      textEn: "I'll have shio ramen."
      nextNodeId: n_pay_shoyu
      scoreModifiers:
      - category: Grammar
        value: 10
        reason: "Chọn món bằng mẫu 〜にします"
      grammarTags:
      - grammar.n5.ni_shimasu
      vocabularyTags:
      - vocab.n5.shio
      setFlags:
      - ramen.shio
    - textJa: "ラーメンをいただきます。"
      textVi: "Cháu xin phép dùng ramen ạ."
      textEn: "I'll gladly have the ramen."
      nextNodeId: n_flavor_wrong
      scoreModifiers:
      - category: Grammar
        value: -8
        reason: "いただきます là lời nói trước khi ăn, không dùng để chọn món"
