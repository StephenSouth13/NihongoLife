    - textJa: "ラーメンをいただきます。"
      textEn: "Cháu xin phép dùng ramen ạ."
      nextNodeId: n_flavor_wrong
      scoreModifiers:
      - category: Grammar
        value: -8
        reason: "いただきます là lời nói trước khi ăn, không dùng để chọn món"
      grammarTags: []
      vocabularyTags: []
      setFlags: []
    flagCondition: 
