    nodeType: 0
    nextNodeId: n_flavor
    objectiveIdToComplete: 
    speakerName: Tanaka
    speakerId: npc_neighbor_1
    textJa: "まだ、食べませんよ。「〜にします」と言いましょう。どれにしますか。"
    textReading: "まだ、たべませんよ。「〜にします」といいましょう。どれにしますか。"
    textEn: "Chưa ăn đâu mà. Hãy nói \"~ ni shimasu\" (tôi chọn ~). Bạn chọn món nào?"
    textRomaji: "Mada, tabemasen yo. \"~ ni shimasu\" to iimashou. Dore ni shimasu ka?"
    textEnglishIpa: 
    animationCue: point
    voiceClip: {fileID: 0}
