  - id: n_pay_miso
    nodeType: 0
    nextNodeId: 
    objectiveIdToComplete: 
    speakerName: Tanaka
    speakerId: npc_neighbor_1
    textJa: "ぎょうざも食べますか。ぎょうざは四百円です。みそラーメンと、ぜんぶで、いくらですか。"
    textReading: "ぎょうざもたべますか。ぎょうざはよんひゃくえんです。みそラーメンと、ぜんぶで、いくらですか。"
    textEn: "Bạn có ăn cả gyoza không? Gyoza 400 yên. Cùng với ramen miso thì tổng cộng là bao nhiêu?"
    textRomaji: "Gyouza mo tabemasu ka. Gyouza wa yonhyaku en desu. Miso raamen to, zenbu de, ikura desu ka?"
    textEnglishIpa: 
    animationCue: talk
    voiceClip: {fileID: 0}
    choices:
    - textJa: "千三百円です。"
      textEn: "Là 1.300 yên ạ."
      nextNodeId: n_buy
      scoreModifiers:
      - category: Vocabulary
        value: 10
        reason: "Tính và đọc đúng tổng tiền: 九百円 + 四百円 = 千三百円"
      grammarTags:
      - grammar.n5.ikura_desu_ka
      vocabularyTags:
      - vocab.n5.sen
      - vocab.n5.hyaku
      - vocab.n5.en
      setFlags: []
    - textJa: "千二百円です。"
      textEn: "Là 1.200 yên ạ."
      nextNodeId: n_sum_wrong_miso
      scoreModifiers:
      - category: Vocabulary
        value: -8
        reason: "Tính sai tổng tiền: ramen miso 900 + gyoza 400 = 1.300, không phải 1.200"
      grammarTags: []
      vocabularyTags: []
      setFlags: []
    - textJa: "もう一度お願いします。"
      textEn: "Phiền bác nói lại một lần nữa ạ."
      nextNodeId: n_pay_miso
      scoreModifiers:
      - category: ResponseAccuracy
        value: 6
        reason: "Xin nghe lại lịch sự để tính chính xác"
      grammarTags: []
      vocabularyTags:
      - vocab.n5.mou_ichido
      setFlags: []
    flagCondition: 
    flagJumpNodeId: 
    targetItemId: 
    targetNpcId: 
    targetAreaId: 
