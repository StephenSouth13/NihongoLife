    nodeType: 0
    nextNodeId: 
    objectiveIdToComplete: 
    speakerName: Kimura
    speakerId: npc_station_staff
    textJa: "おわかりですか。ミナト駅までは、いくらですか。"
    textReading: "おわかりですか。ミナトえきまでは、いくらですか。"
    textEn: "Quý khách đã rõ chưa ạ? Đến ga Minato là bao nhiêu tiền?"
    textRomaji: "Owakari desu ka. Minato eki made wa, ikura desu ka?"
    textEnglishIpa: 
    animationCue: talk
    voiceClip: {fileID: 0}
    choices:
    - textJa: "三百二十円です。"
      textEn: "Là 320 yên ạ."
      nextNodeId: n_machine
      scoreModifiers:
      - category: Vocabulary
        value: 10
        reason: "Nhắc lại đúng giá vé: 三百二十円 (さんびゃくにじゅうえん)"
      grammarTags:
      - grammar.n5.ikura_desu_ka
      vocabularyTags:
