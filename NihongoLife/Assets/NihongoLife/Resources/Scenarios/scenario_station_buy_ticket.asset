    nodeType: 0
    nextNodeId: 
    objectiveIdToComplete: 
    speakerName: 
    speakerId: 
    textJa: "券売機の前に来ました。最初に、何をしますか。"
    textReading: "けんばいきのまえにきました。さいしょに、なにをしますか。"
    textEn: "Bạn đứng trước máy bán vé. Việc đầu tiên bạn làm là gì?"
    textRomaji: "Kenbaiki no mae ni kimashita. Saisho ni, nani wo shimasu ka?"
    textEnglishIpa: 
