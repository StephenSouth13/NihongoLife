  m_Script: {fileID: 11500000, guid: 3ba8f435ab5427145b206cd2a4f4ea7c, type: 3}
  m_Name: scenario_station_buy_ticket
  m_EditorClassIdentifier: NihongoLife::NihongoLife.Scenario.ScenarioDefinition
  id: scenario.station.buy_ticket
  version: 2
  titleJa: "駅で切符を買う"
  titleEn: "Mua vé và đi tàu ở ga Hibari"
  descriptionJa: "ひばり駅で切符を買って、ミナト駅まで行きましょう。駅員さんに聞いて、ホームでアナウンスを聞き取ります。"
  descriptionEn: "Mua vé tại ga Hibari để đến Minato: nói nơi muốn đến, đọc giá vé, dùng máy bán vé, hỏi đường ray, nghe thông báo và cư xử đúng trên tàu."
  chapterIndex: 4
  questType: main
  giverNpcId: npc_station_staff
  briefingVi: "Hỏi đường và mua vé tại ga Hibari với nhân viên Kimura."
  briefingEn: "Ask for directions and buy a ticket at Hibari Station from Kimura."
  briefingJa: "ひばり駅で木村さんに道を聞き、切符を買いましょう。"
  locationHintVi: "ひばり駅 (ga Hibari)"
  locationHintEn: "Hibari Station"
  locationHintJa: "ひばり駅"
  rewardYen: 300
  branchId: main
  requiredKnowledge: 80
  requiredScenarioIds:
  - scenario.restaurant.sushi_dining
  unlockScenarioIds:
  - scenario.town.summer_festival
  repeatable: 0
  supportsCoOp: 0
  minPlayers: 1
  maxPlayers: 2
  learningTargets:
  - grammar.n5.tai_desu
  - grammar.n5.nan_ban_sen
  - grammar.n5.mazu_sorekara
  - vocab.n5.densha
  - vocab.n5.kippu
  objectives:
  - id: obj_arrive
    titleJa: "駅に着く"
    titleEn: "Đến nhà ga"
    isOptional: 0
  - id: obj_ask
    titleJa: "駅員さんに行き先を伝える"
    titleEn: "Nói với nhân viên nhà ga nơi bạn muốn đến"
    isOptional: 0
  - id: obj_ticket
    titleJa: "券売機で切符を買う"
    titleEn: "Mua vé ở máy bán vé"
    isOptional: 0
  - id: obj_platform
    titleJa: "ホームを確認する"
    titleEn: "Xác nhận đúng đường ray"
    isOptional: 0
  - id: obj_board
    titleJa: "電車に乗ってミナト駅に着く"
    titleEn: "Lên tàu và đến ga Minato"
    isOptional: 0
  nodes:
  - id: n_arrive
    nodeType: 0
    nextNodeId: n_counter
    objectiveIdToComplete: obj_arrive
    speakerName: 
    speakerId: 
    textJa: "ひばり駅です。今日は、電車に乗って、ミナト駅まで海を見に行きます。"
    textReading: "ひばりえきです。きょうは、でんしゃにのって、ミナトえきまでうみをみにいきます。"
    textEn: "Ga Hibari. Hôm nay bạn sẽ đi tàu đến ga Minato để ngắm biển."
    textRomaji: "Hibari eki desu. Kyou wa, densha ni notte, Minato eki made umi wo mi ni ikimasu."
    textEnglishIpa: 
    animationCue: 
    voiceClip: {fileID: 0}
    choices: []
    flagCondition: 
    flagJumpNodeId: 
    targetItemId: 
    targetNpcId: 
    targetAreaId: 
  - id: n_counter
    nodeType: 0
    nextNodeId: 
    objectiveIdToComplete: 
    speakerName: Kimura
    speakerId: npc_station_staff
    textJa: "いらっしゃいませ。ご案内しましょうか。"
    textReading: "いらっしゃいませ。ごあんないしましょうか。"
    textEn: "Xin chào quý khách. Tôi hướng dẫn giúp quý khách nhé?"
    textRomaji: "Irasshaimase. Goannai shimashou ka."
    textEnglishIpa: 
    animationCue: talk
    voiceClip: {fileID: 0}
    choices:
    - textJa: "ミナト駅へ行きたいです。"
      textEn: "Tôi muốn đến ga Minato ạ."
      nextNodeId: n_fare
      scoreModifiers:
      - category: Grammar
        value: 10
        reason: "Nói mong muốn bằng 〜たいです và nơi đến bằng 〜へ"
      grammarTags:
      - grammar.n5.tai_desu
      - grammar.n5.e_ikimasu
      vocabularyTags:
      - vocab.n5.eki
      - vocab.n5.minato
      setFlags: []
    - textJa: "ミナト駅へ行きます。"
      textEn: "Tôi sẽ đi đến ga Minato."
      nextNodeId: n_counter_flat
      scoreModifiers:
      - category: ResponseAccuracy
        value: 3
        reason: "Nói được kế hoạch nhưng chưa nhờ giúp; muốn được hướng dẫn nên dùng 〜たいです"
      grammarTags:
      - grammar.n5.e_ikimasu
      vocabularyTags:
      - vocab.n5.eki
      setFlags: []
    - textJa: "ミナト駅、どこ？"
      textEn: "Ga Minato, ở đâu?"
      nextNodeId: n_counter_wrong
      scoreModifiers:
      - category: ResponseAccuracy
        value: -6
        reason: "Hỏi cộc lốc với nhân viên, thiếu ですか và không nêu rõ điều mình cần"
      grammarTags: []
      vocabularyTags: []
      setFlags: []
    flagCondition: 
    flagJumpNodeId: 
    targetItemId: 
    targetNpcId: 
    targetAreaId: 
  - id: n_counter_flat
    nodeType: 0
    nextNodeId: n_fare
    objectiveIdToComplete: 
    speakerName: Kimura
    speakerId: npc_station_staff
    textJa: "はい、ミナト駅ですね。切符が必要ですか。「行きたいです」と言うと、分かりやすいですよ。"
    textReading: "はい、ミナトえきですね。きっぷがひつようですか。「いきたいです」というと、わかりやすいですよ。"
    textEn: "Vâng, ga Minato nhỉ. Quý khách cần vé không ạ? Nói \"ikitai desu\" (tôi muốn đi) thì dễ hiểu hơn đấy ạ."
    textRomaji: "Hai, Minato eki desu ne. Kippu ga hitsuyou desu ka. \"Ikitai desu\" to iu to, wakariyasui desu yo."
    textEnglishIpa: 
    animationCue: talk
    voiceClip: {fileID: 0}
    choices: []
    flagCondition: 
    flagJumpNodeId: 
    targetItemId: 
    targetNpcId: 
    targetAreaId: 
  - id: n_counter_wrong
    nodeType: 0
    nextNodeId: n_counter
    objectiveIdToComplete: 
    speakerName: Kimura
    speakerId: npc_station_staff
    textJa: "失礼ですが、「ミナト駅へ行きたいです」と、お話しください。"
    textReading: "しつれいですが、「ミナトえきへいきたいです」と、おはなしください。"
    textEn: "Xin thất lễ, xin quý khách hãy nói \"Minato eki e ikitai desu\" (tôi muốn đến ga Minato) ạ."
    textRomaji: "Shitsurei desu ga, \"Minato eki e ikitai desu\" to, ohanashi kudasai."
    textEnglishIpa: 
    animationCue: point
    voiceClip: {fileID: 0}
    choices: []
    flagCondition: 
    flagJumpNodeId: 
    targetItemId: 
    targetNpcId: 
    targetAreaId: 
  - id: n_fare
    nodeType: 0
    nextNodeId: n_fare_check
    objectiveIdToComplete: obj_ask
    speakerName: Kimura
    speakerId: npc_station_staff
    textJa: "ミナト駅までは、三百二十円です。二十分ぐらいです。"
    textReading: "ミナトえきまでは、さんびゃくにじゅうえんです。にじゅっぷんぐらいです。"
    textEn: "Đến ga Minato giá 320 yên. Mất khoảng 20 phút."
    textRomaji: "Minato eki made wa, sanbyaku nijuu en desu. Nijuppun gurai desu."
    textEnglishIpa: 
    animationCue: talk
    voiceClip: {fileID: 0}
    choices: []
    flagCondition: 
    flagJumpNodeId: 
    targetItemId: 
    targetNpcId: 
    targetAreaId: 
