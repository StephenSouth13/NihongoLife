      setFlags: []
    - textJa: "いいえ、大丈夫です。"
      textVi: "Không, tôi ổn rồi ạ."
      textEn: "No, I'm fine."
      nextNodeId: n_bag_no
      scoreModifiers:
      - category: Vocabulary
        value: 10
        reason: "Hiểu từ túi (fukuro) và từ chối lịch sự bằng 大丈夫です"
      grammarTags:
