  - id: node_confirm_item
    nodeType: 0
    nextNodeId:
    objectiveIdToComplete:
    speakerName: Hệ thống
    speakerId: system
    textJa: 今日買うものはどれですか？
    textReading: きょうかうものはどれですか？
    textEn: Hôm nay bạn cần mua món nào?
    textRomaji: Kyou kau mono wa dore desu ka?
    textEnglishIpa:
    animationCue:
    voiceClip: {fileID: 0}
    choices:
    - textJa: おにぎりをください。
      textEn: Tôi muốn cơm nắm.
      nextNodeId: node_confirm_item_done
      scoreModifiers:
      - category: Vocabulary
        value: 10
        reason: Chọn đúng từ onigiri
      - category: Grammar
        value: 10
        reason: Dùng mẫu をください
      grammarTags: []
      vocabularyTags: []
    - textJa: お茶をください。
      textEn: Tôi muốn trà xanh.
      nextNodeId: node_confirm_item_hint
      scoreModifiers:
      - category: Vocabulary
        value: -5
        reason: Nhầm món cần mua
      grammarTags: []
      vocabularyTags: []
    - textJa: 水をください。
      textEn: Tôi muốn nước.
      nextNodeId: node_confirm_item_hint
      scoreModifiers:
      - category: ResponseAccuracy
        value: -5
        reason: Cần đọc lại yêu cầu nhiệm vụ
      grammarTags: []
      vocabularyTags: []
    targetItemId:
    targetNpcId:
    targetAreaId:
