    voiceClip: {fileID: 0}
    choices:
    - textJa: "はい、お願いします。"
      textVi: "Vâng, xin cho tôi ạ."
      textEn: "Yes, please."
      nextNodeId: n_bag_yes
      scoreModifiers:
