  - id: n_task
    nodeType: 0
    nextNodeId: node_check_drink
    objectiveIdToComplete: 
    speakerName: 
    speakerId: 
    textJa: "今日は、おにぎりと飲み物を買いに来ました。お店の中を見てみましょう。"
    textReading: "きょうは、おにぎりとのみものをかいにきました。おみせのなかをみてみましょう。"
    textEn: "Hôm nay bạn đến mua cơm nắm và đồ uống. Hãy xem xung quanh cửa hàng."
    textRomaji: "Kyou wa, onigiri to nomimono wo kai ni kimashita. Omise no naka wo mite mimashou."
    textEnglishIpa: 
    animationCue: 
    voiceClip: {fileID: 0}
    choices: []
    flagCondition: 
    flagJumpNodeId: 
    targetItemId: 
