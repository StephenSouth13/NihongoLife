    nextNodeId: node_confirm_item
    objectiveIdToComplete:
    speakerName: Hệ thống
    speakerId: system
    textJa: 今日はおにぎりを買います。
    textReading: きょうはおにぎりをかいます。
    textEn: Hôm nay nhiệm vụ là mua cơm nắm. Hãy chọn onigiri.
    textRomaji: Kyou wa onigiri wo kaimasu.
