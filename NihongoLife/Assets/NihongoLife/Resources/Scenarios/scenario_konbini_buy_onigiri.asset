    titleEn: "Vào cửa hàng tiện lợi"
    isOptional: 0
  - id: obj_check_drink
    titleJa: "飲み物のたなを確認する"
    titleEn: "Kiểm tra kệ đồ uống"
    isOptional: 0
  - id: obj_confirm_item
    titleJa: "買うものを選ぶ"
    titleEn: "Chọn đúng món cần mua"
    isOptional: 0
  - id: obj_find_onigiri
    titleJa: "おにぎりを見つける"
    titleEn: "Tìm và lấy cơm nắm"
    isOptional: 0
  - id: obj_go_to_cashier
    titleJa: "レジへ行く"
    titleEn: "Đi đến quầy thu ngân"
    isOptional: 0
  - id: obj_pay
    titleJa: "お金を払う"
    titleEn: "Thanh toán"
    isOptional: 0
