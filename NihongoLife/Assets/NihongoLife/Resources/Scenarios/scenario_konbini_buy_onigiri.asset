    titleEn: Kiểm tra kệ đồ uống
    isOptional: 0
  - id: obj_confirm_item
    titleJa: 買うものを選ぶ
    titleEn: Chọn đúng món cần mua
    isOptional: 0
  - id: obj_find_onigiri
    titleJa: おにぎりを見つける
    titleEn: Tìm cơm nắm
    isOptional: 0
  - id: obj_go_to_cashier
    titleJa: レジへ行く
    titleEn: Đi đến quầy thu ngân
    isOptional: 0
  - id: obj_pay
    titleJa: お会計をする
    titleEn: Thanh toán
    isOptional: 0
