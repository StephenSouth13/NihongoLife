  m_EditorClassIdentifier: NihongoLife::NihongoLife.Scenario.ScenarioDefinition
  id: scenario.konbini.buy_onigiri
  version: 2
  titleJa: "コンビニでおにぎりを買う"
  titleVi: "Mua cơm nắm ở cửa hàng tiện lợi"
  titleEn: "Buy a rice ball at the convenience store"
  descriptionJa: "ひばりコンビニで、おにぎりと飲み物を見て、お会計をしましょう。"
  descriptionVi: "Vào cửa hàng Hibari, tìm đúng món trên kệ, mua cơm nắm và thanh toán bằng tiếng Nhật."
  descriptionEn: "Go into Hibari Mart, find the right item on the shelf, buy a rice ball and pay in Japanese."
  chapterIndex: 2
  questType: main
  giverNpcId: npc_cashier
  briefingVi: "Bạn đói rồi. Vào ひばりコンビニ, tìm onigiri và nước uống, rồi thanh toán bằng tiếng Nhật."
  briefingEn: "You are hungry. Go into Hibari Konbini, find an onigiri and a drink, and pay in Japanese."
  briefingJa: "お腹がすきました。ひばりコンビニでおにぎりと飲み物を探し、日本語でお会計をしましょう。"
  locationHintVi: "ひばりコンビニ (Sakura-dōri)"
  locationHintEn: "Hibari Konbini (Sakura-dori)"
  locationHintJa: "ひばりコンビニ（さくら通り）"
  rewardYen: 400
  branchId: main
  requiredKnowledge: 0
  requiredScenarioIds:
  - scenario.school.self_intro
  unlockScenarioIds:
  - scenario.house2.lostcat
  - scenario.house3.garbage
  - scenario.konbini.evening_shift
  repeatable: 0
  supportsCoOp: 0
  minPlayers: 1
  maxPlayers: 2
  learningTargets:
  - grammar.n5.wo_kudasai
  - grammar.n5.wo_onegaishimasu
  - grammar.n5.de_onegaishimasu
  - vocab.n5.onigiri
  - vocab.n5.fukuro
  objectives:
  - id: obj_enter_store
    titleJa: "コンビニに入る"
    titleVi: "Vào cửa hàng tiện lợi"
    titleEn: "Enter the convenience store"
    isOptional: 0
  - id: obj_check_drink
    titleJa: "飲み物のたなを確認する"
    titleVi: "Kiểm tra kệ đồ uống"
    titleEn: "Check the drinks shelf"
    isOptional: 0
  - id: obj_confirm_item
    titleJa: "買うものを選ぶ"
    titleVi: "Chọn đúng món cần mua"
    titleEn: "Choose the right item to buy"
    isOptional: 0
  - id: obj_find_onigiri
    titleJa: "おにぎりを見つける"
    titleVi: "Tìm và lấy cơm nắm"
    titleEn: "Find and pick up a rice ball"
    isOptional: 0
  - id: obj_go_to_cashier
    titleJa: "レジへ行く"
    titleVi: "Đi đến quầy thu ngân"
    titleEn: "Go to the register"
    isOptional: 0
  - id: obj_pay
    titleJa: "お金を払う"
    titleVi: "Thanh toán"
    titleEn: "Pay"
    isOptional: 0
