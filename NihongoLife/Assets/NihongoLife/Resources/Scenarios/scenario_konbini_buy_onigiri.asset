    nextNodeId: node_find_onigiri
    objectiveIdToComplete: obj_confirm_item
    speakerName: Hệ thống
    speakerId: system
    textJa: はい、おにぎりですね。
    textReading: はい、おにぎりですね。
    textEn: Đúng rồi, hãy lấy onigiri trên kệ hàng.
    textRomaji: Hai, onigiri desu ne.
    textEnglishIpa:
    animationCue:
    voiceClip: {fileID: 0}
    choices: []
