  - id: n_home_tadaima
    nodeType: 0
    nextNodeId: n_end
    objectiveIdToComplete: 
    speakerName: 
    speakerId: 
    textJa: "だれもいません。でも、小さな声で言うと、少し、ほっとしました。"
    textReading: "だれもいません。でも、ちいさなこえでいうと、すこし、ほっとしました。"
    textEn: "Không có ai cả. Nhưng nói bằng giọng nhỏ, bạn thấy yên lòng hơn một chút."
    textRomaji: "Dare mo imasen. Demo, chiisana koe de iu to, sukoshi, hotto shimashita."
    textEnglishIpa: 
    animationCue: 
    voiceClip: {fileID: 0}
    choices: []
