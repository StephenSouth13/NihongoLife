  - id: n_home_silent
    nodeType: 0
    nextNodeId: n_end
    objectiveIdToComplete: 
    speakerName: 
    speakerId: 
    textJa: "部屋は静かです。でも、明日から、この町がにぎやかになります。"
    textReading: "へやはしずかです。でも、あしたから、このまちがにぎやかになります。"
    textEn: "Căn phòng yên tĩnh. Nhưng từ ngày mai, thị trấn này sẽ trở nên náo nhiệt."
    textRomaji: "Heya wa shizuka desu. Demo, ashita kara, kono machi ga nigiyaka ni narimasu."
    textEnglishIpa: 
    animationCue: 
    voiceClip: {fileID: 0}
    choices: []
    flagCondition: 
    flagJumpNodeId: 
    targetItemId: 
    targetNpcId: 
