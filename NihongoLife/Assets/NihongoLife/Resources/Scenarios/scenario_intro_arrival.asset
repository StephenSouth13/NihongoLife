    nodeType: 0
    nextNodeId: n_complete
    objectiveIdToComplete: obj_home
    speakerName: 
    speakerId: 
    textJa: "おやすみなさい。明日から、ひばり町の生活が始まります。"
    textReading: "おやすみなさい。あしたから、ひばりちょうのせいかつがはじまります。"
    textEn: "Chúc ngủ ngon. Từ ngày mai, cuộc sống ở Hibari-chō bắt đầu."
    textRomaji: "Oyasuminasai. Ashita kara, Hibari-chou no seikatsu ga hajimarimasu."
