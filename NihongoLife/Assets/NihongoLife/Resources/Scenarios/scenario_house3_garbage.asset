  id: scenario.house3.garbage
  version: 2
  titleJa: "ゴミの出し方"
  titleEn: "Quy tắc đổ rác của khu phố"
  descriptionJa: "町内会長の佐藤さんに、ゴミの日と出し方を聞きましょう。"
  descriptionEn: "Hỏi trưởng khu phố Sato về ngày đổ rác, giờ giấc và điểm tập kết; học cách hỏi và hiểu điều cấm."
  chapterIndex: 3
  questType: community
  giverNpcId: npc_neighbor_3
  briefingVi: "Sato, trưởng khu phố, giải thích quy tắc đổ rác. Hỏi đúng cách để không làm phiền hàng xóm."
  briefingEn: "Sato, the neighbourhood head, explains the garbage rules. Ask the right way so you do not bother your neighbours."
  briefingJa: "町内会長の佐藤さんがゴミの出し方を説明してくれます。近所に迷惑をかけないよう、正しく聞きましょう。"
  locationHintVi: "Nhà Sato (trưởng khu phố)"
  locationHintEn: "Sato's house (neighbourhood head)"
  locationHintJa: "佐藤さんの家（町内会長）"
  rewardYen: 200
  branchId: community
  requiredKnowledge: 40
  requiredScenarioIds:
  - scenario.konbini.buy_onigiri
  unlockScenarioIds:
  - scenario.neighborhood.recycling_morning
  repeatable: 0
  supportsCoOp: 0
  minPlayers: 1
  maxPlayers: 2
  learningTargets:
  - grammar.n5.wa_itsu_desu_ka
  - grammar.n5.nai_de_kudasai
  - grammar.n5.made
  - vocab.n5.moeru_gomi
  - vocab.n5.kinyoubi
  objectives:
  - id: obj_meet
    titleJa: "佐藤さんに会う"
    titleEn: "Gặp trưởng khu phố Sato"
    isOptional: 0
  - id: obj_rules
    titleJa: "ゴミの日を聞いて覚える"
    titleEn: "Hỏi và ghi nhớ ngày đổ rác"
    isOptional: 0
  - id: obj_promise
    titleJa: "月曜日の朝に会う約束をする"
    titleEn: "Hẹn gặp vào sáng thứ Hai"
    isOptional: 0
