    nodeType: 0
    nextNodeId: 
    objectiveIdToComplete: obj_rules
    speakerName: Sato
    speakerId: npc_neighbor_3
    textJa: "では、ペットボトルは、何曜日ですか。"
    textReading: "では、ペットボトルは、なんようびですか。"
    textEn: "Vậy chai nhựa thì đổ vào thứ mấy?"
    textRomaji: "Dewa, pettobotoru wa, nan youbi desu ka?"
    textEnglishIpa: 
    animationCue: talk
    voiceClip: {fileID: 0}
    choices:
    - textJa: "金曜日です。"
      textEn: "Là thứ Sáu ạ."
      nextNodeId: n_q_time
