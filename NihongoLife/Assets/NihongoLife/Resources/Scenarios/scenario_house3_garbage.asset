    objectiveIdToComplete: 
    speakerName: Sato
    speakerId: npc_neighbor_3
    textJa: "場所ではなくて、日です。「いつ」ですよ。もう一度。"
    textReading: "ばしょではなくて、ひです。「いつ」ですよ。もういちど。"
    textEn: "Không phải hỏi nơi chốn mà là hỏi ngày. Dùng \"itsu\" nhé. Bạn hỏi lại đi."
    textRomaji: "Basho dewa nakute, hi desu. \"Itsu\" desu yo. Mou ichido."
    textEnglishIpa: 
    animationCue: point
