    nodeType: 0
    nextNodeId: n_q_time_ok
    objectiveIdToComplete: 
    speakerName: Sato
    speakerId: npc_neighbor_3
    textJa: "「から」ではありません。「まで」です。八時までに、出してください。"
    textReading: "「から」ではありません。「まで」です。はちじまでに、だしてください。"
    textEn: "Không phải \"kara\" mà là \"made\". Hãy đem ra trước tám giờ."
    textRomaji: "\"Kara\" dewa arimasen. \"Made\" desu. Hachiji made ni, dashite kudasai."
    textEnglishIpa: 
    animationCue: point
    voiceClip: {fileID: 0}
    choices: []
