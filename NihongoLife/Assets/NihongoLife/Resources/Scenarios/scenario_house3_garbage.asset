    nodeType: 0
    nextNodeId: n_q_when
    objectiveIdToComplete: 
    speakerName: Sato
    speakerId: npc_neighbor_3
    textJa: "「燃えるゴミは、いつですか」と聞きましょう。種類も言ってくださいね。"
    textReading: "「もえるゴミは、いつですか」とききましょう。しゅるいもいってくださいね。"
    textEn: "Hãy hỏi là \"moeru gomi wa, itsu desu ka\". Nhớ nói rõ cả loại rác nữa nhé."
    textRomaji: "\"Moeru gomi wa, itsu desu ka\" to kikimashou. Shurui mo itte kudasai ne."
    textEnglishIpa: 
    animationCue: talk
    voiceClip: {fileID: 0}
