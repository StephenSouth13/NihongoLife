  - id: n_q_time
    nodeType: 0
    nextNodeId: 
    objectiveIdToComplete: 
    speakerName: Sato
    speakerId: npc_neighbor_3
    textJa: "ゴミは、朝八時までに出してください。"
    textReading: "ゴミは、あさはちじまでにだしてください。"
    textEn: "Rác thì hãy đem ra trước tám giờ sáng."
    textRomaji: "Gomi wa, asa hachiji made ni dashite kudasai."
    textEnglishIpa: 
    animationCue: talk
    voiceClip: {fileID: 0}
    choices:
    - textJa: "朝八時までですね。分かりました。"
      textEn: "Trước tám giờ sáng nhỉ. Cháu hiểu rồi ạ."
      nextNodeId: n_place
      scoreModifiers:
      - category: Vocabulary
        value: 10
        reason: "Xác nhận thời hạn bằng 〜までですね"
      grammarTags:
      - grammar.n5.made
      vocabularyTags:
      - vocab.n5.made
      - vocab.n5.hachiji
      setFlags: []
    - textJa: "夜に出してもいいですか。"
      textEn: "Cháu đem ra vào ban đêm có được không ạ?"
      nextNodeId: n_night_no
      scoreModifiers:
      - category: Grammar
        value: 4
        reason: "Hỏi xin phép đúng mẫu 〜てもいいですか; đây là câu hỏi hợp lý dù câu trả lời sẽ là không"
      grammarTags:
      - grammar.n5.te_mo_ii_desu_ka
      vocabularyTags:
      - vocab.n5.yoru
      setFlags:
      - sato.asked_night
    - textJa: "夜に出します。大丈夫です。"
      textEn: "Cháu sẽ đem ra ban đêm. Không sao đâu ạ."
      nextNodeId: n_night_stern
      scoreModifiers:
      - category: ResponseAccuracy
        value: -10
        reason: "Tự quyết định phá quy tắc thay vì hỏi ý kiến người phụ trách"
      grammarTags: []
      vocabularyTags: []
      setFlags:
