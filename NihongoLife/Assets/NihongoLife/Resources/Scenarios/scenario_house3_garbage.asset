  - id: n_tanaka_praise
    nodeType: 0
    nextNodeId: n_open
    objectiveIdToComplete: 
    speakerName: Sato
    speakerId: npc_neighbor_3
    textJa: "田中さんから聞きましたよ。礼儀正しい学生さんが来た、と。"
    textReading: "たなかさんからききましたよ。れいぎただしいがくせいさんがきた、と。"
    textEn: "Tôi nghe bác Tanaka kể rồi. Bác nói có một học viên rất lễ phép mới đến."
    textRomaji: "Tanaka-san kara kikimashita yo. Reigi tadashii gakusei-san ga kita, to."
    textEnglishIpa: 
    animationCue: talk
    voiceClip: {fileID: 0}
    choices: []
    flagCondition: 
    flagJumpNodeId: 
    targetItemId: 
    targetNpcId: 
    targetAreaId: 
  - id: n_open
    nodeType: 0
    nextNodeId: 
    objectiveIdToComplete: 
    speakerName: Sato
    speakerId: npc_neighbor_3
    textJa: "あなたが、新しい学生さんですね。町のゴミのルールを、説明します。"
    textReading: "あなたが、あたらしいがくせいさんですね。まちのゴミのルールを、せつめいします。"
    textEn: "Bạn là học viên mới nhỉ. Tôi sẽ giải thích quy tắc đổ rác của khu phố."
    textRomaji: "Anata ga, atarashii gakusei-san desu ne. Machi no gomi no ruuru wo, setsumei shimasu."
    textEnglishIpa: 
    animationCue: talk
    voiceClip: {fileID: 0}
    choices:
    - textJa: "はい、よろしくお願いします。"
      textEn: "Vâng, xin nhờ bác chỉ bảo ạ."
      nextNodeId: n_q_when
      scoreModifiers:
      - category: Vocabulary
        value: 10
        reason: "Mở đầu lịch sự với người phụ trách khu phố bằng よろしくお願いします"
      grammarTags: []
      vocabularyTags:
      - vocab.n5.yoroshiku
      setFlags: []
    - textJa: "はい。"
      textEn: "Vâng."
      nextNodeId: n_q_when
      scoreModifiers:
      - category: ResponseAccuracy
        value: 3
        reason: "Đáp được nhưng hơi cộc với một người lớn tuổi có vai trò quan trọng"
      grammarTags: []
      vocabularyTags: []
      setFlags: []
    - textJa: "ルールは嫌いです。"
      textEn: "Cháu không thích quy tắc."
      nextNodeId: n_open_wrong
      scoreModifiers:
      - category: ResponseAccuracy
        value: -8
        reason: "Nói thẳng điều tiêu cực ngay lúc đầu, gây ấn tượng xấu với trưởng khu phố"
      grammarTags: []
      vocabularyTags: []
      setFlags: []
    flagCondition: 
    flagJumpNodeId: 
    targetItemId: 
    targetNpcId: 
    targetAreaId: 
  - id: n_open_wrong
    nodeType: 0
    nextNodeId: n_open
    objectiveIdToComplete: 
    speakerName: Sato
    speakerId: npc_neighbor_3
    textJa: "…そうですか。でも、ルールは、みんなのためです。もう一度、聞いてください。"
    textReading: "…そうですか。でも、ルールは、みんなのためです。もういちど、きいてください。"
    textEn: "...Vậy à. Nhưng quy tắc là vì mọi người. Mời bạn nghe lại cho."
    textRomaji: "...Sou desu ka. Demo, ruuru wa, minna no tame desu. Mou ichido, kiite kudasai."
    textEnglishIpa: 
    animationCue: talk
    voiceClip: {fileID: 0}
    choices: []
    flagCondition: 
    flagJumpNodeId: 
    targetItemId: 
    targetNpcId: 
    targetAreaId: 
  - id: n_q_when
    nodeType: 0
    nextNodeId: 
    objectiveIdToComplete: 
    speakerName: Sato
    speakerId: npc_neighbor_3
    textJa: "ゴミについて、質問がありますか。"
    textReading: "ゴミについて、しつもんがありますか。"
    textEn: "Bạn có câu hỏi nào về việc đổ rác không?"
    textRomaji: "Gomi ni tsuite, shitsumon ga arimasu ka?"
    textEnglishIpa: 
    animationCue: talk
    voiceClip: {fileID: 0}
    choices:
    - textJa: "燃えるゴミは、いつですか。"
      textEn: "Rác cháy được thì đổ khi nào ạ?"
      nextNodeId: n_when_answer
      scoreModifiers:
      - category: Grammar
        value: 10
        reason: "Hỏi lịch bằng mẫu 〜はいつですか (khi nào)"
      grammarTags:
      - grammar.n5.wa_itsu_desu_ka
      vocabularyTags:
      - vocab.n5.moeru_gomi
      - vocab.n5.itsu
      setFlags: []
    - textJa: "ゴミ、いつ？"
      textEn: "Rác, khi nào?"
      nextNodeId: n_when_casual
      scoreModifiers:
      - category: ResponseAccuracy
        value: 2
        reason: "Hiểu được nhưng quá cộc lốc với trưởng khu phố, và chưa nói rõ loại rác"
      grammarTags:
      - grammar.n5.wa_itsu_desu_ka
      vocabularyTags:
      - vocab.n5.gomi
      setFlags: []
    - textJa: "ゴミはどこですか。"
      textEn: "Rác ở đâu ạ?"
      nextNodeId: n_when_wrong
      scoreModifiers:
      - category: Grammar
        value: -8
        reason: "Dùng どこ (ở đâu) trong khi muốn hỏi ngày; ngày phải dùng いつ"
      grammarTags: []
      vocabularyTags: []
      setFlags: []
