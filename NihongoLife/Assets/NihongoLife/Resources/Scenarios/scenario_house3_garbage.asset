  - id: n_when_answer
    nodeType: 0
    nextNodeId: n_check_day
    objectiveIdToComplete: 
    speakerName: Sato
    speakerId: npc_neighbor_3
    textJa: "燃えるゴミは、月曜日と木曜日です。ペットボトルは、金曜日です。"
    textReading: "もえるゴミは、げつようびともくようびです。ペットボトルは、きんようびです。"
    textEn: "Rác cháy được là thứ Hai và thứ Năm. Chai nhựa là thứ Sáu."
    textRomaji: "Moeru gomi wa, getsuyoubi to mokuyoubi desu. Pettobotoru wa, kinyoubi desu."
    textEnglishIpa: 
    animationCue: talk
    voiceClip: {fileID: 0}
    choices: []
    flagCondition: 
    flagJumpNodeId: 
    targetItemId: 
    targetNpcId: 
    targetAreaId: 
