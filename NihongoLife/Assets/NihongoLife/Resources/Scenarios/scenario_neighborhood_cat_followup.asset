    titleJa: "鈴木さんに会う"
    titleVi: "Gặp lại cô Suzuki"
    titleEn: "Meet Ms. Suzuki again"
    isOptional: 0
  - id: obj_report_cat_clue
    titleJa: "手がかりを伝える"
    titleVi: "Báo manh mối cho Suzuki"
    titleEn: "Tell Ms. Suzuki the clue"
    isOptional: 0
