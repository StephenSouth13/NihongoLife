      textEn: "Nói chuyện với cô Suzuki."
      nextNodeId: b_s1
      scoreModifiers: []
      grammarTags: []
      vocabularyTags: []
      setFlags: []
    - textJa: "山田さんの屋台へ行きます。"
      textEn: "Đến quầy hàng của chú Yamada."
      nextNodeId: b_y
      scoreModifiers: []
      grammarTags: []
      vocabularyTags: []
