    nextNodeId: t_ask
    objectiveIdToComplete: 
    speakerName: Tanaka
    speakerId: npc_neighbor_1
    textJa: "この町の人は、みんな、あなたを知っていますよ。"
    textReading: "このまちのひとは、みんな、あなたをしっていますよ。"
    textEn: "Mọi người trong khu phố này ai cũng biết bạn rồi đấy."
    textRomaji: "Kono machi no hito wa, minna, anata wo shitte imasu yo."
    textEnglishIpa: 
    animationCue: talk
    voiceClip: {fileID: 0}
    choices: []
    flagCondition: 
