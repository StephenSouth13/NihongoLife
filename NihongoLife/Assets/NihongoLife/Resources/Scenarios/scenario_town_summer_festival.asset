  m_Script: {fileID: 11500000, guid: 3ba8f435ab5427145b206cd2a4f4ea7c, type: 3}
  m_Name: scenario_town_summer_festival
  m_EditorClassIdentifier: NihongoLife::NihongoLife.Scenario.ScenarioDefinition
  id: scenario.town.summer_festival
  version: 2
  titleJa: "ひばり町の夏祭り"
  titleVi: "Lễ hội mùa hè ở Hibari-chō"
  titleEn: "Summer festival in Hibari-chō"
  descriptionJa: "夏祭りの夜。町の人たちと話して、みんなの前であいさつしましょう。"
  descriptionVi: "Đêm lễ hội mùa hè. Gặp lại những người bạn bạn đã giúp đỡ, thử ramen của chú Yamada và phát biểu trước cả khu phố; mọi điều bạn từng làm đều được mọi người nhớ."
  descriptionEn: "The night of the summer festival. Meet the friends you helped, try Mr. Yamada's ramen and give a speech to the whole neighbourhood; everyone remembers what you have done."
  chapterIndex: 4
  questType: main
  giverNpcId: npc_neighbor_3
  briefingVi: "Lễ hội mùa hè của khu phố. Những người bạn bạn đã giúp đỡ đều có mặt để cảm ơn bạn."
  briefingEn: "The neighbourhood summer festival. The people you helped are all there to thank you."
  briefingJa: "町の夏祭り。これまで助けた人たちが、あなたにお礼を言いに集まります。"
  locationHintVi: "ひばり神社 (đền Hibari)"
  locationHintEn: "Hibari Shrine"
  locationHintJa: "ひばり神社"
  rewardYen: 1000
  branchId: main
  requiredKnowledge: 150
  requiredScenarioIds:
  - scenario.station.buy_ticket
  - scenario.neighborhood.cat_followup
  - scenario.neighborhood.recycling_morning
  - scenario.restaurant.order_ramen
  unlockScenarioIds: []
  repeatable: 0
  supportsCoOp: 1
  minPlayers: 2
  maxPlayers: 2
  learningTargets:
  - grammar.n5.mashou
  - grammar.n5.wo_kudasai
  - vocab.n5.yokatta
  - vocab.n5.oishii
  - vocab.n5.arigatou_gozaimasu
  objectives:
  - id: obj_arrive
    titleJa: "夏祭りに着く"
    titleVi: "Đến lễ hội mùa hè"
    titleEn: "Get to the summer festival"
    isOptional: 0
  - id: obj_tanaka
    titleJa: "田中さんと話す"
    titleVi: "Trò chuyện với bác Tanaka"
    titleEn: "Talk with Mr. Tanaka"
    isOptional: 0
  - id: obj_suzuki
    titleJa: "鈴木さんと話す"
    titleVi: "Trò chuyện với cô Suzuki"
    titleEn: "Talk with Ms. Suzuki"
    isOptional: 0
  - id: obj_yamada
    titleJa: "山田さんのラーメンを食べる"
    titleVi: "Ăn ramen của chú Yamada"
    titleEn: "Eat Mr. Yamada's ramen"
    isOptional: 0
  - id: obj_school
    titleJa: "森田先生とキムさんに会う"
    titleVi: "Gặp cô Morita và bạn Kim"
    titleEn: "Meet Ms. Morita and Kim"
    isOptional: 0
  - id: obj_speech
    titleJa: "みんなの前であいさつする"
    titleVi: "Phát biểu trước mọi người"
    titleEn: "Give a speech to everyone"
    isOptional: 0
  nodes:
  - id: n_arrive
    nodeType: 0
    nextNodeId: n_sato_open
    objectiveIdToComplete: obj_arrive
    speakerName: 
    speakerId: 
    textJa: "夏祭りの夜。ひばり神社は、ちょうちんの光でいっぱいです。"
    textReading: "なつまつりのよる。ひばりじんじゃは、ちょうちんのひかりでいっぱいです。"
    textVi: "Đêm lễ hội mùa hè. Đền Hibari ngập tràn ánh sáng của những chiếc đèn lồng."
    textEn: "The night of the summer festival. Hibari Shrine is full of the light of paper lanterns."
    textRomaji: "Natsu matsuri no yoru. Hibari jinja wa, chouchin no hikari de ippai desu."
    textEnglishIpa: 
    animationCue: 
    voiceClip: {fileID: 0}
    choices: []
    flagCondition: 
    flagJumpNodeId: 
    targetItemId: 
    targetNpcId: 
    targetAreaId: 
  - id: n_sato_open
    nodeType: 0
    nextNodeId: n_hub
    objectiveIdToComplete: 
    speakerName: Sato
    speakerId: npc_neighbor_3
    textJa: "皆さん、こんばんは。今年も、夏祭りが始まります。今日は、新しい仲間もいますよ。"
    textReading: "みなさん、こんばんは。ことしも、なつまつりがはじまります。きょうは、あたらしいなかまもいますよ。"
    textVi: "Chào mọi người. Năm nay lễ hội mùa hè lại bắt đầu. Hôm nay cũng có một người bạn mới nữa đấy."
    textEn: "Hello, everyone. The summer festival begins again this year. And today we have a new friend with us."
    textRomaji: "Minasan, konbanwa. Kotoshi mo, natsu matsuri ga hajimarimasu. Kyou wa, atarashii nakama mo imasu yo."
    textEnglishIpa: 
    animationCue: talk
    voiceClip: {fileID: 0}
    choices: []
    flagCondition: 
    flagJumpNodeId: 
    targetItemId: 
    targetNpcId: 
    targetAreaId: 
  - id: n_hub
    nodeType: 0
    nextNodeId: 
    objectiveIdToComplete: 
    speakerName: 
    speakerId: 
    textJa: "お祭りには、知っている人がたくさんいます。だれと話しますか。"
    textReading: "おまつりには、しっているひとがたくさんいます。だれとはなしますか。"
    textVi: "Ở lễ hội có rất nhiều người bạn quen. Bạn muốn nói chuyện với ai?"
    textEn: "There are lots of familiar faces at the festival. Who do you want to talk to?"
    textRomaji: "Omatsuri ni wa, shitte iru hito ga takusan imasu. Dare to hanashimasu ka?"
    textEnglishIpa: 
    animationCue: 
    voiceClip: {fileID: 0}
    choices:
    - textJa: "田中さんと話します。"
      textVi: "Nói chuyện với bác Tanaka."
      textEn: "Talk to Mr. Tanaka."
      nextNodeId: t_start
      scoreModifiers: []
      grammarTags: []
      vocabularyTags: []
      setFlags: []
    - textJa: "鈴木さんと話します。"
      textVi: "Nói chuyện với cô Suzuki."
      textEn: "Talk to Ms. Suzuki."
      nextNodeId: b_s1
      scoreModifiers: []
      grammarTags: []
      vocabularyTags: []
      setFlags: []
    - textJa: "山田さんの屋台へ行きます。"
      textVi: "Đến quầy hàng của chú Yamada."
      textEn: "Go to Mr. Yamada's stall."
      nextNodeId: b_y
      scoreModifiers: []
      grammarTags: []
      vocabularyTags: []
      setFlags: []
    - textJa: "森田先生とキムさんに会います。"
