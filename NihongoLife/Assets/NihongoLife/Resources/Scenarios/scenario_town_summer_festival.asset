  - id: t_start
    nodeType: 0
    nextNodeId: 
    objectiveIdToComplete: 
    speakerName: Tanaka
    speakerId: npc_neighbor_1
    textJa: "やあ、来ましたね。今日は、ゆかたを着ましたよ。"
    textReading: "やあ、きましたね。きょうは、ゆかたをきましたよ。"
    textVi: "Chào, bạn đến rồi nhỉ. Hôm nay tôi mặc yukata đấy."
    textEn: "Hello, you made it. I'm wearing a yukata today."
    textRomaji: "Yaa, kimashita ne. Kyou wa, yukata wo kimashita yo."
    textEnglishIpa: 
    animationCue: talk
    voiceClip: {fileID: 0}
    choices:
    - textJa: "ゆかた、似合いますね。"
      textVi: "Bác mặc yukata hợp quá ạ."
      textEn: "The yukata really suits you."
      nextNodeId: b_t1
      scoreModifiers:
      - category: Vocabulary
        value: 10
        reason: "Khen trang phục bằng 似合いますね, cách khen tự nhiên với người quen"
      grammarTags:
      - grammar.n5.desu_ne
      vocabularyTags:
      - vocab.n5.yukata
      - vocab.n5.niau
      setFlags: []
    - textJa: "ゆかたですね。"
      textVi: "Là yukata nhỉ."
      textEn: "It's a yukata."
      nextNodeId: b_t1
      scoreModifiers:
      - category: ResponseAccuracy
        value: 3
        reason: "Nhận xét đúng nhưng chưa thành lời khen"
      grammarTags: []
      vocabularyTags:
      - vocab.n5.yukata
      setFlags: []
    - textJa: "ゆかたは暑いです。"
      textVi: "Yukata nóng lắm."
      textEn: "Yukata are so hot."
      nextNodeId: t_wrong1
      scoreModifiers:
      - category: ResponseAccuracy
        value: -6
        reason: "Chê trang phục của người vừa khoe, thiếu tế nhị"
      grammarTags: []
      vocabularyTags: []
      setFlags: []
    flagCondition: 
    flagJumpNodeId: 
    targetItemId: 
    targetNpcId: 
    targetAreaId: 
  - id: t_wrong1
    nodeType: 0
    nextNodeId: t_start
    objectiveIdToComplete: 
    speakerName: Tanaka
    speakerId: npc_neighbor_1
    textJa: "あはは、夏ですから、少し暑いですね。でも、ゆかたは、いいですよ。"
    textReading: "あはは、なつですから、すこしあついですね。でも、ゆかたは、いいですよ。"
    textVi: "Haha, mùa hè nên cũng hơi nóng thật. Nhưng yukata đẹp lắm đấy."
    textEn: "Haha, it is summer, so it's a bit hot. But yukata are beautiful."
    textRomaji: "Ahaha, natsu desu kara, sukoshi atsui desu ne. Demo, yukata wa, ii desu yo."
    textEnglishIpa: 
    animationCue: talk
    voiceClip: {fileID: 0}
    choices: []
    flagCondition: 
    flagJumpNodeId: 
    targetItemId: 
    targetNpcId: 
    targetAreaId: 
