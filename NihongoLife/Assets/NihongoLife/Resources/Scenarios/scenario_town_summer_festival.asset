    - textJa: "まだ、ちょっと不安です。でも、がんばります。"
      textEn: "Cháu vẫn hơi lo. Nhưng cháu sẽ cố gắng ạ."
      nextNodeId: t_end_honest
      scoreModifiers:
      - category: ResponseAccuracy
