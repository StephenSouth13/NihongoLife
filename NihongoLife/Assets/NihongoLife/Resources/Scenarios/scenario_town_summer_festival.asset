  - id: t_ask
    nodeType: 0
    nextNodeId: 
    objectiveIdToComplete: 
    speakerName: Tanaka
    speakerId: npc_neighbor_1
    textJa: "この町は、どうですか。"
    textReading: "このまちは、どうですか。"
    textEn: "Bạn thấy khu phố này thế nào?"
    textRomaji: "Kono machi wa, dou desu ka?"
    textEnglishIpa: 
    animationCue: talk
    voiceClip: {fileID: 0}
    choices:
    - textJa: "この町が好きです。人がやさしいです。"
      textEn: "Cháu thích khu phố này. Mọi người rất tử tế ạ."
      nextNodeId: t_end
      scoreModifiers:
      - category: Grammar
        value: 10
        reason: "Nói cảm nghĩ bằng 〜が好きです và mô tả bằng tính từ đuôi い: やさしいです"
