  - id: t_start
    nodeType: 0
    nextNodeId: 
    objectiveIdToComplete: 
    speakerName: Tanaka
    speakerId: npc_neighbor_1
    textJa: "やあ、来ましたね。今日は、ゆかたを着ましたよ。"
    textReading: "やあ、きましたね。きょうは、ゆかたをきましたよ。"
    textEn: "Chào, bạn đến rồi nhỉ. Hôm nay tôi mặc yukata đấy."
    textRomaji: "Yaa, kimashita ne. Kyou wa, yukata wo kimashita yo."
    textEnglishIpa: 
    animationCue: talk
    voiceClip: {fileID: 0}
    choices:
    - textJa: "ゆかた、似合いますね。"
      textEn: "Bác mặc yukata hợp quá ạ."
      nextNodeId: b_t1
      scoreModifiers:
      - category: Vocabulary
        value: 10
        reason: "Khen trang phục bằng 似合いますね, cách khen tự nhiên với người quen"
      grammarTags:
      - grammar.n5.desu_ne
      vocabularyTags:
      - vocab.n5.yukata
      - vocab.n5.niau
      setFlags: []
    - textJa: "ゆかたですね。"
      textEn: "Là yukata nhỉ."
      nextNodeId: b_t1
      scoreModifiers:
      - category: ResponseAccuracy
        value: 3
        reason: "Nhận xét đúng nhưng chưa thành lời khen"
      grammarTags: []
      vocabularyTags:
      - vocab.n5.yukata
      setFlags: []
    - textJa: "ゆかたは暑いです。"
      textEn: "Yukata nóng lắm."
