  - id: n_choose
    nodeType: 0
    nextNodeId: 
    objectiveIdToComplete: 
    speakerName: Kim
    speakerId: npc_classmate_kim
    textJa: "どれをしますか。UFOキャッチャーと、バスケと、かなレインがあります。"
    textReading: "どれをしますか。ユーフォーキャッチャーと、バスケと、かなレインがあります。"
    textVi: "Chơi cái nào đây? Có máy gắp UFO, bóng rổ và Kana Rain."
    textEn: "Which one shall we play? There's the UFO catcher, basketball and Kana Rain."
    textRomaji: "Dore wo shimasu ka. Yuufoo kyacchaa to, basuke to, kana rein ga arimasu."
    textEnglishIpa: 
    animationCue: point
    voiceClip: {fileID: 0}
    choices:
    - textJa: "バスケをしましょう。"
      textVi: "Chơi bóng rổ đi."
      textEn: "Let's play basketball."
      nextNodeId: n_basket
      scoreModifiers:
      - category: Grammar
        value: 10
        reason: "Đề nghị cùng làm bằng 〜ましょう"
      grammarTags:
      - grammar.n5.mashou
      vocabularyTags:
      - vocab.n5.basuke
      setFlags:
      - kim.basket
    - textJa: "UFOキャッチャーがいいです。"
      textVi: "Máy gắp UFO được đấy."
      textEn: "The UFO catcher sounds good."
      nextNodeId: n_ufo
      scoreModifiers:
      - category: Grammar
        value: 10
        reason: "Chọn bằng 〜がいいです"
      grammarTags:
      - grammar.n5.ga_ii_desu
      vocabularyTags: []
      setFlags:
      - kim.ufo
    - textJa: "ゲームを食べます。"
      textVi: "Ăn trò chơi. (sai động từ)"
      textEn: "I eat the game. (wrong verb)"
      nextNodeId: n_choose_wrong
      scoreModifiers:
      - category: Vocabulary
        value: -6
        reason: "Dùng sai động từ: trò chơi thì dùng する, không phải 食べる"
      grammarTags: []
      vocabularyTags: []
      setFlags: []
