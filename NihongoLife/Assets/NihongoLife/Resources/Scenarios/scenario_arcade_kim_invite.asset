    nodeType: 0
    nextNodeId: n_arrive
    objectiveIdToComplete: 
    speakerName: 
    speakerId: 
    textJa: "キムさんと、さくら通りをあるいて、ゲームセンターへ行きました。"
    textReading: "キムさんと、さくらどおりをあるいて、ゲームセンターへいきました。"
    textVi: "Bạn cùng Kim đi dọc phố Sakura đến Game Center."
    textEn: "You walked along Sakura-dori with Kim to the Game Center."
    textRomaji: "Kimu-san to, Sakura-doori wo aruite, geemu sentaa e ikimashita."
