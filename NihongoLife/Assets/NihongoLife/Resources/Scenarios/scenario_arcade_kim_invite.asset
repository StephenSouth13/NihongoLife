    nodeType: 0
    nextNodeId: 
    objectiveIdToComplete: 
    speakerName: Kim
    speakerId: npc_classmate_kim
    textJa: "つぎは、わたしのばんです。…あっ、ぜんぜん、だめでした！あはは。"
    textReading: "つぎは、わたしのばんです。…あっ、ぜんぜん、だめでした！あはは。"
    textVi: "Tiếp theo đến lượt tớ. …Á, chẳng được gì cả! Haha."
    textEn: "Now it's my turn. …Oh, total failure! Haha."
    textRomaji: "Tsugi wa, watashi no ban desu. …A, zenzen, dame deshita! Ahaha."
    textEnglishIpa: 
    animationCue: talk
    voiceClip: {fileID: 0}
    choices:
