  - id: n_basket
    nodeType: 0
    nextNodeId: 
    objectiveIdToComplete: 
    speakerName: Kim
    speakerId: npc_classmate_kim
    textJa: "バスケは、ボールを三回なげます。いっしょにかぞえましょう。いっかい、にかい…"
    textReading: "バスケは、ボールをさんかいなげます。いっしょにかぞえましょう。いっかい、にかい…"
    textVi: "Bóng rổ thì ném bóng 3 lần. Cùng đếm nhé. Một lần, hai lần…"
    textEn: "In basketball you throw the ball three times. Let's count together. Once, twice…"
    textRomaji: "Basuke wa, booru wo sankai nagemasu. Issho ni kazoemashou. Ikkai, nikai…"
    textEnglishIpa: 
    animationCue: point
    voiceClip: {fileID: 0}
    choices:
    - textJa: "さんかい！"
      textVi: "Ba lần!"
      textEn: "Three times!"
      nextNodeId: n_basket_score
      scoreModifiers:
      - category: Vocabulary
        value: 10
        reason: "Đếm số lần đúng với 〜回: いっかい、にかい、さんかい"
      grammarTags: []
      vocabularyTags:
      - vocab.n5.kai
      - vocab.n5.san
      setFlags: []
    - textJa: "みっつ！"
      textVi: "Ba cái!"
      textEn: "Three (things)!"
      nextNodeId: n_basket_counter
      scoreModifiers:
      - category: Vocabulary
        value: 2
        reason: "みっつ dùng đếm đồ vật; đếm số lần thì dùng 〜回: さんかい"
      grammarTags: []
      vocabularyTags:
      - vocab.n5.mittsu
      setFlags: []
    flagCondition: 
    flagJumpNodeId: 
    targetItemId: 
    targetNpcId: 
    targetAreaId: 
  - id: n_basket_counter
    nodeType: 0
    nextNodeId: n_basket_score
    objectiveIdToComplete: 
    speakerName: Kim
    speakerId: npc_classmate_kim
    textJa: "おしい！ものは「みっつ」、でも、なげるのは「さんかい」です。"
    textReading: "おしい！ものは「みっつ」、でも、なげるのは「さんかい」です。"
    textVi: "Suýt đúng! Đồ vật thì 「みっつ」, còn ném thì 「さんかい」."
    textEn: "Close! Objects are 「みっつ」, but throws are 「さんかい」."
    textRomaji: "Oshii! Mono wa \"mittsu\", demo, nageru no wa \"sankai\" desu."
