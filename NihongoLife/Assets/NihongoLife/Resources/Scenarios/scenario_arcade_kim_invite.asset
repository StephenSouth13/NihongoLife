  m_Name: scenario_arcade_kim_invite
  m_EditorClassIdentifier: NihongoLife::NihongoLife.Scenario.ScenarioDefinition
  id: scenario.arcade.kim_invite
  version: 2
  titleJa: "キムさんとゲームセンター"
  titleVi: "Đi Game Center cùng Kim"
  titleEn: "Game Center with Kim"
  descriptionJa: "放課後、キムさんとゲームセンターへ。さそい方、数え方（〜回・〜まい）、ほしいものの言い方を練習します。"
  descriptionVi: "Sau giờ học, cùng Kim đến Game Center: rủ rê, đếm số lần (〜回), đếm vé (〜まい), nói điều mình muốn (〜がほしい)."
  descriptionEn: "After class, go to the Game Center with Kim: inviting, counting times (~kai) and tickets (~mai), and saying what you want (~ga hoshii)."
  chapterIndex: 4
  questType: main
  giverNpcId: npc_classmate_kim
  briefingVi: "Sau giờ học, Kim rủ bạn ra Game Center. Rủ rê, đếm số lần (〜回), đếm vé (〜まい) và đổi quà bằng tiếng Nhật."
  briefingEn: "After class Kim invites you to the Game Center. Invite, count times (~kai) and tickets (~mai), and swap for a prize in Japanese."
  briefingJa: "放課後、キムさんがゲームセンターにさそってくれます。〜回・〜まいで数えて、けいひんを日本語でもらいましょう。"
  locationHintVi: "Lớp さくら (gặp Kim), rồi Trung tâm trò chơi Hibari"
  locationHintEn: "Sakura class (meet Kim), then Game Center Hibari"
  locationHintJa: "さくらクラス → ゲームセンター"
  rewardYen: 300
  branchId: main
  requiredKnowledge: 240
  requiredScenarioIds:
  - scenario.station.buy_ticket
  unlockScenarioIds:
  - scenario.island.midori_trip
  repeatable: 0
  supportsCoOp: 0
  minPlayers: 1
  maxPlayers: 2
  learningTargets:
  - grammar.n5.masen_ka
  - grammar.n5.mashou
  - grammar.n5.ga_hoshii
  - vocab.n5.kai
  - vocab.n5.mai
  objectives:
  - id: obj_meet
    titleJa: "キムさんに会う"
    titleVi: "Gặp Kim sau giờ học"
    titleEn: "Meet Kim after class"
    isOptional: 0
  - id: obj_arrive
    titleJa: "ゲームセンターに着く"
    titleVi: "Đến Game Center"
    titleEn: "Arrive at the Game Center"
    isOptional: 0
  - id: obj_play
    titleJa: "いっしょにゲームをする"
    titleVi: "Chơi game cùng Kim"
    titleEn: "Play a game with Kim"
    isOptional: 0
  - id: obj_prize
    titleJa: "けいひんをもらう"
    titleVi: "Đổi vé lấy quà"
    titleEn: "Swap tickets for a prize"
    isOptional: 0
  - id: obj_bye
    titleJa: "またのやくそくをする"
    titleVi: "Hẹn lần sau"
    titleEn: "Plan to come again"
    isOptional: 0
  nodes:
  - id: node_find_kim
    nodeType: 6
    nextNodeId: n_greet
