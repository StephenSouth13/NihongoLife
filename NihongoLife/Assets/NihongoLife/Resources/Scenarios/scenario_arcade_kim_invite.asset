    nodeType: 0
    nextNodeId: n_arrive
    objectiveIdToComplete: 
    speakerName: 
    speakerId: 
    textJa: "つぎの日、じゅぎょうのあと、キムさんとゲームセンターへ行きました。"
    textReading: "つぎのひ、じゅぎょうのあと、キムさんとゲームセンターへいきました。"
    textVi: "Hôm sau, tan học, bạn cùng Kim đến Game Center."
    textEn: "The next day, after class, you went to the Game Center with Kim."
    textRomaji: "Tsugi no hi, jugyou no ato, Kimu-san to geemu sentaa e ikimashita."
    textEnglishIpa: 
