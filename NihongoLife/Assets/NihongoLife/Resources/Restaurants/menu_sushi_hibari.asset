%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5e1a7c30b9d24f8e8a6c1d2f4b7a9e03, type: 3}
  m_Name: menu_sushi_hibari
  m_EditorClassIdentifier: NihongoLife::NihongoLife.Data.RestaurantMenuDefinition
  id: menu.sushi.hibari
  restaurantNameJa: ひばり寿司
  restaurantNameReading: ひばりずし
  restaurantNameVi: Sushi Hibari
  restaurantNameEn: Hibari Sushi
  taglineVi: "Sushi tươi làm ngay trước mặt bạn, giữa khu phố Hibari"
  taglineEn: "Sushi made fresh in front of you, in the heart of Hibari-cho"
  categories:
  - id: "nigiri"
    titleJa: "握り"
    titleReading: "にぎり"
    titleVi: "Sushi nắm (nigiri)"
    titleEn: "Nigiri sushi"
  - id: "maki"
    titleJa: "巻き物"
    titleReading: "まきもの"
    titleVi: "Sushi cuộn (maki)"
    titleEn: "Rolls (maki)"
  - id: "donburi"
    titleJa: "ちらし・丼"
    titleReading: "ちらし・どんぶり"
    titleVi: "Cơm chirashi và donburi"
    titleEn: "Chirashi and rice bowls"
  - id: "side"
    titleJa: "一品料理"
    titleReading: "いっぴんりょうり"
    titleVi: "Món ăn kèm"
    titleEn: "Side dishes"
  - id: "drink"
    titleJa: "飲み物"
    titleReading: "のみもの"
    titleVi: "Đồ uống"
    titleEn: "Drinks"
  - id: "dessert"
    titleJa: "デザート"
    titleReading: "でざーと"
    titleVi: "Tráng miệng"
    titleEn: "Dessert"
  dishes:
  - id: "maguro"
    categoryId: "nigiri"
    nameJa: "まぐろ（赤身）"
    reading: "まぐろ（あかみ）"
    romaji: "maguro (akami)"
    nameVi: "Cá ngừ (phần thịt đỏ)"
    nameEn: "Tuna (lean red cut)"
    priceYen: 280
    descriptionJa: "赤い身のまぐろです。あぶらが少なくて、さっぱりしています。"
    descriptionVi: "Phần thịt đỏ của cá ngừ, ít béo, vị thanh. Đây là loại sushi kinh điển nhất, rất hợp để thử đầu tiên. Một phần gồm 2 miếng."
    descriptionEn: "The lean red cut of tuna: clean taste, little fat. A classic and the best first piece to try. One order is 2 pieces."
    ingredientsVi:
    - "Cơm sushi (trộn giấm)"
    - "Cá ngừ"
    - "Wasabi"
    allergensVi:
    - "Cá"
    - "Đậu nành (nước tương)"
    eatingTipVi: "Chỉ chấm phần cá vào nước tương, không nhúng phần cơm. Ăn cả miếng trong một lần."
    isSpecialty: 0
    specialtyNoteVi: ""
    vocabularyTag: "vocab.n5.maguro"
  - id: "salmon"
    categoryId: "nigiri"
    nameJa: "サーモン"
    reading: "さーもん"
    romaji: "saamon"
    nameVi: "Cá hồi"
    nameEn: "Salmon"
    priceYen: 250
    descriptionJa: "サーモンはやわらかくて、あぶらがあります。"
    descriptionVi: "Cá hồi béo, mềm và dễ ăn, được nhiều người chọn khi mới làm quen với sushi. Một phần gồm 2 miếng."
    descriptionEn: "Soft, rich salmon that is easy to enjoy for newcomers. One order is 2 pieces."
    ingredientsVi:
    - "Cơm sushi"
    - "Cá hồi"
    - "Wasabi"
    allergensVi:
    - "Cá"
    - "Đậu nành (nước tương)"
    eatingTipVi: "Chấm nhẹ phần cá vào nước tương rồi ăn cả miếng."
    isSpecialty: 0
    specialtyNoteVi: ""
    vocabularyTag: "vocab.n5.sake"
  - id: "ebi"
    categoryId: "nigiri"
    nameJa: "えび"
    reading: "えび"
    romaji: "ebi"
    nameVi: "Tôm luộc"
    nameEn: "Boiled shrimp"
    priceYen: 220
    descriptionJa: "えびは火を通してあります。なま魚がにがてな人にもおすすめです。"
    descriptionVi: "Tôm đã luộc chín, hợp với người chưa quen ăn cá sống. Một phần gồm 2 miếng."
    descriptionEn: "Cooked shrimp, a good choice if you are not used to raw fish. One order is 2 pieces."
    ingredientsVi:
    - "Cơm sushi"
    - "Tôm luộc"
    allergensVi:
    - "Động vật giáp xác (tôm)"
    - "Đậu nành (nước tương)"
    eatingTipVi: "Có thể ăn bằng tay hoặc đũa. Nếu bị dị ứng tôm, hãy nói ngay với nhân viên: アレルギーがあります。"
    isSpecialty: 0
    specialtyNoteVi: ""
    vocabularyTag: "vocab.n5.ebi"
  - id: "tamago"
    categoryId: "nigiri"
    nameJa: "たまご"
    reading: "たまご"
    romaji: "tamago"
    nameVi: "Trứng cuộn ngọt"
    nameEn: "Sweet rolled omelet"
    priceYen: 180
    descriptionJa: "たまごは甘い卵焼きです。子どもにも人気です。"
    descriptionVi: "Trứng cuộn nướng vị ngọt, có dải rong biển giữ phần trứng. Nhiều người kể rằng tamago là món để 'thử tay nghề' của đầu bếp. Một phần gồm 2 miếng."
    descriptionEn: "Sweet grilled rolled omelet held by a strip of seaweed. Many people say tamago is how you judge a chef's skill. One order is 2 pieces."
    ingredientsVi:
    - "Cơm sushi"
    - "Trứng cuộn (tamagoyaki)"
    - "Rong biển"
    allergensVi:
    - "Trứng"
    - "Đậu nành"
    eatingTipVi: "Ăn cả miếng, không cần chấm nước tương vì trứng đã có vị ngọt."
    isSpecialty: 0
    specialtyNoteVi: ""
    vocabularyTag: "vocab.n5.tamago"
  - id: "ika"
    categoryId: "nigiri"
    nameJa: "いか"
    reading: "いか"
    romaji: "ika"
    nameVi: "Mực"
    nameEn: "Squid"
    priceYen: 200
    descriptionJa: "いかは少しかたくて、あまい味です。"
    descriptionVi: "Mực có độ dai giòn nhẹ và vị ngọt thanh. Một phần gồm 2 miếng."
    descriptionEn: "Squid with a slight chew and a gentle sweetness. One order is 2 pieces."
    ingredientsVi:
    - "Cơm sushi"
    - "Mực"
    allergensVi:
    - "Động vật thân mềm (mực)"
    - "Đậu nành (nước tương)"
    eatingTipVi: "Nhai kỹ hơn các loại khác một chút để cảm nhận vị ngọt."
    isSpecialty: 0
    specialtyNoteVi: ""
    vocabularyTag: "vocab.n5.ika"
  - id: "unagi_nigiri"
    categoryId: "nigiri"
    nameJa: "うなぎ"
    reading: "うなぎ"
    romaji: "unagi"
    nameVi: "Lươn nướng sốt ngọt"
    nameEn: "Grilled eel with sweet sauce"
    priceYen: 380
    descriptionJa: "うなぎは焼いた魚です。あまいたれがおいしいです。"
    descriptionVi: "Lươn nướng phết sốt ngọt mặn (tare), béo và thơm. Một phần gồm 2 miếng."
    descriptionEn: "Grilled eel brushed with sweet-savory tare sauce. Rich and fragrant. One order is 2 pieces."
    ingredientsVi:
    - "Cơm sushi"
    - "Lươn nướng"
    - "Sốt tare (nước tương, mirin, đường)"
    allergensVi:
    - "Cá (lươn)"
    - "Đậu nành"
    - "Lúa mì"
    eatingTipVi: "Sốt đã có sẵn, không cần chấm thêm nước tương."
    isSpecialty: 1
    specialtyNoteVi: "Người Nhật hay ăn lươn vào 'Doyo no Ushi no Hi' (土用の丑の日), ngày giữa mùa hè, để lấy sức chống nóng."
    vocabularyTag: "vocab.n5.unagi"
  - id: "hotate"
    categoryId: "nigiri"
    nameJa: "ほたて"
    reading: "ほたて"
    romaji: "hotate"
    nameVi: "Sò điệp"
    nameEn: "Scallop"
    priceYen: 320
    descriptionJa: "ほたては大きくて、とてもあまいです。"
    descriptionVi: "Sò điệp to, vị ngọt và mềm, thường được ưa chuộng vào mùa lạnh. Một phần gồm 2 miếng."
    descriptionEn: "Large, sweet, tender scallop. One order is 2 pieces."
    ingredientsVi:
    - "Cơm sushi"
    - "Sò điệp"
    allergensVi:
    - "Động vật thân mềm (sò điệp)"
    - "Đậu nành (nước tương)"
    eatingTipVi: "Chấm nhẹ nước tương hoặc ăn với chút muối nếu quán có."
    isSpecialty: 0
    specialtyNoteVi: ""
    vocabularyTag: "vocab.n5.hotate"
  - id: "ikura"
    categoryId: "nigiri"
    nameJa: "いくら（軍艦）"
    reading: "いくら（ぐんかん）"
    romaji: "ikura (gunkan)"
    nameVi: "Trứng cá hồi (gunkan)"
    nameEn: "Salmon roe (gunkan)"
    priceYen: 300
    descriptionJa: "いくらは赤くて小さい魚のたまごです。のりでまいてあります。"
    descriptionVi: "Trứng cá hồi đỏ bóng, vị mặn dịu, nổ nhẹ trong miệng. Món gunkan (軍艦, nghĩa là 'tàu chiến') được quấn rong biển để giữ phần trứng. Một phần gồm 2 miếng."
    descriptionEn: "Bright red salmon roe with a mild salty pop. 'Gunkan' means 'battleship', named for the seaweed wall. One order is 2 pieces."
    ingredientsVi:
    - "Cơm sushi"
    - "Trứng cá hồi (ngâm nước tương)"
    - "Rong biển"
    allergensVi:
    - "Trứng cá"
    - "Cá hồi"
    - "Đậu nành"
    eatingTipVi: "Ăn bằng tay sẽ dễ hơn, tránh lật ngược miếng sushi."
    isSpecialty: 0
    specialtyNoteVi: ""
    vocabularyTag: "vocab.n5.ikura"
  - id: "kappamaki"
    categoryId: "maki"
    nameJa: "かっぱ巻き"
    reading: "かっぱまき"
    romaji: "kappamaki"
    nameVi: "Sushi cuộn dưa leo"
    nameEn: "Cucumber roll"
    priceYen: 250
    descriptionJa: "かっぱ巻きはきゅうりのすしです。さっぱりしています。"
    descriptionVi: "Cuộn dưa leo giòn mát, nhẹ và tươi. Tên 'kappa' lấy từ thủy quái kappa trong truyền thuyết Nhật, nghe nói rất thích dưa leo. Một phần gồm 6 miếng nhỏ."
    descriptionEn: "A refreshing cucumber roll. 'Kappa' is a water creature from Japanese folklore said to love cucumbers. One order is 6 small pieces."
    ingredientsVi:
    - "Cơm sushi"
    - "Dưa leo"
    - "Rong biển"
    allergensVi:
    - "Đậu nành (nước tương)"
    eatingTipVi: "Món chay dễ ăn, hợp làm món dọn vị giữa các loại cá."
    isSpecialty: 0
    specialtyNoteVi: ""
    vocabularyTag: "vocab.n5.kyuuri"
  - id: "tekkamaki"
    categoryId: "maki"
    nameJa: "鉄火巻き"
    reading: "てっかまき"
    romaji: "tekkamaki"
    nameVi: "Sushi cuộn cá ngừ"
    nameEn: "Tuna roll"
    priceYen: 350
    descriptionJa: "鉄火巻きはまぐろのまきずしです。"
    descriptionVi: "Cuộn cá ngừ đỏ với rong biển bên ngoài. Theo một giả thuyết phổ biến, 'tekka' (鉄火) gắn với các sòng bạc xưa, nơi người ta cần món ăn nhanh bằng một tay. Một phần gồm 6 miếng nhỏ."
    descriptionEn: "A tuna roll wrapped in seaweed. One popular theory links the name 'tekka' to old gambling dens where a one-handed snack was handy. One order is 6 small pieces."
    ingredientsVi:
    - "Cơm sushi"
    - "Cá ngừ"
    - "Rong biển"
    allergensVi:
    - "Cá"
    - "Đậu nành (nước tương)"
    eatingTipVi: "Chấm nhẹ một đầu miếng cuộn vào nước tương."
    isSpecialty: 0
    specialtyNoteVi: ""
    vocabularyTag: "vocab.n5.maguro"
  - id: "futomaki"
    categoryId: "maki"
    nameJa: "太巻き"
    reading: "ふとまき"
    romaji: "futomaki"
    nameVi: "Sushi cuộn lớn nhiều nhân"
    nameEn: "Thick roll with many fillings"
    priceYen: 450
    descriptionJa: "太巻きは大きいまきずしです。いろいろなものが入っています。"
    descriptionVi: "Cuộn to với nhiều nhân như trứng, dưa leo, nấm shiitake và chả cá, cắt ra thấy nhiều màu. Ngày Setsubun (3/2), người Nhật có tục ăn nguyên một cuộn 'ehomaki' (恵方巻) quay về hướng may mắn trong im lặng. Một phần gồm 4 miếng lớn."
    descriptionEn: "A thick roll with egg, cucumber, shiitake and fish cake. On Setsubun (Feb 3) many people eat a whole 'ehomaki' in silence facing the lucky direction. One order is 4 large pieces."
    ingredientsVi:
    - "Cơm sushi"
    - "Trứng cuộn"
    - "Dưa leo"
    - "Nấm shiitake"
    - "Chả cá kamaboko"
    - "Rong biển"
    allergensVi:
    - "Trứng"
    - "Cá (chả cá)"
    - "Đậu nành"
    - "Lúa mì"
    eatingTipVi: "Miếng to, có thể cắn làm hai lần. Chấm nước tương ít."
    isSpecialty: 0
    specialtyNoteVi: ""
    vocabularyTag: "vocab.n5.makizushi"
  - id: "california"
    categoryId: "maki"
    nameJa: "カリフォルニアロール"
    reading: "かりふぉるにあろーる"
    romaji: "kariforunia roru"
    nameVi: "Cuộn California"
    nameEn: "California roll"
    priceYen: 450
    descriptionJa: "カリフォルニアロールはアメリカで生まれたすしです。"
    descriptionVi: "Cuộn đảo (cơm ở ngoài) với bơ, thanh cua và mè. Món này ra đời ở Bắc Mỹ, không phải sushi truyền thống của Nhật, nhưng nhiều quán vẫn có để phục vụ khách quốc tế."
    descriptionEn: "An inside-out roll with avocado, imitation crab and sesame. It was created in North America and is not traditional Japanese sushi, but many shops serve it."
    ingredientsVi:
    - "Cơm sushi"
    - "Bơ"
    - "Thanh cua (surimi)"
    - "Mè"
    - "Sốt mayonnaise"
    allergensVi:
    - "Cá (thanh cua)"
    - "Trứng (mayonnaise)"
    - "Mè"
    - "Lúa mì"
    eatingTipVi: "Ăn kèm chút nước tương hoặc sốt riêng của quán."
    isSpecialty: 0
    specialtyNoteVi: ""
    vocabularyTag: "vocab.n5.abokado"
  - id: "chirashi"
    categoryId: "donburi"
    nameJa: "ちらし寿司"
    reading: "ちらしずし"
    romaji: "chirashi zushi"
    nameVi: "Cơm sushi rải hải sản"
    nameEn: "Scattered sushi bowl"
    priceYen: 1100
    descriptionJa: "ちらし寿司は、すしめしの上にいろいろな魚をのせた料理です。"
    descriptionVi: "Cơm trộn giấm với nhiều loại hải sản, trứng cuộn và rau củ rải lên trên ('chirashi' nghĩa là 'rải'). Vào ngày Hinamatsuri (3/3), nhiều gia đình Nhật ăn chirashi zushi. Kèm súp miso."
    descriptionEn: "Vinegared rice topped with assorted seafood, egg and vegetables ('chirashi' means 'scattered'). Many families eat it on Hinamatsuri (March 3). Comes with miso soup."
    ingredientsVi:
    - "Cơm sushi"
    - "Cá ngừ"
    - "Cá hồi"
    - "Tôm"
    - "Trứng cuộn"
    - "Rong biển thái sợi"
    allergensVi:
    - "Cá"
    - "Động vật giáp xác (tôm)"
    - "Trứng"
    - "Đậu nành"
    eatingTipVi: "Trộn nhẹ wasabi vào nước tương rồi rưới từng ít lên hải sản, không đổ lên cơm."
    isSpecialty: 1
    specialtyNoteVi: "Món đặc trưng của quán, đầu bếp chọn hải sản tươi theo từng ngày."
    vocabularyTag: "vocab.n5.chirashi"
  - id: "kaisendon"
    categoryId: "donburi"
    nameJa: "海鮮丼"
    reading: "かいせんどん"
    romaji: "kaisendon"
    nameVi: "Cơm hải sản sống"
    nameEn: "Seafood rice bowl"
    priceYen: 1150
    descriptionJa: "海鮮丼は、ごはんの上にさしみをのせた丼です。"
    descriptionVi: "Sashimi tươi xếp trên cơm trắng. Khác với chirashi, kaisendon thường dùng cơm trắng thường (không trộn giấm). Kèm súp miso."
    descriptionEn: "Fresh sashimi over plain rice. Unlike chirashi, kaisendon usually uses plain rice rather than vinegared sushi rice. Comes with miso soup."
    ingredientsVi:
    - "Cơm trắng"
    - "Cá ngừ"
    - "Cá hồi"
    - "Mực"
    - "Trứng cá hồi"
    - "Lá tía tô"
    allergensVi:
    - "Cá"
    - "Động vật thân mềm (mực)"
    - "Trứng cá"
    - "Đậu nành"
    eatingTipVi: "Rưới nước tương lên sashimi, không đổ trực tiếp lên cơm."
    isSpecialty: 0
    specialtyNoteVi: ""
    vocabularyTag: "vocab.n5.donburi"
  - id: "unadon"
    categoryId: "donburi"
    nameJa: "うな丼"
    reading: "うなどん"
    romaji: "unadon"
    nameVi: "Cơm lươn nướng"
    nameEn: "Grilled eel rice bowl"
    priceYen: 1100
    descriptionJa: "うな丼は、ごはんの上にうなぎをのせた丼です。"
    descriptionVi: "Lươn nướng sốt ngọt trên cơm nóng, hương thơm rất đặc trưng. Kèm súp miso."
    descriptionEn: "Grilled eel with sweet sauce over hot rice, with a distinctive aroma. Comes with miso soup."
    ingredientsVi:
    - "Cơm trắng"
    - "Lươn nướng"
    - "Sốt tare"
    allergensVi:
    - "Cá (lươn)"
    - "Đậu nành"
    - "Lúa mì"
    eatingTipVi: "Có thể rắc chút bột tiêu sansho (山椒) nếu quán có để tăng hương vị."
    isSpecialty: 1
    specialtyNoteVi: "Món ăn 'lấy sức' quen thuộc trong mùa hè, đặc biệt vào ngày Doyo no Ushi no Hi (土用の丑の日)."
    vocabularyTag: "vocab.n5.unagi"
  - id: "hibari_set"
    categoryId: "donburi"
    nameJa: "ひばり特選にぎり"
    reading: "ひばりとくせんにぎり"
    romaji: "Hibari tokusen nigiri"
    nameVi: "Set nigiri đặc biệt của Hibari"
    nameEn: "Hibari premium nigiri set"
    priceYen: 1180
    descriptionJa: "ひばり特選にぎりは、今日いちばんよい魚のすしセットです。"
    descriptionVi: "Set 8 miếng nigiri do đầu bếp chọn theo cá tươi nhất trong ngày, kèm trứng cuộn và súp miso. Quán làm theo phong cách 'Edomae' (江戸前) từ vùng vịnh Tokyo xưa: cá được ướp, ủ hoặc nấu nhẹ để lấy vị tốt nhất."
    descriptionEn: "An 8-piece nigiri set chosen by the chef from the day's freshest fish, with tamago and miso soup. Prepared in the 'Edomae' style from old Tokyo Bay: fish is marinated, aged or lightly cooked to bring out flavor."
    ingredientsVi:
    - "Cơm sushi"
    - "Cá theo mùa (do đầu bếp chọn)"
    - "Trứng cuộn"
    - "Súp miso"
    allergensVi:
    - "Cá"
    - "Trứng"
    - "Đậu nành"
    - "Có thể có động vật giáp xác và thân mềm — hãy hỏi nhân viên"
    eatingTipVi: "Ăn từ miếng nhạt vị (cá trắng) đến đậm vị (lươn, cá ngừ béo), giữa các miếng ăn một lát gừng ngâm (gari)."
    isSpecialty: 1
    specialtyNoteVi: "Món đặc trưng của quán. 'Shun' (旬) là mùa ngon nhất của mỗi loại cá, vì vậy nguyên liệu trong set thay đổi theo mùa."
    vocabularyTag: "vocab.n5.nigiri"
  - id: "misoshiru"
    categoryId: "side"
    nameJa: "お味噌汁"
    reading: "おみそしる"
    romaji: "omisoshiru"
    nameVi: "Súp miso"
    nameEn: "Miso soup"
    priceYen: 200
    descriptionJa: "お味噌汁は、みそのスープです。とうふとわかめが入っています。"
    descriptionVi: "Súp làm từ nước dashi và miso, có đậu phụ, rong biển wakame và hành lá. Ấm bụng, dễ ăn."
    descriptionEn: "Soup made from dashi and miso, with tofu, wakame seaweed and green onion. Warming and gentle."
    ingredientsVi:
    - "Nước dashi (cá)"
    - "Miso"
    - "Đậu phụ"
    - "Rong biển wakame"
    - "Hành lá"
    allergensVi:
    - "Đậu nành"
    - "Cá (dashi)"
    eatingTipVi: "Bưng bát lên uống trực tiếp, dùng đũa gắp nguyên liệu. Không dùng thìa."
    isSpecialty: 0
    specialtyNoteVi: ""
    vocabularyTag: "vocab.n5.misoshiru"
  - id: "chawanmushi"
    categoryId: "side"
    nameJa: "茶碗蒸し"
    reading: "ちゃわんむし"
    romaji: "chawanmushi"
    nameVi: "Trứng hấp mặn"
    nameEn: "Savory steamed egg custard"
    priceYen: 400
    descriptionJa: "茶碗蒸しは、たまごをむしたあたたかい料理です。"
    descriptionVi: "Trứng hấp mềm mịn như pudding mặn, nấu từ nước dashi với thịt gà, nấm và tôm. Ăn bằng thìa nhỏ, rất nóng nên hãy ăn chậm."
    descriptionEn: "A silky savory custard of egg and dashi with chicken, mushroom and shrimp. Eaten with a small spoon; it is very hot, so go slowly."
    ingredientsVi:
    - "Trứng"
    - "Nước dashi"
    - "Thịt gà"
    - "Nấm"
    - "Tôm"
    - "Ngân hạnh (có thể có)"
    allergensVi:
    - "Trứng"
    - "Đậu nành"
    - "Cá (dashi)"
    - "Động vật giáp xác (tôm)"
    - "Hạt ngân hạnh (có thể có)"
    eatingTipVi: "Dùng thìa nhỏ đi kèm. Đây là món tráng miệng vị mặn nên ăn trước cơm chứ không phải sau."
    isSpecialty: 1
    specialtyNoteVi: "Đầu bếp của quán hấp món này theo công thức riêng, mỗi ngày làm số lượng có hạn."
    vocabularyTag: "vocab.n5.chawanmushi"
  - id: "edamame"
    categoryId: "side"
    nameJa: "枝豆"
    reading: "えだまめ"
    romaji: "edamame"
    nameVi: "Đậu nành non luộc muối"
    nameEn: "Salted young soybeans"
    priceYen: 300
    descriptionJa: "枝豆は、しおをかけたまめです。"
    descriptionVi: "Đậu nành non luộc, rắc muối, món nhấm nhẹ trước bữa ăn."
    descriptionEn: "Young soybeans boiled and salted, a light starter."
    ingredientsVi:
    - "Đậu nành non"
    - "Muối"
    allergensVi:
    - "Đậu nành"
    eatingTipVi: "Bóp hạt ra khỏi vỏ bằng tay, không ăn vỏ."
    isSpecialty: 0
    specialtyNoteVi: ""
    vocabularyTag: "vocab.n5.mame"
  - id: "ocha"
    categoryId: "drink"
    nameJa: "お茶（あがり）"
    reading: "おちゃ（あがり）"
    romaji: "ocha (agari)"
    nameVi: "Trà xanh (agari)"
    nameEn: "Green tea (agari)"
    priceYen: 0
    descriptionJa: "お茶はむりょうです。"
    descriptionVi: "Trà xanh nóng miễn phí; 'agari' (あがり) là cách gọi trà trong tiệm sushi. Có thể xin rót thêm."
    descriptionEn: "Free hot green tea; 'agari' is the sushi-shop word for tea. Refills are available."
    ingredientsVi:
    - "Trà xanh"
    allergensVi: []
    eatingTipVi: "Uống giữa các miếng sushi để làm sạch vị giác."
    isSpecialty: 0
    specialtyNoteVi: ""
    vocabularyTag: "vocab.n5.ocha"
  - id: "oolong"
    categoryId: "drink"
    nameJa: "ウーロン茶"
    reading: "うーろんちゃ"
    romaji: "uuroncha"
    nameVi: "Trà ô long"
    nameEn: "Oolong tea"
    priceYen: 250
    descriptionJa: "ウーロン茶はつめたいお茶です。"
    descriptionVi: "Trà ô long ướp lạnh, ít đắng, hợp với món dầu mỡ."
    descriptionEn: "Chilled oolong tea, mild and good with rich dishes."
    ingredientsVi:
    - "Trà ô long"
    allergensVi: []
    eatingTipVi: "Không có."
    isSpecialty: 0
    specialtyNoteVi: ""
    vocabularyTag: "vocab.n5.ocha"
  - id: "ramune"
    categoryId: "drink"
    nameJa: "ラムネ"
    reading: "らむね"
    romaji: "ramune"
    nameVi: "Soda ramune"
    nameEn: "Ramune soda"
    priceYen: 250
    descriptionJa: "ラムネは、ガラスのびんに入ったソーダです。"
    descriptionVi: "Soda có ga trong chai thủy tinh có viên bi bên trong cổ chai, ấn nút nhựa để viên bi rơi xuống rồi mới uống. Món giải khát quen thuộc ở lễ hội mùa hè."
    descriptionEn: "Fizzy soda in a glass bottle sealed with a marble. Push the plastic cap to drop the marble, then drink. A summer festival favorite."
    ingredientsVi:
    - "Nước có ga"
    - "Đường"
    - "Hương vị (chanh)"
    allergensVi: []
    eatingTipVi: "Ấn thật mạnh nút nhựa xuống trước khi mở để viên bi rơi vào cổ chai."
    isSpecialty: 0
    specialtyNoteVi: ""
    vocabularyTag: "vocab.n5.soda"
  - id: "matcha_ice"
    categoryId: "dessert"
    nameJa: "抹茶アイス"
    reading: "まっちゃあいす"
    romaji: "matcha aisu"
    nameVi: "Kem trà xanh"
    nameEn: "Matcha ice cream"
    priceYen: 300
    descriptionJa: "抹茶アイスは、緑のお茶のアイスクリームです。"
    descriptionVi: "Kem vị trà xanh matcha, hơi đắng nhẹ, vị ngọt vừa phải. Món kết thúc bữa quen thuộc."
    descriptionEn: "Ice cream made with matcha, slightly bitter and gently sweet. A familiar way to end a meal."
    ingredientsVi:
    - "Sữa"
    - "Đường"
    - "Bột trà xanh matcha"
    - "Kem tươi"
    allergensVi:
    - "Sữa"
    - "Trứng (có thể có)"
    eatingTipVi: "Không có."
    isSpecialty: 0
    specialtyNoteVi: ""
    vocabularyTag: "vocab.n5.aisu"
  - id: "mitarashi"
    categoryId: "dessert"
    nameJa: "みたらし団子"
    reading: "みたらしだんご"
    romaji: "mitarashi dango"
    nameVi: "Bánh dango sốt mitarashi"
    nameEn: "Mitarashi dango"
    priceYen: 300
    descriptionJa: "みたらし団子は、あまいたれのだんごです。"
    descriptionVi: "Bánh nếp gạo xiên que nướng nhẹ, phết sốt nước tương ngọt mặn sánh. Dai, ngọt, rất được yêu thích."
    descriptionEn: "Chewy skewered rice dumplings brushed with a sticky sweet-savory soy glaze."
    ingredientsVi:
    - "Bột gạo"
    - "Nước tương"
    - "Đường"
    allergensVi:
    - "Đậu nành"
    - "Lúa mì"
    eatingTipVi: "Ăn từ viên trên cùng, dùng răng kéo từng viên ra khỏi que."
    isSpecialty: 0
    specialtyNoteVi: ""
    vocabularyTag: "vocab.n5.dango"
  phrases:
  - ja: "いらっしゃいませ。"
    reading: "いらっしゃいませ。"
    romaji: "irasshaimase."
    vi: "Xin chào quý khách (lời chào của nhân viên)."
    whenVi: "Khi bạn bước vào quán. Không cần trả lời đầy đủ, chỉ cần gật đầu mỉm cười hoặc nói 'こんにちは'."
  - ja: "何名様ですか。"
    reading: "なんめいさまですか。"
    romaji: "nanmeisama desu ka."
    vi: "Quý khách đi mấy người ạ?"
    whenVi: "Nhân viên hỏi số người ngay khi bạn vào cửa."
  - ja: "一人です。／二人です。"
    reading: "ひとりです。／ふたりです。"
    romaji: "hitori desu. / futari desu."
    vi: "Một người ạ. / Hai người ạ."
    whenVi: "Trả lời số người. Lưu ý 一人 (hitori) và 二人 (futari) đọc bất quy tắc; từ 3 người là 三人 (sannin)."
  - ja: "こちらへどうぞ。"
    reading: "こちらへどうぞ。"
    romaji: "kochira e douzo."
    vi: "Mời quý khách đi lối này."
    whenVi: "Nhân viên dẫn bạn tới chỗ ngồi."
  - ja: "カウンターでお願いします。"
    reading: "かうんたーでおねがいします。"
    romaji: "kauntaa de onegaishimasu."
    vi: "Cho tôi ngồi ở quầy nhé."
    whenVi: "Chọn chỗ ngồi. Dùng 'で+お願いします' để chọn/yêu cầu; không dùng 'をください' cho chỗ ngồi."
  - ja: "メニューをお願いします。"
    reading: "めにゅーをおねがいします。"
    romaji: "menyuu wo onegaishimasu."
    vi: "Cho tôi xin thực đơn."
    whenVi: "Khi chưa có thực đơn trên bàn."
  - ja: "おすすめは何ですか。"
    reading: "おすすめはなんですか。"
    romaji: "osusume wa nan desu ka."
    vi: "Món nào được gợi ý ạ?"
    whenVi: "Khi chưa biết chọn món gì. Rất hữu ích ở quầy sushi, nơi đầu bếp trả lời trực tiếp."
  - ja: "これをください。"
    reading: "これをください。"
    romaji: "kore wo kudasai."
    vi: "Cho tôi món này."
    whenVi: "Vừa chỉ vào món trong thực đơn vừa nói."
  - ja: "〜をお願いします。"
    reading: "〜をおねがいします。"
    romaji: "~ wo onegaishimasu."
    vi: "Cho tôi món ~ với ạ."
    whenVi: "Cách gọi món lịch sự hơn 'をください'."
  - ja: "すみません。"
    reading: "すみません。"
    romaji: "sumimasen."
    vi: "Xin lỗi (để gọi nhân viên)."
    whenVi: "Khi cần gọi nhân viên. Nói vừa phải rồi giơ tay nhẹ, không gọi to."
  - ja: "アレルギーがあります。"
    reading: "あれるぎーがあります。"
    romaji: "arerugii ga arimasu."
    vi: "Tôi bị dị ứng."
    whenVi: "Nói trước khi gọi món, rồi cho biết dị ứng gì, ví dụ 'えびです' (tôm)."
  - ja: "わさびなしでお願いします。"
    reading: "わさびなしでおねがいします。"
    romaji: "wasabi nashi de onegaishimasu."
    vi: "Cho tôi không wasabi nhé."
    whenVi: "Nếu bạn không ăn được cay. Đầu bếp thường cho sẵn wasabi trong miếng nigiri."
  - ja: "いただきます。"
    reading: "いただきます。"
    romaji: "itadakimasu."
    vi: "Xin phép được ăn (lời nói trước bữa ăn)."
    whenVi: "Nói trước khi bắt đầu ăn, biết ơn người nấu và nguyên liệu."
  - ja: "おいしいです。"
    reading: "おいしいです。"
    romaji: "oishii desu."
    vi: "Ngon quá."
    whenVi: "Khi nhân viên hỏi 'いかがですか' hoặc khi bạn muốn khen."
  - ja: "お会計をお願いします。"
    reading: "おかいけいをおねがいします。"
    romaji: "okaikei wo onegaishimasu."
    vi: "Cho tôi thanh toán."
    whenVi: "Khi ăn xong. Thanh toán thường ở quầy thu ngân gần cửa."
  - ja: "カードで払えますか。"
    reading: "かーどではらえますか。"
    romaji: "kaado de haraemasu ka."
    vi: "Tôi trả bằng thẻ được không?"
    whenVi: "Nhiều quán nhỏ chỉ nhận tiền mặt, nên hỏi trước cho chắc."
  - ja: "ごちそうさまでした。"
    reading: "ごちそうさまでした。"
    romaji: "gochisousama deshita."
    vi: "Cảm ơn vì bữa ăn ngon."
    whenVi: "Nói khi ăn xong và khi rời quán."
  - ja: "ありがとうございました。"
    reading: "ありがとうございました。"
    romaji: "arigatou gozaimashita."
    vi: "Xin cảm ơn quý khách (nhân viên nói khi bạn rời quán)."
    whenVi: "Đáp lại bằng cái gật đầu hoặc 'ごちそうさまでした'."
  etiquette:
  - titleJa: "おしぼり"
    titleVi: "Khăn ướt (oshibori)"
    bodyVi: "Quán thường đưa khăn nóng hoặc lạnh để lau tay trước khi ăn. Không dùng lau mặt hay cổ. Ăn xong gấp lại gọn và đặt cạnh, không vò nát."
  - titleJa: "しょうゆのつけ方"
    titleVi: "Cách chấm nước tương"
    bodyVi: "Chấm phần cá (không chấm phần cơm) vì cơm dễ rời và nước tương thấm quá nhiều. Đổ nước tương vào đĩa nhỏ vừa đủ, không đổ đầy."
  - titleJa: "わさびとガリ"
    titleVi: "Wasabi và gừng ngâm (gari)"
    bodyVi: "Đầu bếp thường đã cho wasabi vào giữa cá và cơm; đừng hòa thêm nhiều vào nước tương nếu không cần. Gừng ngâm gari ăn giữa các loại sushi để làm sạch vị giác, không ăn kèm cùng miếng sushi."
  - titleJa: "手でも箸でも"
    titleVi: "Ăn bằng tay hoặc đũa đều được"
    bodyVi: "Nigiri có thể ăn bằng tay hoặc đũa. Ăn trọn cả miếng trong một lần, không cắn làm đôi."
  - titleJa: "お茶（あがり）"
    titleVi: "Trà xanh (agari)"
    bodyVi: "Trà miễn phí, uống giữa các loại để làm sạch vị giác. Có thể xin rót thêm bằng 'お茶をください'."
  - titleJa: "お箸のマナー"
    titleVi: "Lễ nghi dùng đũa"
    bodyVi: "Không cắm đũa thẳng đứng vào cơm (gợi lễ cúng người mất), không chuyền thức ăn từ đũa này sang đũa khác, không dùng đũa chỉ vào người khác."
  - titleJa: "いただきます・ごちそうさま"
    titleVi: "Lời trước và sau bữa ăn"
    bodyVi: "Nói 'いただきます' trước khi ăn và 'ごちそうさまでした' khi ăn xong hoặc rời quán để cảm ơn người nấu."
  - titleJa: "お会計"
    titleVi: "Thanh toán"
    bodyVi: "Thanh toán tại quầy thu ngân khi đã ăn xong, không cần để tiền boa (ở Nhật không có tục tiền boa). Nhiều quán nhỏ chỉ nhận tiền mặt."
