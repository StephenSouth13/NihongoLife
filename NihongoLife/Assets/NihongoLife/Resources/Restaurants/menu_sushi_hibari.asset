  phrases:
  - ja: "\u3044\u3089\u3063\u3057\u3083\u3044\u307E\u305B\u3002"
    reading: "\u3044\u3089\u3063\u3057\u3083\u3044\u307E\u305B\u3002"
    romaji: irasshaimase.
    vi: "Xin ch\xE0o qu\xFD kh\xE1ch (l\u1EDDi ch\xE0o c\u1EE7a nh\xE2n vi\xEAn)."
    whenVi: "Khi b\u1EA1n b\u01B0\u1EDBc v\xE0o qu\xE1n. Kh\xF4ng c\u1EA7n tr\u1EA3
      l\u1EDDi \u0111\u1EA7y \u0111\u1EE7, ch\u1EC9 c\u1EA7n g\u1EADt \u0111\u1EA7u
      m\u1EC9m c\u01B0\u1EDDi ho\u1EB7c n\xF3i '\u3053\u3093\u306B\u3061\u306F'."
  - ja: "\u4F55\u540D\u69D8\u3067\u3059\u304B\u3002"
    reading: "\u306A\u3093\u3081\u3044\u3055\u307E\u3067\u3059\u304B\u3002"
    romaji: nanmeisama desu ka.
    vi: "Qu\xFD kh\xE1ch \u0111i m\u1EA5y ng\u01B0\u1EDDi \u1EA1?"
    whenVi: "Nh\xE2n vi\xEAn h\u1ECFi s\u1ED1 ng\u01B0\u1EDDi ngay khi b\u1EA1n v\xE0o
      c\u1EEDa."
  - ja: "\u4E00\u4EBA\u3067\u3059\u3002\uFF0F\u4E8C\u4EBA\u3067\u3059\u3002"
    reading: "\u3072\u3068\u308A\u3067\u3059\u3002\uFF0F\u3075\u305F\u308A\u3067\u3059\u3002"
    romaji: hitori desu. / futari desu.
    vi: "M\u1ED9t ng\u01B0\u1EDDi \u1EA1. / Hai ng\u01B0\u1EDDi \u1EA1."
    whenVi: "Tr\u1EA3 l\u1EDDi s\u1ED1 ng\u01B0\u1EDDi. L\u01B0u \xFD \u4E00\u4EBA
      (hitori) v\xE0 \u4E8C\u4EBA (futari) \u0111\u1ECDc b\u1EA5t quy t\u1EAFc; t\u1EEB
      3 ng\u01B0\u1EDDi l\xE0 \u4E09\u4EBA (sannin)."
  - ja: "\u3053\u3061\u3089\u3078\u3069\u3046\u305E\u3002"
    reading: "\u3053\u3061\u3089\u3078\u3069\u3046\u305E\u3002"
    romaji: kochira e douzo.
    vi: "M\u1EDDi qu\xFD kh\xE1ch \u0111i l\u1ED1i n\xE0y."
    whenVi: "Nh\xE2n vi\xEAn d\u1EABn b\u1EA1n t\u1EDBi ch\u1ED7 ng\u1ED3i."
  - ja: "\u30AB\u30A6\u30F3\u30BF\u30FC\u3067\u304A\u9858\u3044\u3057\u307E\u3059\u3002"
    reading: "\u304B\u3046\u3093\u305F\u30FC\u3067\u304A\u306D\u304C\u3044\u3057\u307E\u3059\u3002"
    romaji: kauntaa de onegaishimasu.
    vi: "Cho t\xF4i ng\u1ED3i \u1EDF qu\u1EA7y nh\xE9."
    whenVi: "Ch\u1ECDn ch\u1ED7 ng\u1ED3i. D\xF9ng '\u3067+\u304A\u9858\u3044\u3057\u307E\u3059'
      \u0111\u1EC3 ch\u1ECDn/y\xEAu c\u1EA7u; kh\xF4ng d\xF9ng '\u3092\u304F\u3060\u3055\u3044'
      cho ch\u1ED7 ng\u1ED3i."
  - ja: "\u30E1\u30CB\u30E5\u30FC\u3092\u304A\u9858\u3044\u3057\u307E\u3059\u3002"
    reading: "\u3081\u306B\u3085\u30FC\u3092\u304A\u306D\u304C\u3044\u3057\u307E\u3059\u3002"
    romaji: menyuu wo onegaishimasu.
    vi: "Cho t\xF4i xin th\u1EF1c \u0111\u01A1n."
    whenVi: "Khi ch\u01B0a c\xF3 th\u1EF1c \u0111\u01A1n tr\xEAn b\xE0n."
  - ja: "\u304A\u3059\u3059\u3081\u306F\u4F55\u3067\u3059\u304B\u3002"
    reading: "\u304A\u3059\u3059\u3081\u306F\u306A\u3093\u3067\u3059\u304B\u3002"
    romaji: osusume wa nan desu ka.
    vi: "M\xF3n n\xE0o \u0111\u01B0\u1EE3c g\u1EE3i \xFD \u1EA1?"
    whenVi: "Khi ch\u01B0a bi\u1EBFt ch\u1ECDn m\xF3n g\xEC. R\u1EA5t h\u1EEFu \xEDch
      \u1EDF qu\u1EA7y sushi, n\u01A1i \u0111\u1EA7u b\u1EBFp tr\u1EA3 l\u1EDDi tr\u1EF1c
      ti\u1EBFp."
  - ja: "\u3053\u308C\u3092\u304F\u3060\u3055\u3044\u3002"
    reading: "\u3053\u308C\u3092\u304F\u3060\u3055\u3044\u3002"
    romaji: kore wo kudasai.
    vi: "Cho t\xF4i m\xF3n n\xE0y."
    whenVi: "V\u1EEBa ch\u1EC9 v\xE0o m\xF3n trong th\u1EF1c \u0111\u01A1n v\u1EEBa
      n\xF3i."
  - ja: "\u301C\u3092\u304A\u9858\u3044\u3057\u307E\u3059\u3002"
    reading: "\u301C\u3092\u304A\u306D\u304C\u3044\u3057\u307E\u3059\u3002"
    romaji: ~ wo onegaishimasu.
    vi: "Cho t\xF4i m\xF3n ~ v\u1EDBi \u1EA1."
    whenVi: "C\xE1ch g\u1ECDi m\xF3n l\u1ECBch s\u1EF1 h\u01A1n '\u3092\u304F\u3060\u3055\u3044'."
  - ja: "\u3059\u307F\u307E\u305B\u3093\u3002"
    reading: "\u3059\u307F\u307E\u305B\u3093\u3002"
    romaji: sumimasen.
    vi: "Xin l\u1ED7i (\u0111\u1EC3 g\u1ECDi nh\xE2n vi\xEAn)."
    whenVi: "Khi c\u1EA7n g\u1ECDi nh\xE2n vi\xEAn. N\xF3i v\u1EEBa ph\u1EA3i r\u1ED3i
      gi\u01A1 tay nh\u1EB9, kh\xF4ng g\u1ECDi to."
  - ja: "\u30A2\u30EC\u30EB\u30AE\u30FC\u304C\u3042\u308A\u307E\u3059\u3002"
    reading: "\u3042\u308C\u308B\u304E\u30FC\u304C\u3042\u308A\u307E\u3059\u3002"
    romaji: arerugii ga arimasu.
    vi: "T\xF4i b\u1ECB d\u1ECB \u1EE9ng."
    whenVi: "N\xF3i tr\u01B0\u1EDBc khi g\u1ECDi m\xF3n, r\u1ED3i cho bi\u1EBFt d\u1ECB
      \u1EE9ng g\xEC, v\xED d\u1EE5 '\u3048\u3073\u3067\u3059' (t\xF4m)."
  - ja: "\u308F\u3055\u3073\u306A\u3057\u3067\u304A\u9858\u3044\u3057\u307E\u3059\u3002"
    reading: "\u308F\u3055\u3073\u306A\u3057\u3067\u304A\u306D\u304C\u3044\u3057\u307E\u3059\u3002"
    romaji: wasabi nashi de onegaishimasu.
    vi: "Cho t\xF4i kh\xF4ng wasabi nh\xE9."
    whenVi: "N\u1EBFu b\u1EA1n kh\xF4ng \u0103n \u0111\u01B0\u1EE3c cay. \u0110\u1EA7u
      b\u1EBFp th\u01B0\u1EDDng cho s\u1EB5n wasabi trong mi\u1EBFng nigiri."
  - ja: "\u3044\u305F\u3060\u304D\u307E\u3059\u3002"
    reading: "\u3044\u305F\u3060\u304D\u307E\u3059\u3002"
    romaji: itadakimasu.
    vi: "Xin ph\xE9p \u0111\u01B0\u1EE3c \u0103n (l\u1EDDi n\xF3i tr\u01B0\u1EDBc
      b\u1EEFa \u0103n)."
    whenVi: "N\xF3i tr\u01B0\u1EDBc khi b\u1EAFt \u0111\u1EA7u \u0103n, bi\u1EBFt
      \u01A1n ng\u01B0\u1EDDi n\u1EA5u v\xE0 nguy\xEAn li\u1EC7u."
  - ja: "\u304A\u3044\u3057\u3044\u3067\u3059\u3002"
    reading: "\u304A\u3044\u3057\u3044\u3067\u3059\u3002"
    romaji: oishii desu.
    vi: "Ngon qu\xE1."
    whenVi: "Khi nh\xE2n vi\xEAn h\u1ECFi '\u3044\u304B\u304C\u3067\u3059\u304B'
      ho\u1EB7c khi b\u1EA1n mu\u1ED1n khen."
  - ja: "\u304A\u4F1A\u8A08\u3092\u304A\u9858\u3044\u3057\u307E\u3059\u3002"
    reading: "\u304A\u304B\u3044\u3051\u3044\u3092\u304A\u306D\u304C\u3044\u3057\u307E\u3059\u3002"
    romaji: okaikei wo onegaishimasu.
    vi: "Cho t\xF4i thanh to\xE1n."
    whenVi: "Khi \u0103n xong. Thanh to\xE1n th\u01B0\u1EDDng \u1EDF qu\u1EA7y thu
      ng\xE2n g\u1EA7n c\u1EEDa."
  - ja: "\u30AB\u30FC\u30C9\u3067\u6255\u3048\u307E\u3059\u304B\u3002"
    reading: "\u304B\u30FC\u3069\u3067\u306F\u3089\u3048\u307E\u3059\u304B\u3002"
    romaji: kaado de haraemasu ka.
    vi: "T\xF4i tr\u1EA3 b\u1EB1ng th\u1EBB \u0111\u01B0\u1EE3c kh\xF4ng?"
    whenVi: "Nhi\u1EC1u qu\xE1n nh\u1ECF ch\u1EC9 nh\u1EADn ti\u1EC1n m\u1EB7t, n\xEAn
      h\u1ECFi tr\u01B0\u1EDBc cho ch\u1EAFc."
  - ja: "\u3054\u3061\u305D\u3046\u3055\u307E\u3067\u3057\u305F\u3002"
    reading: "\u3054\u3061\u305D\u3046\u3055\u307E\u3067\u3057\u305F\u3002"
    romaji: gochisousama deshita.
    vi: "C\u1EA3m \u01A1n v\xEC b\u1EEFa \u0103n ngon."
    whenVi: "N\xF3i khi \u0103n xong v\xE0 khi r\u1EDDi qu\xE1n."
  - ja: "\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3057\u305F\u3002"
    reading: "\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3057\u305F\u3002"
    romaji: arigatou gozaimashita.
    vi: "Xin c\u1EA3m \u01A1n qu\xFD kh\xE1ch (nh\xE2n vi\xEAn n\xF3i khi b\u1EA1n
      r\u1EDDi qu\xE1n)."
    whenVi: "\u0110\xE1p l\u1EA1i b\u1EB1ng c\xE1i g\u1EADt \u0111\u1EA7u ho\u1EB7c
      '\u3054\u3061\u305D\u3046\u3055\u307E\u3067\u3057\u305F'."
  etiquette:
  - titleJa: "\u304A\u3057\u307C\u308A"
    titleVi: "Kh\u0103n \u01B0\u1EDBt (oshibori)"
    bodyVi: "Qu\xE1n th\u01B0\u1EDDng \u0111\u01B0a kh\u0103n n\xF3ng ho\u1EB7c l\u1EA1nh
      \u0111\u1EC3 lau tay tr\u01B0\u1EDBc khi \u0103n. Kh\xF4ng d\xF9ng lau m\u1EB7t
      hay c\u1ED5. \u0102n xong g\u1EA5p l\u1EA1i g\u1ECDn v\xE0 \u0111\u1EB7t c\u1EA1nh,
      kh\xF4ng v\xF2 n\xE1t."
  - titleJa: "\u3057\u3087\u3046\u3086\u306E\u3064\u3051\u65B9"
    titleVi: "C\xE1ch ch\u1EA5m n\u01B0\u1EDBc t\u01B0\u01A1ng"
    bodyVi: "Ch\u1EA5m ph\u1EA7n c\xE1 (kh\xF4ng ch\u1EA5m ph\u1EA7n c\u01A1m) v\xEC
      c\u01A1m d\u1EC5 r\u1EDDi v\xE0 n\u01B0\u1EDBc t\u01B0\u01A1ng th\u1EA5m qu\xE1
      nhi\u1EC1u. \u0110\u1ED5 n\u01B0\u1EDBc t\u01B0\u01A1ng v\xE0o \u0111\u0129a
      nh\u1ECF v\u1EEBa \u0111\u1EE7, kh\xF4ng \u0111\u1ED5 \u0111\u1EA7y."
  - titleJa: "\u308F\u3055\u3073\u3068\u30AC\u30EA"
    titleVi: "Wasabi v\xE0 g\u1EEBng ng\xE2m (gari)"
    bodyVi: "\u0110\u1EA7u b\u1EBFp th\u01B0\u1EDDng \u0111\xE3 cho wasabi v\xE0o
      gi\u1EEFa c\xE1 v\xE0 c\u01A1m; \u0111\u1EEBng h\xF2a th\xEAm nhi\u1EC1u v\xE0o
      n\u01B0\u1EDBc t\u01B0\u01A1ng n\u1EBFu kh\xF4ng c\u1EA7n. G\u1EEBng ng\xE2m
      gari \u0103n gi\u1EEFa c\xE1c lo\u1EA1i sushi \u0111\u1EC3 l\xE0m s\u1EA1ch
      v\u1ECB gi\xE1c, kh\xF4ng \u0103n k\xE8m c\xF9ng mi\u1EBFng sushi."
  - titleJa: "\u624B\u3067\u3082\u7BB8\u3067\u3082"
    titleVi: "\u0102n b\u1EB1ng tay ho\u1EB7c \u0111\u0169a \u0111\u1EC1u \u0111\u01B0\u1EE3c"
    bodyVi: "Nigiri c\xF3 th\u1EC3 \u0103n b\u1EB1ng tay ho\u1EB7c \u0111\u0169a.
      \u0102n tr\u1ECDn c\u1EA3 mi\u1EBFng trong m\u1ED9t l\u1EA7n, kh\xF4ng c\u1EAFn
      l\xE0m \u0111\xF4i."
  - titleJa: "\u304A\u8336\uFF08\u3042\u304C\u308A\uFF09"
    titleVi: "Tr\xE0 xanh (agari)"
    bodyVi: "Tr\xE0 mi\u1EC5n ph\xED, u\u1ED1ng gi\u1EEFa c\xE1c lo\u1EA1i \u0111\u1EC3
      l\xE0m s\u1EA1ch v\u1ECB gi\xE1c. C\xF3 th\u1EC3 xin r\xF3t th\xEAm b\u1EB1ng
      '\u304A\u8336\u3092\u304F\u3060\u3055\u3044'."
  - titleJa: "\u304A\u7BB8\u306E\u30DE\u30CA\u30FC"
    titleVi: "L\u1EC5 nghi d\xF9ng \u0111\u0169a"
    bodyVi: "Kh\xF4ng c\u1EAFm \u0111\u0169a th\u1EB3ng \u0111\u1EE9ng v\xE0o c\u01A1m
      (g\u1EE3i l\u1EC5 c\xFAng ng\u01B0\u1EDDi m\u1EA5t), kh\xF4ng chuy\u1EC1n th\u1EE9c
      \u0103n t\u1EEB \u0111\u0169a n\xE0y sang \u0111\u0169a kh\xE1c, kh\xF4ng d\xF9ng
      \u0111\u0169a ch\u1EC9 v\xE0o ng\u01B0\u1EDDi kh\xE1c."
  - titleJa: "\u3044\u305F\u3060\u304D\u307E\u3059\u30FB\u3054\u3061\u305D\u3046\u3055\u307E"
    titleVi: "L\u1EDDi tr\u01B0\u1EDBc v\xE0 sau b\u1EEFa \u0103n"
    bodyVi: "N\xF3i '\u3044\u305F\u3060\u304D\u307E\u3059' tr\u01B0\u1EDBc khi \u0103n
      v\xE0 '\u3054\u3061\u305D\u3046\u3055\u307E\u3067\u3057\u305F' khi \u0103n
      xong ho\u1EB7c r\u1EDDi qu\xE1n \u0111\u1EC3 c\u1EA3m \u01A1n ng\u01B0\u1EDDi
      n\u1EA5u."
  - titleJa: "\u304A\u4F1A\u8A08"
    titleVi: "Thanh to\xE1n"
    bodyVi: "Thanh to\xE1n t\u1EA1i qu\u1EA7y thu ng\xE2n khi \u0111\xE3 \u0103n
      xong, kh\xF4ng c\u1EA7n \u0111\u1EC3 ti\u1EC1n boa (\u1EDF Nh\u1EADt kh\xF4ng
      c\xF3 t\u1EE5c ti\u1EC1n boa). Nhi\u1EC1u qu\xE1n nh\u1ECF ch\u1EC9 nh\u1EADn
      ti\u1EC1n m\u1EB7t."
  staffNameJa: "\u9752\u6728"
  staffNameVi: Aoki
  serviceLines:
  - key: order_confirm
    ja: "\u304B\u3057\u3053\u307E\u308A\u307E\u3057\u305F\u3002{order}\u3067\u3059\u306D\u3002\u5C11\u3005\u304A\u5F85\u3061\u304F\u3060\u3055\u3044\u3002"
    reading: "\u304B\u3057\u3053\u307E\u308A\u307E\u3057\u305F\u3002{order}\u3067\u3059\u306D\u3002\u3057\u3087\u3046\u3057\u3087\u3046\u304A\u307E\u3061\u304F\u3060\u3055\u3044\u3002"
    vi: "V\xE2ng \u1EA1. {order}, \u0111\xFAng kh\xF4ng \u1EA1? Xin qu\xFD kh\xE1ch
      \u0111\u1EE3i m\u1ED9t ch\xFAt."
    en: Certainly. {order}, correct? Please wait a moment.
  - key: served
    ja: "\u304A\u5F85\u305F\u305B\u3057\u307E\u3057\u305F\u3002\u3054\u3086\u3063\u304F\u308A\u3069\u3046\u305E\u3002"
    reading: "\u304A\u307E\u305F\u305B\u3057\u307E\u3057\u305F\u3002\u3054\u3086\u3063\u304F\u308A\u3069\u3046\u305E\u3002"
    vi: "\u0110\u1EC3 qu\xFD kh\xE1ch \u0111\u1EE3i l\xE2u r\u1ED3i. Xin m\u1EDDi
      d\xF9ng b\u1EEFa thong th\u1EA3."
    en: Thank you for waiting. Please take your time and enjoy.
  - key: bill
    ja: "\u304A\u4F1A\u8A08\u306F{total}\u3067\u3059\u3002\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3057\u305F\u3002\u307E\u305F\u304A\u8D8A\u3057\u304F\u3060\u3055\u3044\u3002"
    reading: "\u304A\u304B\u3044\u3051\u3044\u306F{total}\u3067\u3059\u3002\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3057\u305F\u3002\u307E\u305F\u304A\u3053\u3057\u304F\u3060\u3055\u3044\u3002"
    vi: "T\u1ED5ng c\u1ED9ng l\xE0 {total}. C\u1EA3m \u01A1n qu\xFD kh\xE1ch, xin
      m\u1EDDi qu\xFD kh\xE1ch quay l\u1EA1i l\u1EA7n sau."
    en: Your total is {total}. Thank you very much. Please come again.
  - key: bill_reminder
    ja: "\u304A\u5BA2\u69D8\u3001\u304A\u4F1A\u8A08\u3092\u304A\u9858\u3044\u3057\u307E\u3059\u3002"
    reading: "\u304A\u304D\u3083\u304F\u3055\u307E\u3001\u304A\u304B\u3044\u3051\u3044\u3092\u304A\u306D\u304C\u3044\u3057\u307E\u3059\u3002"
    vi: "Qu\xFD kh\xE1ch \u01A1i, xin m\u1EDDi thanh to\xE1n t\u1EA1i b\xE0n \u1EA1."
    en: Excuse me, could you please pay your bill at the table?
  - key: exit_blocked
    ja: "\u304A\u5BA2\u69D8\u3001\u304A\u4F1A\u8A08\u304C\u307E\u3060\u3067\u3059\u3002\u30C6\u30FC\u30D6\u30EB\u3067\u304A\u9858\u3044\u3057\u307E\u3059\u3002"
    reading: "\u304A\u304D\u3083\u304F\u3055\u307E\u3001\u304A\u304B\u3044\u3051\u3044\u304C\u307E\u3060\u3067\u3059\u3002\u30C6\u30FC\u30D6\u30EB\u3067\u304A\u306D\u304C\u3044\u3057\u307E\u3059\u3002"
    vi: "Qu\xFD kh\xE1ch \u01A1i, qu\xFD kh\xE1ch ch\u01B0a thanh to\xE1n \u1EA1.
      Xin thanh to\xE1n t\u1EA1i b\xE0n. (\u1EDE Nh\u1EADt, r\u1EDDi qu\xE1n m\xE0
      kh\xF4ng tr\u1EA3 ti\u1EC1n - \u98DF\u3044\u9003\u3052 - l\xE0 vi ph\u1EA1m
      ph\xE1p lu\u1EADt.)"
    en: Excuse me, you have not paid yet. Please pay at the table. (In Japan, leaving
      without paying - 'kuinige' - is a crime.)
  plateModel: {fileID: 919132149155446097, guid: fa485bb8ebeb39c4684a09ba1343d109, type: 3}
  plateModelSize: 0.26
