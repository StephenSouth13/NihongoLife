  m_Script: {fileID: 11500000, guid: 5e1a7c30b9d24f8e8a6c1d2f4b7a9e03, type: 3}
  m_Name: menu_sushi_hibari
  m_EditorClassIdentifier: NihongoLife::NihongoLife.Data.RestaurantMenuDefinition
  id: menu.sushi.hibari
  restaurantNameJa: "\u3072\u3070\u308A\u5BFF\u53F8"
  restaurantNameReading: "\u3072\u3070\u308A\u305A\u3057"
  restaurantNameVi: Sushi Hibari
  restaurantNameEn: Hibari Sushi
  taglineVi: "Sushi t\u01B0\u01A1i l\xE0m ngay tr\u01B0\u1EDBc m\u1EB7t b\u1EA1n,
    gi\u1EEFa khu ph\u1ED1 Hibari"
  taglineEn: Sushi made fresh in front of you, in the heart of Hibari-cho
  categories:
  - id: nigiri
    titleJa: "\u63E1\u308A"
    titleReading: "\u306B\u304E\u308A"
    titleVi: "Sushi n\u1EAFm (nigiri)"
    titleEn: Nigiri sushi
  - id: maki
    titleJa: "\u5DFB\u304D\u7269"
    titleReading: "\u307E\u304D\u3082\u306E"
    titleVi: "Sushi cu\u1ED9n (maki)"
    titleEn: Rolls (maki)
  - id: donburi
    titleJa: "\u3061\u3089\u3057\u30FB\u4E3C"
    titleReading: "\u3061\u3089\u3057\u30FB\u3069\u3093\u3076\u308A"
    titleVi: "C\u01A1m chirashi v\xE0 donburi"
    titleEn: Chirashi and rice bowls
  - id: side
    titleJa: "\u4E00\u54C1\u6599\u7406"
    titleReading: "\u3044\u3063\u3074\u3093\u308A\u3087\u3046\u308A"
    titleVi: "M\xF3n \u0103n k\xE8m"
    titleEn: Side dishes
  - id: drink
    titleJa: "\u98F2\u307F\u7269"
    titleReading: "\u306E\u307F\u3082\u306E"
    titleVi: "\u0110\u1ED3 u\u1ED1ng"
    titleEn: Drinks
  - id: dessert
    titleJa: "\u30C7\u30B6\u30FC\u30C8"
    titleReading: "\u3067\u3056\u30FC\u3068"
    titleVi: "Tr\xE1ng mi\u1EC7ng"
    titleEn: Dessert
  dishes:
  - id: maguro
    categoryId: nigiri
    nameJa: "\u307E\u3050\u308D\uFF08\u8D64\u8EAB\uFF09"
    reading: "\u307E\u3050\u308D\uFF08\u3042\u304B\u307F\uFF09"
    romaji: maguro (akami)
    nameVi: "C\xE1 ng\u1EEB (ph\u1EA7n th\u1ECBt \u0111\u1ECF)"
    nameEn: Tuna (lean red cut)
    priceYen: 280
    descriptionJa: "\u8D64\u3044\u8EAB\u306E\u307E\u3050\u308D\u3067\u3059\u3002\u3042\u3076\u3089\u304C\u5C11\u306A\u304F\u3066\u3001\u3055\u3063\u3071\u308A\u3057\u3066\u3044\u307E\u3059\u3002"
    descriptionVi: "Ph\u1EA7n th\u1ECBt \u0111\u1ECF c\u1EE7a c\xE1 ng\u1EEB, \xEDt
      b\xE9o, v\u1ECB thanh. \u0110\xE2y l\xE0 lo\u1EA1i sushi kinh \u0111i\u1EC3n
      nh\u1EA5t, r\u1EA5t h\u1EE3p \u0111\u1EC3 th\u1EED \u0111\u1EA7u ti\xEAn. M\u1ED9t
      ph\u1EA7n g\u1ED3m 2 mi\u1EBFng."
    descriptionEn: 'The lean red cut of tuna: clean taste, little fat. A classic
      and the best first piece to try. One order is 2 pieces.'
    ingredientsVi:
    - "C\u01A1m sushi (tr\u1ED9n gi\u1EA5m)"
    - "C\xE1 ng\u1EEB"
    - Wasabi
    allergensVi:
    - "C\xE1"
    - "\u0110\u1EADu n\xE0nh (n\u01B0\u1EDBc t\u01B0\u01A1ng)"
    eatingTipVi: "Ch\u1EC9 ch\u1EA5m ph\u1EA7n c\xE1 v\xE0o n\u01B0\u1EDBc t\u01B0\u01A1ng,
      kh\xF4ng nh\xFAng ph\u1EA7n c\u01A1m. \u0102n c\u1EA3 mi\u1EBFng trong m\u1ED9t
      l\u1EA7n."
    isSpecialty: 0
    specialtyNoteVi: 
    vocabularyTag: vocab.n5.maguro
    hungerRestore: 7
    thirstRestore: 0
    servingVi: "1 ph\u1EA7n = 2 mi\u1EBFng"
    servedModel: {fileID: 919132149155446097, guid: a197afcd7b7b898469922b2c5b45c420, type: 3}
    servedModelSize: 0.15
    servedModelEuler: {x: -90, y: 0, z: 0}
    servedOnPlate: 1
  - id: salmon
    categoryId: nigiri
    nameJa: "\u30B5\u30FC\u30E2\u30F3"
    reading: "\u3055\u30FC\u3082\u3093"
    romaji: saamon
    nameVi: "C\xE1 h\u1ED3i"
    nameEn: Salmon
    priceYen: 250
    descriptionJa: "\u30B5\u30FC\u30E2\u30F3\u306F\u3084\u308F\u3089\u304B\u304F\u3066\u3001\u3042\u3076\u3089\u304C\u3042\u308A\u307E\u3059\u3002"
    descriptionVi: "C\xE1 h\u1ED3i b\xE9o, m\u1EC1m v\xE0 d\u1EC5 \u0103n, \u0111\u01B0\u1EE3c
      nhi\u1EC1u ng\u01B0\u1EDDi ch\u1ECDn khi m\u1EDBi l\xE0m quen v\u1EDBi sushi.
      M\u1ED9t ph\u1EA7n g\u1ED3m 2 mi\u1EBFng."
    descriptionEn: Soft, rich salmon that is easy to enjoy for newcomers. One order
      is 2 pieces.
    ingredientsVi:
    - "C\u01A1m sushi"
    - "C\xE1 h\u1ED3i"
    - Wasabi
    allergensVi:
    - "C\xE1"
    - "\u0110\u1EADu n\xE0nh (n\u01B0\u1EDBc t\u01B0\u01A1ng)"
    eatingTipVi: "Ch\u1EA5m nh\u1EB9 ph\u1EA7n c\xE1 v\xE0o n\u01B0\u1EDBc t\u01B0\u01A1ng
      r\u1ED3i \u0103n c\u1EA3 mi\u1EBFng."
    isSpecialty: 0
    specialtyNoteVi: 
    vocabularyTag: vocab.n5.sake
    hungerRestore: 7
    thirstRestore: 0
    servingVi: "1 ph\u1EA7n = 2 mi\u1EBFng"
    servedModel: {fileID: 919132149155446097, guid: f694e8604dbbd4d4b8c77a9ebaeea544, type: 3}
    servedModelSize: 0.15
    servedModelEuler: {x: -90, y: 0, z: 0}
    servedOnPlate: 1
  - id: ebi
    categoryId: nigiri
    nameJa: "\u3048\u3073"
    reading: "\u3048\u3073"
    romaji: ebi
    nameVi: "T\xF4m lu\u1ED9c"
    nameEn: Boiled shrimp
    priceYen: 220
    descriptionJa: "\u3048\u3073\u306F\u706B\u3092\u901A\u3057\u3066\u3042\u308A\u307E\u3059\u3002\u306A\u307E\u9B5A\u304C\u306B\u304C\u3066\u306A\u4EBA\u306B\u3082\u304A\u3059\u3059\u3081\u3067\u3059\u3002"
    descriptionVi: "T\xF4m \u0111\xE3 lu\u1ED9c ch\xEDn, h\u1EE3p v\u1EDBi ng\u01B0\u1EDDi
      ch\u01B0a quen \u0103n c\xE1 s\u1ED1ng. M\u1ED9t ph\u1EA7n g\u1ED3m 2 mi\u1EBFng."
    descriptionEn: Cooked shrimp, a good choice if you are not used to raw fish.
      One order is 2 pieces.
    ingredientsVi:
    - "C\u01A1m sushi"
    - "T\xF4m lu\u1ED9c"
    allergensVi:
    - "\u0110\u1ED9ng v\u1EADt gi\xE1p x\xE1c (t\xF4m)"
    - "\u0110\u1EADu n\xE0nh (n\u01B0\u1EDBc t\u01B0\u01A1ng)"
    eatingTipVi: "C\xF3 th\u1EC3 \u0103n b\u1EB1ng tay ho\u1EB7c \u0111\u0169a. N\u1EBFu
      b\u1ECB d\u1ECB \u1EE9ng t\xF4m, h\xE3y n\xF3i ngay v\u1EDBi nh\xE2n vi\xEAn:
      \u30A2\u30EC\u30EB\u30AE\u30FC\u304C\u3042\u308A\u307E\u3059\u3002"
    isSpecialty: 0
    specialtyNoteVi: 
    vocabularyTag: vocab.n5.ebi
    hungerRestore: 7
    thirstRestore: 0
    servingVi: "1 ph\u1EA7n = 2 mi\u1EBFng"
    servedModel: {fileID: 919132149155446097, guid: 1bc950c954199b745a02eafe3da54a62, type: 3}
    servedModelSize: 0.15
    servedModelEuler: {x: -90, y: 0, z: 0}
    servedOnPlate: 1
  - id: tamago
    categoryId: nigiri
    nameJa: "\u305F\u307E\u3054"
    reading: "\u305F\u307E\u3054"
    romaji: tamago
    nameVi: "Tr\u1EE9ng cu\u1ED9n ng\u1ECDt"
    nameEn: Sweet rolled omelet
    priceYen: 180
    descriptionJa: "\u305F\u307E\u3054\u306F\u7518\u3044\u5375\u713C\u304D\u3067\u3059\u3002\u5B50\u3069\u3082\u306B\u3082\u4EBA\u6C17\u3067\u3059\u3002"
    descriptionVi: "Tr\u1EE9ng cu\u1ED9n n\u01B0\u1EDBng v\u1ECB ng\u1ECDt, c\xF3
      d\u1EA3i rong bi\u1EC3n gi\u1EEF ph\u1EA7n tr\u1EE9ng. Nhi\u1EC1u ng\u01B0\u1EDDi
      k\u1EC3 r\u1EB1ng tamago l\xE0 m\xF3n \u0111\u1EC3 'th\u1EED tay ngh\u1EC1'
      c\u1EE7a \u0111\u1EA7u b\u1EBFp. M\u1ED9t ph\u1EA7n g\u1ED3m 2 mi\u1EBFng."
    descriptionEn: Sweet grilled rolled omelet held by a strip of seaweed. Many people
      say tamago is how you judge a chef's skill. One order is 2 pieces.
    ingredientsVi:
    - "C\u01A1m sushi"
    - "Tr\u1EE9ng cu\u1ED9n (tamagoyaki)"
    - "Rong bi\u1EC3n"
    allergensVi:
    - "Tr\u1EE9ng"
    - "\u0110\u1EADu n\xE0nh"
    eatingTipVi: "\u0102n c\u1EA3 mi\u1EBFng, kh\xF4ng c\u1EA7n ch\u1EA5m n\u01B0\u1EDBc
      t\u01B0\u01A1ng v\xEC tr\u1EE9ng \u0111\xE3 c\xF3 v\u1ECB ng\u1ECDt."
    isSpecialty: 0
    specialtyNoteVi: 
    vocabularyTag: vocab.n5.tamago
    hungerRestore: 6
    thirstRestore: 0
    servingVi: "1 ph\u1EA7n = 2 mi\u1EBFng"
    servedModel: {fileID: 919132149155446097, guid: a886bbd5d8cd17e4fb743346a2d6f864, type: 3}
    servedModelSize: 0.15
    servedModelEuler: {x: -90, y: 0, z: 0}
    servedOnPlate: 1
  - id: ika
    categoryId: nigiri
    nameJa: "\u3044\u304B"
    reading: "\u3044\u304B"
    romaji: ika
    nameVi: "M\u1EF1c"
    nameEn: Squid
    priceYen: 200
    descriptionJa: "\u3044\u304B\u306F\u5C11\u3057\u304B\u305F\u304F\u3066\u3001\u3042\u307E\u3044\u5473\u3067\u3059\u3002"
    descriptionVi: "M\u1EF1c c\xF3 \u0111\u1ED9 dai gi\xF2n nh\u1EB9 v\xE0 v\u1ECB
      ng\u1ECDt thanh. M\u1ED9t ph\u1EA7n g\u1ED3m 2 mi\u1EBFng."
    descriptionEn: Squid with a slight chew and a gentle sweetness. One order is
      2 pieces.
    ingredientsVi:
    - "C\u01A1m sushi"
    - "M\u1EF1c"
    allergensVi:
    - "\u0110\u1ED9ng v\u1EADt th\xE2n m\u1EC1m (m\u1EF1c)"
    - "\u0110\u1EADu n\xE0nh (n\u01B0\u1EDBc t\u01B0\u01A1ng)"
    eatingTipVi: "Nhai k\u1EF9 h\u01A1n c\xE1c lo\u1EA1i kh\xE1c m\u1ED9t ch\xFAt
      \u0111\u1EC3 c\u1EA3m nh\u1EADn v\u1ECB ng\u1ECDt."
    isSpecialty: 0
    specialtyNoteVi: 
    vocabularyTag: vocab.n5.ika
    hungerRestore: 6
    thirstRestore: 0
    servingVi: "1 ph\u1EA7n = 2 mi\u1EBFng"
    servedModel: {fileID: 919132149155446097, guid: c81dd715be12d6845be9c3509eafdc1b, type: 3}
    servedModelSize: 0.15
    servedModelEuler: {x: -90, y: 0, z: 0}
    servedOnPlate: 1
  - id: unagi_nigiri
    categoryId: nigiri
    nameJa: "\u3046\u306A\u304E"
    reading: "\u3046\u306A\u304E"
    romaji: unagi
    nameVi: "L\u01B0\u01A1n n\u01B0\u1EDBng s\u1ED1t ng\u1ECDt"
    nameEn: Grilled eel with sweet sauce
    priceYen: 380
    descriptionJa: "\u3046\u306A\u304E\u306F\u713C\u3044\u305F\u9B5A\u3067\u3059\u3002\u3042\u307E\u3044\u305F\u308C\u304C\u304A\u3044\u3057\u3044\u3067\u3059\u3002"
    descriptionVi: "L\u01B0\u01A1n n\u01B0\u1EDBng ph\u1EBFt s\u1ED1t ng\u1ECDt m\u1EB7n
      (tare), b\xE9o v\xE0 th\u01A1m. M\u1ED9t ph\u1EA7n g\u1ED3m 2 mi\u1EBFng."
    descriptionEn: Grilled eel brushed with sweet-savory tare sauce. Rich and fragrant.
      One order is 2 pieces.
    ingredientsVi:
    - "C\u01A1m sushi"
    - "L\u01B0\u01A1n n\u01B0\u1EDBng"
    - "S\u1ED1t tare (n\u01B0\u1EDBc t\u01B0\u01A1ng, mirin, \u0111\u01B0\u1EDDng)"
    allergensVi:
    - "C\xE1 (l\u01B0\u01A1n)"
    - "\u0110\u1EADu n\xE0nh"
    - "L\xFAa m\xEC"
    eatingTipVi: "S\u1ED1t \u0111\xE3 c\xF3 s\u1EB5n, kh\xF4ng c\u1EA7n ch\u1EA5m
      th\xEAm n\u01B0\u1EDBc t\u01B0\u01A1ng."
    isSpecialty: 1
    specialtyNoteVi: "Ng\u01B0\u1EDDi Nh\u1EADt hay \u0103n l\u01B0\u01A1n v\xE0o
      'Doyo no Ushi no Hi' (\u571F\u7528\u306E\u4E11\u306E\u65E5), ng\xE0y gi\u1EEFa
      m\xF9a h\xE8, \u0111\u1EC3 l\u1EA5y s\u1EE9c ch\u1ED1ng n\xF3ng."
    vocabularyTag: vocab.n5.unagi
    hungerRestore: 8
    thirstRestore: 0
    servingVi: "1 ph\u1EA7n = 2 mi\u1EBFng"
    servedModel: {fileID: 919132149155446097, guid: a197afcd7b7b898469922b2c5b45c420, type: 3}
    servedModelSize: 0.15
    servedModelEuler: {x: -90, y: 0, z: 0}
    servedOnPlate: 1
  - id: hotate
    categoryId: nigiri
    nameJa: "\u307B\u305F\u3066"
    reading: "\u307B\u305F\u3066"
    romaji: hotate
    nameVi: "S\xF2 \u0111i\u1EC7p"
    nameEn: Scallop
    priceYen: 320
    descriptionJa: "\u307B\u305F\u3066\u306F\u5927\u304D\u304F\u3066\u3001\u3068\u3066\u3082\u3042\u307E\u3044\u3067\u3059\u3002"
    descriptionVi: "S\xF2 \u0111i\u1EC7p to, v\u1ECB ng\u1ECDt v\xE0 m\u1EC1m, th\u01B0\u1EDDng
      \u0111\u01B0\u1EE3c \u01B0a chu\u1ED9ng v\xE0o m\xF9a l\u1EA1nh. M\u1ED9t ph\u1EA7n
      g\u1ED3m 2 mi\u1EBFng."
    descriptionEn: Large, sweet, tender scallop. One order is 2 pieces.
    ingredientsVi:
    - "C\u01A1m sushi"
    - "S\xF2 \u0111i\u1EC7p"
    allergensVi:
    - "\u0110\u1ED9ng v\u1EADt th\xE2n m\u1EC1m (s\xF2 \u0111i\u1EC7p)"
    - "\u0110\u1EADu n\xE0nh (n\u01B0\u1EDBc t\u01B0\u01A1ng)"
    eatingTipVi: "Ch\u1EA5m nh\u1EB9 n\u01B0\u1EDBc t\u01B0\u01A1ng ho\u1EB7c \u0103n
      v\u1EDBi ch\xFAt mu\u1ED1i n\u1EBFu qu\xE1n c\xF3."
    isSpecialty: 0
    specialtyNoteVi: 
    vocabularyTag: vocab.n5.hotate
    hungerRestore: 7
    thirstRestore: 0
    servingVi: "1 ph\u1EA7n = 2 mi\u1EBFng"
    servedModel: {fileID: 919132149155446097, guid: f694e8604dbbd4d4b8c77a9ebaeea544, type: 3}
    servedModelSize: 0.15
    servedModelEuler: {x: -90, y: 0, z: 0}
    servedOnPlate: 1
  - id: ikura
    categoryId: nigiri
    nameJa: "\u3044\u304F\u3089\uFF08\u8ECD\u8266\uFF09"
    reading: "\u3044\u304F\u3089\uFF08\u3050\u3093\u304B\u3093\uFF09"
    romaji: ikura (gunkan)
    nameVi: "Tr\u1EE9ng c\xE1 h\u1ED3i (gunkan)"
    nameEn: Salmon roe (gunkan)
    priceYen: 300
    descriptionJa: "\u3044\u304F\u3089\u306F\u8D64\u304F\u3066\u5C0F\u3055\u3044\u9B5A\u306E\u305F\u307E\u3054\u3067\u3059\u3002\u306E\u308A\u3067\u307E\u3044\u3066\u3042\u308A\u307E\u3059\u3002"
    descriptionVi: "Tr\u1EE9ng c\xE1 h\u1ED3i \u0111\u1ECF b\xF3ng, v\u1ECB m\u1EB7n
      d\u1ECBu, n\u1ED5 nh\u1EB9 trong mi\u1EC7ng. M\xF3n gunkan (\u8ECD\u8266, ngh\u0129a
      l\xE0 't\xE0u chi\u1EBFn') \u0111\u01B0\u1EE3c qu\u1EA5n rong bi\u1EC3n \u0111\u1EC3
      gi\u1EEF ph\u1EA7n tr\u1EE9ng. M\u1ED9t ph\u1EA7n g\u1ED3m 2 mi\u1EBFng."
    descriptionEn: Bright red salmon roe with a mild salty pop. 'Gunkan' means 'battleship',
      named for the seaweed wall. One order is 2 pieces.
    ingredientsVi:
    - "C\u01A1m sushi"
    - "Tr\u1EE9ng c\xE1 h\u1ED3i (ng\xE2m n\u01B0\u1EDBc t\u01B0\u01A1ng)"
    - "Rong bi\u1EC3n"
    allergensVi:
    - "Tr\u1EE9ng c\xE1"
    - "C\xE1 h\u1ED3i"
    - "\u0110\u1EADu n\xE0nh"
    eatingTipVi: "\u0102n b\u1EB1ng tay s\u1EBD d\u1EC5 h\u01A1n, tr\xE1nh l\u1EADt
      ng\u01B0\u1EE3c mi\u1EBFng sushi."
    isSpecialty: 0
    specialtyNoteVi: 
    vocabularyTag: vocab.n5.ikura
    hungerRestore: 7
    thirstRestore: 0
    servingVi: "1 ph\u1EA7n = 2 mi\u1EBFng"
    servedModel: {fileID: 919132149155446097, guid: a886bbd5d8cd17e4fb743346a2d6f864, type: 3}
    servedModelSize: 0.15
    servedModelEuler: {x: -90, y: 0, z: 0}
    servedOnPlate: 1
  - id: kappamaki
    categoryId: maki
    nameJa: "\u304B\u3063\u3071\u5DFB\u304D"
    reading: "\u304B\u3063\u3071\u307E\u304D"
    romaji: kappamaki
    nameVi: "Sushi cu\u1ED9n d\u01B0a leo"
    nameEn: Cucumber roll
    priceYen: 250
    descriptionJa: "\u304B\u3063\u3071\u5DFB\u304D\u306F\u304D\u3085\u3046\u308A\u306E\u3059\u3057\u3067\u3059\u3002\u3055\u3063\u3071\u308A\u3057\u3066\u3044\u307E\u3059\u3002"
    descriptionVi: "Cu\u1ED9n d\u01B0a leo gi\xF2n m\xE1t, nh\u1EB9 v\xE0 t\u01B0\u01A1i.
      T\xEAn 'kappa' l\u1EA5y t\u1EEB th\u1EE7y qu\xE1i kappa trong truy\u1EC1n thuy\u1EBFt
      Nh\u1EADt, nghe n\xF3i r\u1EA5t th\xEDch d\u01B0a leo. M\u1ED9t ph\u1EA7n g\u1ED3m
      6 mi\u1EBFng nh\u1ECF."
    descriptionEn: A refreshing cucumber roll. 'Kappa' is a water creature from Japanese
      folklore said to love cucumbers. One order is 6 small pieces.
    ingredientsVi:
    - "C\u01A1m sushi"
    - "D\u01B0a leo"
    - "Rong bi\u1EC3n"
    allergensVi:
