  id: exam.ielts.academic.practice1
  examType: 1
  level: "Academic"
  titleVi: "IELTS Academic - Đề luyện tập 1"
  titleEn: "IELTS Academic - Practice Test 1"
  titleJa: ""
  descriptionVi: "Đề luyện tập ngắn: Đọc (1 bài + Đúng/Sai/Không có thông tin + trắc nghiệm), Nghe (mô phỏng bằng văn bản), Viết (Task 2) và Nói (Part 2)."
  descriptionEn: "A short practice set: Reading (1 passage + True/False/Not Given + MCQ), Listening (text-simulated), Writing (Task 2) and Speaking (Part 2)."
  sections:
  - id: ielts_listening
    type: 3
    titleVi: "Listening"
    titleEn: "Listening"
    titleJa: ""
    timeLimitSeconds: 480
    scoreScaleMax: 60
    passages:
    - id: ielts_listen_hotel
      titleVi: "Hội thoại: Đặt phòng khách sạn"
      titleEn: "Conversation: Booking a hotel room"
      titleJa: ""
      bodyVi: "Nữ: Chào buổi chiều, khách sạn Lakeside, tôi có thể giúp gì cho anh?\nNam: Chào chị, tôi muốn đặt phòng hai đêm, từ ngày 10 đến ngày 12 tháng 6.\nNữ: Vâng ạ. Anh muốn phòng đơn hay phòng đôi?\nNam: Cho tôi phòng đôi, nếu có thể nhìn ra hồ.\nNữ: Chúng tôi có một phòng như vậy. Giá 90 bảng một đêm, tổng cộng 180 bảng. Cho tôi xin tên anh?\nNam: Vâng, tôi là James Carter."
      bodyEn: "Woman: Good afternoon, Lakeside Hotel, how can I help you?\nMan: Hi, I'd like to book a room for two nights, please, from the 10th to the 12th of June.\nWoman: Certainly. Would you prefer a single or a double room?\nMan: A double room, please, with a view of the lake if possible.\nWoman: We do have one available. That will be 90 pounds per night, so 180 pounds in total. Could I have your name, please?\nMan: Yes, it's James Carter."
      bodyJa: ""
      bodyReading: ""
      maxPlays: 1
    questions:
    - id: ielts_l_q1
      type: 0
      passageId: ielts_listen_hotel
      promptVi: ""
      promptEn: "What type of room does the man book?"
      promptJa: ""
      promptReading: ""
      choices:
      - textVi: "Single"
        textEn: "Single"
        textJa: ""
      - textVi: "Double"
        textEn: "Double"
        textJa: ""
      - textVi: "Twin"
        textEn: "Twin"
        textJa: ""
      - textVi: "Family"
        textEn: "Family"
        textJa: ""
      correctChoiceIndex: 1
      acceptedAnswers: []
      taskInstructionsVi: ""
      taskInstructionsEn: ""
      minWords: 0
      timeLimitSeconds: 0
      explanationVi: "Người đàn ông nói: \"A double room, please\"."
      explanationEn: "The man says: \"A double room, please\"."
      tags:
      - "listening"
      - "mc"
      points: 1
    - id: ielts_l_q2
      type: 2
      passageId: ielts_listen_hotel
      promptVi: ""
      promptEn: "What is the total cost mentioned for the stay?"
      promptJa: ""
      promptReading: ""
