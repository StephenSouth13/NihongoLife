      correctChoiceIndex: -1
      acceptedAnswers:
      - "180 pounds"
      - "£180"
      - "180"
      taskInstructionsVi: ""
      taskInstructionsEn: ""
      minWords: 0
      timeLimitSeconds: 0
      explanationVi: "Nhân viên nói: \"90 pounds per night, so 180 pounds in total\"."
      explanationEn: "The receptionist says: \"90 pounds per night, so 180 pounds in total\"."
