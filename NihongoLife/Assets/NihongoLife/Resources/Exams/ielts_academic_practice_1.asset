      taskInstructionsVi: ""
      taskInstructionsEn: ""
      minWords: 0
      timeLimitSeconds: 0
      explanationVi: "Bài đọc nói rõ: \"linked gardening activities to reduced stress\"."
      explanationEn: "The passage explicitly states gardening is \"linked ... to reduced stress\"."
      tags:
      - "reading"
      - "tfng"
      points: 1
    - id: ielts_r_q3
      type: 1
      passageId: ielts_passage_gardens
      promptVi: ""
      promptEn: "Disputes over shared resources never occur in community gardens."
      promptJa: ""
      promptReading: ""
      choices:
