        textJa: ""
      correctChoiceIndex: 1
      acceptedAnswers: []
      taskInstructionsVi: ""
      taskInstructionsEn: ""
      minWords: 0
      timeLimitSeconds: 0
      explanationVi: "Bài đọc nói ngược lại: \"disputes ... are common\"."
      explanationEn: "The passage contradicts this: \"disputes ... are common\"."
      tags:
      - "reading"
      - "tfng"
      points: 1
    - id: ielts_r_q4
      type: 0
      passageId: ielts_passage_gardens
      promptVi: ""
      promptEn: "According to the passage, what is one social benefit of community gardens?"
      promptJa: ""
