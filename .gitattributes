# Auto detect text files and perform LF normalization.
# Binary rules below override this for new and changed files. Existing history is not rewritten.
* text=auto

# Large binary assets go through Git LFS from this commit forward.
# Install Git LFS (`git lfs install`) before adding or changing these files.
# This does not migrate blobs already stored in git history.
*.fbx filter=lfs diff=lfs merge=lfs -text
*.FBX filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
